<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="ICDConfig">
		<xs:annotation>
			<xs:documentation>Comment describing your root element</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Files" type="SchemaFiles"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="SchemaFiles">
		<xs:sequence>
			<xs:element name="FileInfo" type="SchemaFileInfo" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SchemaFileInfo">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="ID" type="xs:int"/>
			<xs:element name="Type" type="xs:int"/>
			<xs:element name="Description" type="xs:string"/>
			<xs:element name="Enable" type="xs:int"/>
			<xs:element name="WordType" type="xs:unsignedInt" default="0">
				<xs:annotation>
					<xs:documentation>保留</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByteOrder" type="xs:int">
				<xs:annotation>
					<xs:documentation>大端小端</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Path" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
