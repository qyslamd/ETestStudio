		<xs:sequence>
			<xs:element name="Offset" type="xs:int"/>
			<xs:element name="StartBit" type="xs:int"/>
			<xs:element name="BitWidth" type="xs:int"/>
			<xs:element name="Type" type="xs:string"/>
