# etest-demo 代码行数统计脚本
# 由 CMake configure_file 生成，自动填充 cloc 路径

# 设置控制台输出编码为 UTF-8，确保中文能正常显示
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$OutputEncoding = [Text.Encoding]::UTF8

$cloc = "@CLOC_EXECUTABLE@"

if (-not (Test-Path $cloc)) {
    Write-Host "Error: cloc.exe not found at $cloc"
    exit 1
}

<#
  cloc 命令行参数说明:
    --quiet               只显示最终报告，不显示过程信息
    --csv                 输出 CSV 格式，方便解析
    --json                输出 JSON 格式
    --yaml                输出 YAML 格式
    --xml                 输出 XML 格式
    --by-file             显示每个文件的详细统计（不加则只显示语言汇总表）
    --by-file-by-lang     同时显示按语言和按文件的统计
    --exclude-dir=<dirs>  排除指定目录（逗号分隔）
    --exclude-ext=<exts>  排除指定扩展名（逗号分隔）
    --include-ext=<exts>  只统计指定扩展名
    --exclude-lang=<langs> 排除指定语言
    --sum-one             即使只有一个文件也显示 SUM 汇总行
    --report-file=<file>  输出结果到文件
    --out=<file>          同上，--report-file 的别名
    --diff <set1> <set2>  比较两个版本的代码差异
    --git                 接受 git commit hash 或分支名作为输入
    --vcs=git             通过 git ls-files 获取文件列表（自动排除 .gitignore 中的文件）
    --by-percent X        按 X 的百分比显示
    --progress            显示进度信息
    更多参数: cloc --help
#>

Write-Host "========================================"
Write-Host " etest-demo 代码行数统计"
Write-Host "========================================"
Write-Host ""

& $cloc --exclude-dir=3rdparty,build,.git,cmake-build,out,Release,Debug `
       --exclude-ext=md,txt,bat,ps1,json,ini,iss,svg `
       src/ tests/ examples/ 2>&1

Write-Host ""
Write-Host "Done!"
