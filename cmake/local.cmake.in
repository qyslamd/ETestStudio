# Qt comfiguration
if(MSVC)
    set(Qt5_12_x_Path_x64 "@PATH_FOR_QT_INSTALLATION_X64@")
    set(Qt5_12_x_Path_x86 "@PATH_FOR_QT_INSTALLATION_X86@")

    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(Qt5_12_x_Path "${Qt5_12_x_Path_x64}")
    else()
        set(Qt5_12_x_Path "${Qt5_12_x_Path_x86}")
    endif()
else()
    set(Qt5_12_x_Path "/opt/qt5.12.12/5.12.12/gcc_64")
    # Qt 运行时路径（供 run_app.sh 使用）
    set(QT_LIB_DIR "${Qt5_12_x_Path}/lib")
    set(QT_PLUGINS_DIR "${Qt5_12_x_Path}/plugins")
endif()

set(Qt5_DIR "${Qt5_12_x_Path}/lib/cmake/Qt5")
set(QT_DIR "${Qt5_12_x_Path}/lib/cmake/Qt5")
