@echo off
REM Auto-generated by CMake - do not edit
REM Usage: make_installer.bat <binary_dir>

set BIN_DIR=%~1
if "%BIN_DIR%"=="" (
    echo Usage: %~nx0 ^<binary_dir^>
    echo Example: %~nx0 build\ninja-release-x64\bin
    exit /b 1
)

set WINDEPLOYQT=@WINDEPLOYQT_EXECUTABLE@
set ISCC=@ISCC_EXECUTABLE@
set DIST_DIR=@PACKAGE_OUTPUT_DIR@
set APP_VERSION=@APP_VERSION@
set APP_ARCH=@APP_ARCH@
set SETUP_ICON=@CMAKE_CURRENT_SOURCE_DIR@\resources\icons\app_icon.ico
set ISS_SCRIPT=@CMAKE_SOURCE_DIR@\scripts\make_install_package.iss
set TARGET_NAME=@TARGET_NAME@

echo Packaging @PROJECT_NAME@ (%APP_ARCH%) v%APP_VERSION%...

if not exist "%BIN_DIR%\%TARGET_NAME%.exe" (
    echo Error: %BIN_DIR%\%TARGET_NAME%.exe not found
    exit /b 1
)

mkdir "%DIST_DIR%" 2>nul

echo Running windeployqt...
"%WINDEPLOYQT%" --verbose 0 --no-angle --no-opengl-sw --no-system-d3d-compiler --compiler-runtime "%BIN_DIR%\%TARGET_NAME%.exe"
if errorlevel 1 (
    echo windeployqt failed with error code %errorlevel%
    exit /b %errorlevel%
)

echo Running Inno Setup...
"%ISCC%" /Qp ^
    "/DWhereAreFiles=%BIN_DIR%" ^
    "/DWhereToOutput=%DIST_DIR%" ^
    "/DMyAppVersion=%APP_VERSION%" ^
    "/DMyAppExeName=%TARGET_NAME%.exe" ^
    "/DMySetupIcon=%SETUP_ICON%" ^
    "/DMyProductName=@PROJECT_NAME@" ^
    "/DMyAppArch=%APP_ARCH%" ^
    "%ISS_SCRIPT%"
if errorlevel 1 (
    echo ISCC failed with error code %errorlevel%
    exit /b %errorlevel%
)

echo Package created: %DIST_DIR%\%TARGET_NAME%-setup-%APP_ARCH%-%APP_VERSION%.exe
