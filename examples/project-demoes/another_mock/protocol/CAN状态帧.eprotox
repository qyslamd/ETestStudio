<?xml version="1.0" encoding="UTF-8"?>
<ICDData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="IcdSchema.xsd">
    <Name>CAN状态帧</Name>
    <Data>
        <Item>
            <Offset>0</Offset>
            <StartBit>0</StartBit>
            <BitWidth>32</BitWidth>
            <Type>dword</Type>
            <Name>CAN_ID</Name>
            <Description>标准CAN ID</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>4</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>状态码</Name>
            <Description>0x10=运行 0x20=停止 0x30=故障</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>5</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>运行参数</Name>
            <Description>当前运行参数,单位0.1</Description>
            <IsScaled>1</IsScaled>
            <ScaleA>0.1</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>7</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>校验</Name>
            <Description>异或校验</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
    </Data>
</ICDData>
