<?xml version="1.0" encoding="UTF-8"?>
<ICDData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="IcdSchema.xsd">
    <Name>多通道设定</Name>
    <Data>
        <Item>
            <Offset>0</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>帧头</Name>
            <Description>固定0xAA</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>1</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>通道掩码</Name>
            <Description>bit0-5对应6路</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>2</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>通道1-2值</Name>
            <Description>通道1值(高8)+通道2值(低8)</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>4</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>通道3-4值</Name>
            <Description>通道3值(高8)+通道4值(低8)</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>6</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>通道5-6值</Name>
            <Description>通道5值(高8)+通道6值(低8)</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>8</Offset>
            <StartBit>0</StartBit>
            <BitWidth>32</BitWidth>
            <Type>dword</Type>
            <Name>时间戳</Name>
            <Description>系统毫秒时间戳</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
