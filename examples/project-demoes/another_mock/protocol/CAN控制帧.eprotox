<?xml version="1.0" encoding="UTF-8"?>
<ICDData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="IcdSchema.xsd">
    <Name>CAN控制帧</Name>
    <Data>
        <Item>
            <Offset>0</Offset>
            <StartBit>0</StartBit>
            <BitWidth>32</BitWidth>
            <Type>dword</Type>
            <Name>CAN_ID</Name>
            <Description>标准CAN ID</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>4</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>命令码</Name>
            <Description>0x01=启动 0x02=停止 0x03=设定</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>5</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>控制参数</Name>
            <Description>控制参数值,单位0.5</Description>
            <IsScaled>1</IsScaled>
            <ScaleA>0.5</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>7</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>校验</Name>
            <Description>异或校验</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
    </Data>
</ICDData>
