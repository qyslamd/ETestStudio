<?xml version="1.0" encoding="UTF-8"?>
<ICDData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="IcdSchema.xsd">
    <Name>DA输出电压</Name>
    <Data>
        <Item>
            <Offset>0</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>通道号</Name>
            <Description>DA通道(0-3)</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>1</Offset>
            <StartBit>0</StartBit>
            <BitWidth>16</BitWidth>
            <Type>word</Type>
            <Name>电压值</Name>
            <Description>电压设定值,单位0.01V</Description>
            <IsScaled>1</IsScaled>
            <ScaleA>0.01</ScaleA>
            <Unit/>
            <Tag>0</Tag>
            <ValueTextList>0</ValueTextList>
        </Item>
        <Item>
            <Offset>3</Offset>
            <StartBit>0</StartBit>
            <BitWidth>8</BitWidth>
            <Type>byte</Type>
            <Name>输出模式</Name>
            <Description>0x00=直流 0x01=正弦 0x02=方波</Description>
            <IsScaled>0</IsScaled>
            <ScaleA>0</ScaleA>
            <Unit/>
