{
    "version": "1.1",
    "name": "综合仿真测试套件",
    "description": "覆盖串口/CAN/A429/AD/DA的综合仿真测试",
    "setup": [
        {
            "cmd": "ACTION",
            "delayMs": 0,
            "description": "综合仿真测试开始",
            "target": "",
            "timeoutMs": 5000,
            "value": ""
        }
    ],
    "cases": [
        {
            "name": "串口电压电流环回测试",
            "description": "SET电压电流→VERIFY回读值",
            "steps": [
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "设定电压12.50V",
                    "target": "aca37b9af8ea6f9b5dd280c893be72f3",
                    "timeoutMs": 10000,
                    "value": "12.5"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "验证电压12.50V",
                    "target": "0d939dfc4de228aa1514b997412da352",
                    "timeoutMs": 10000,
                    "value": "12.5",
                    "tolerance": {
                        "enabled": true,
                        "max": 0.05,
                        "min": -0.05
                    }
                },
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "设定电流3.00A",
                    "target": "c0a7ff41127399e91431418247f953e7",
                    "timeoutMs": 10000,
                    "value": "3.0"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "验证电流3.00A",
                    "target": "696c9cd22a5434bff5b23f05becbb61c",
                    "timeoutMs": 10000,
                    "value": "3.0",
                    "tolerance": {
                        "enabled": true,
                        "max": 0.05,
                        "min": -0.05
                    }
                }
            ]
        },
        {
            "name": "多通道批量测试",
            "description": "多通道参数批量设定和回读",
            "steps": [
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "使能全部6通道",
                    "target": "317d6a6dc662f6cc7a03f179e29d82d9",
                    "timeoutMs": 10000,
                    "value": "63"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "验证通道掩码回读",
                    "target": "9fda0d5206f5660e104ff4a95c97b76d",
                    "timeoutMs": 10000,
                    "value": "63",
                    "tolerance": {
                        "enabled": true,
                        "max": 0,
                        "min": 0
                    }
                }
            ]
        },
        {
            "name": "CAN通信环回测试",
            "description": "CAN控制帧SET→状态帧VERIFY",
            "steps": [
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "发送控制参数20.0",
                    "target": "9b48143753c625013ceed0d81b89653d",
                    "timeoutMs": 10000,
                    "value": "20.0"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "验证运行参数2.0",
                    "target": "25d704d2d3e0229d1426166ad4a1fd36",
                    "timeoutMs": 10000,
                    "value": "2.0",
                    "tolerance": {
                        "enabled": true,
                        "max": 0.2,
                        "min": -0.2
                    }
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "验证状态码0x10(运行)",
                    "target": "bdbed282c1f6fd1f04f4c271479997ed",
                    "timeoutMs": 10000,
                    "value": "16",
                    "tolerance": {
                        "enabled": true,
                        "max": 0,
                        "min": 0
                    }
                }
            ]
        },
        {
            "name": "A429总线收发测试",
            "description": "A429发送Label→接收VERIFY",
            "steps": [
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "发送数据5.0",
                    "target": "7d477322b051a9e5e8fa4d83e818ddb3",
                    "timeoutMs": 10000,
                    "value": "5.0"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "接收数据0.0",
                    "target": "be3e5729966edb291ff6ab799c45c781",
                    "timeoutMs": 10000,
                    "value": "0.0",
                    "tolerance": {
                        "enabled": true,
                        "max": 0.2,
                        "min": -0.2
                    }
                }
            ]
        },
        {
            "name": "AD采集验证测试",
            "description": "AD通道模拟值验证",
            "steps": [
                {
                    "cmd": "LOOP",
                    "loopCount": 64,
                    "subSteps": [
                        {
                            "cmd": "VERIFY",
                            "delayMs": 0,
                            "description": "验证AD采集3.0V",
                            "target": "9854e179a887d7312364e4c45aa4615a",
                            "timeoutMs": 10000,
                            "value": "3.0",
                            "tolerance": {
                                "enabled": true,
                                "min": -10.0,
                                "max": 10.0
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "DA输出环回测试",
            "description": "DA输出电压SET→回读VERIFY",
            "steps": [
                {
                    "cmd": "SET",
                    "delayMs": 0,
                    "description": "设定DA输出7.50V",
                    "target": "0ec7267a179cdacf8b958dde63e6ccfb",
                    "timeoutMs": 10000,
                    "value": "7.5"
                },
                {
                    "cmd": "VERIFY",
                    "delayMs": 0,
                    "description": "回读DA电压7.50V",
                    "target": "0ec7267a179cdacf8b958dde63e6ccfb",
                    "timeoutMs": 10000,
                    "value": "7.5",
                    "tolerance": {
                        "enabled": true,
                        "max": 0.05,
                        "min": -0.05
                    }
                }
            ]
        }
    ],
    "teardown": [
        {
            "cmd": "ACTION",
            "delayMs": 0,
            "description": "综合仿真测试完成",
            "target": "",
            "timeoutMs": 5000,
            "value": ""
        }
    ]
}