QToolButton#aboutOkButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
QToolButton#aboutOkButton:hover {
    background-color: #1177BB;
}
QToolButton#aboutOkButton:pressed {
    background-color: #0D5A8F;
}
#aboutCopyright {
    color: #666666;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #555555;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: #252526;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1565C0, stop:1 #4527A0);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#loginUsername, #loginPassword {
  background: #3c3c3c;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #CCCCCC;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #4FC3F7;
  background: #3c3c3c;
}
QToolButton#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #1565C0, stop:1 #42A5F5);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1E88E5);
}
QToolButton#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1565C0);
}
#loginHint {
  color: #ef5350;
  font-size: 12px;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#loginCloseBtn:hover {
  color: #eee;
}
#loginRemember {
  font-size: 12px;
  color: #aaa;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: #252526;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
QToolButton#userMgrAddBtn {
  background: #0D47A1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
QToolButton#userMgrAddBtn:hover {
  background: #1565C0;
}
#userMgrTable {
  border: 1px solid #3c3c3c;
  border-radius: 8px;
  gridline-color: #333;
  color: #CCCCCC;
  background: #1e1e1e;
}
#userMgrTable::item {
  padding: 6px 12px;
}
QToolButton#userMgrEditBtn {
  background: transparent;
  color: #4FC3F7;
  border: none;
  font-size: 12px;
}
QToolButton#userMgrDeleteBtn {
  background: transparent;
  color: #ef5350;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #666;
}
#userMgrErrorHint {
  font-size: 12px;
  color: #ef5350;
}
QToolButton#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#userMgrCloseBtn:hover {
  color: #eee;
}

/* ==================== HintPopup ==================== */
QFrame#HintPopupContent {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}
QFrame#HintPopupToolbar {
    background-color: #333333;
}
QFrame#HintPopupSeparator {
    background-color: #3C3C3C;
}
QListView#HintPopupList {
    background-color: #2D2D2D;
    border: none;
    outline: none;
}
QLabel#HintPopupEmpty {
    color: #666666;
    font-size: 13px;
    padding: 40px;
}
QToolButton#HintPopupMarkAllBtn,
QToolButton#HintPopupClearBtn {
    background: transparent;
    border: none;
    color: #CCCCCC;
    font-size: 11px;
    padding: 2px 8px;
}
QToolButton#HintPopupMarkAllBtn:hover,
QToolButton#HintPopupClearBtn:hover {
    color: #75BEFF;
}

/* ==================== ProjectStructureWidget Placeholder ==================== */
QWidget#PhPlaceholder {
    background-color: #252526;
    border-radius: 8px;
}
QScrollArea#PhScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea#PhScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QWidget#ScrollAreaContent {
    background-color: transparent;
}

/* 空态提示卡（btn_grid 移除后简化） */
QFrame#PhEmptyCard {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
}
QLabel#PhEmptyTitle {
    font-size: 13px;
    font-weight: 600;
    color: #CCCCCC;
}
QLabel#PhEmptyDesc {
    font-size: 12px;
    color: #858585;
}

/* 分区标题（最近项目/最近文件） */
QLabel#PhSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #9D9D9D;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #3C3C3C;
}
QDockWidget > QWidget {
    background: #252526;
}

/* IcdPropertyPanel 内容区 */
QScrollArea#icdPropertyScroll {
    background-color: #252526;
    border: none;
}
QScrollArea#icdPropertyScroll > QWidget > QWidget {
    background-color: #252526;
}
QWidget#icdPropertyForm {
    background-color: #252526;
}
etest--ui--DockTitleBar {
    background: #2D2D2D;
    border-bottom: 1px solid #3C3C3C;
}
QLabel#dockTitleBarLabel {
    color: #CCCCCC;
    font-size: 12px;
    background: transparent;
}
QToolButton#dockFloatButton, QToolButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QToolButton#dockFloatButton:hover, QToolButton#dockCloseButton:hover {
    background: rgba(255, 255, 255, 0.1);
}
QToolButton#dockFloatButton:pressed, QToolButton#dockCloseButton:pressed {
    background: rgba(255, 255, 255, 0.18);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    padding: 4px 8px;
}QToolButton#PhOpenFilesHeaderBtn:hover {
    color: #CCCCCC;
}

/* ==================== TuxSaverOverlay ==================== */
QToolButton#saverCloseBtn {
    color: rgba(255,255,255,160);
    background: rgba(255,255,255,25);
    border: 1px solid rgba(255,255,255,40);
    border-style: solid;
    font-size: 16px;
    border-radius: 16px;
    padding: 0px;
    margin: 0px;
}
QToolButton#saverCloseBtn:hover {
    background: rgba(255,80,80,160);
    color: white;
    border-color: rgba(255,80,80,230);
    border-width: 1.5px;
    border-style: solid;
}
QToolButton#saverCloseBtn:pressed {
    background: rgba(200,50,50,180);
    color: white;
    border-color: rgba(200,50,50,220);
    border-style: solid;
}

/* ==================== Signal Visualizers (Dark) ==================== */

/* WaveformWidget */
#WaveformTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
    color: #CCCCCC;
}
#WaveformPlot {
    border: 1px solid #3C3C3C;
    border-radius: 2px;
}

/* 两级标题：二级标题（连接描述）小字灰 */
#WaveformSubtitle, #LedSubtitle, #MeterSubtitle, #GaugeSubtitle, #ValueLabelSubtitle {
    font-size: 10px;
    color: #808080;
}
#WaveformSubtitle[state="warning"], #MeterSubtitle[state="warning"], #GaugeSubtitle[state="warning"], #ValueLabelSubtitle[state="warning"], #LedSubtitle[state="warning"] {
  color: #D56224;
}
#WaveformSubtitle[state="deleted"], #MeterSubtitle[state="deleted"], #GaugeSubtitle[state="deleted"], #ValueLabelSubtitle[state="deleted"], #LedSubtitle[state="deleted"] {
  color: #D56224;
}

/* 监听器配置对话框（MonitorConfigDialog） */

/* LedIndicator（合并自 StateLEDWidget；圆灯由 QPainter 绘制，无需 QSS） */
#LedTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#LedSubtitle {
    font-size: 11px;
    color: #808080;
}
#LedField {
    font-size: 12px;
    color: #CCCCCC;
}
#LedStateText {
    font-size: 14px;
    font-weight: bold;
    color: #CCCCCC;
}
#LedPulse {
    font-size: 11px;
    color: #808080;
}
#LedTs {
    font-size: 10px;
    color: #808080;
}

/* DigitalMeterWidget */
#MeterTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#GaugeTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#MeterValue {
    font-size: 28px;
    font-weight: bold;
    color: #E0E0E0;
}
#MeterTrend {
    font-size: 18px;
}
#MeterRange {
    font-size: 11px;
    color: #808080;
}
#MeterRaw {
    font-size: 11px;
    color: #808080;
}
#MeterTs {
    font-size: 10px;
    color: #808080;
}

/* ValueLabelWidget */
#ValueLabelTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#ValueLabelValue {
    font-size: 22px;
    font-weight: bold;
    color: #E0E0E0;
}
#ValueLabelRaw {
    font-size: 11px;
    color: #808080;
}
#ValueLabelTs {
    font-size: 10px;
    color: #808080;
}

/* SignalTreePanel */
#SignalTreeSearch {
    padding: 4px;
    margin: 2px 4px;
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #505050;
    border-radius: 3px;
}
#SignalTree {
    background: transparent;
}

/* VisualizationArea */
#VisualizationArea {
    background: #252526;
    border: none;
}

/* ExecutionDebugWidget */
#ExecDebugTree {
    background: transparent;
}

/* ExecutionDashboard splitter */
#ExecDashboardSplitter::handle {
    width: 2px;
    background: #3C3C3C;
}

/* Ribbon running mode indicator */
#RunningMode {
    border-bottom: 3px solid #ff8800;
}

/* ==================== LogFilterBar（page0 输出面板筛选工具栏） ==================== */
#LogFilterBar {
    background: #252526;
    border: none;
}
#LogFilterBar QLineEdit#LogFilterBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 2px 6px;
    selection-background-color: #264F78;
}
#LogFilterBar QLineEdit#LogFilterBox:focus {
    border-color: #007ACC;
}
/* 正则非法红框 */
#LogFilterBar QLineEdit#LogFilterBox[invalid="true"] {
    border: 1px solid #F44747;
}
#LogFilterBar QToolButton {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    color: #858585;
    font-size: 12px;
    padding: 1px 4px;
}
#LogFilterBar QToolButton:hover {
    background-color: #505050;
    color: #CCCCCC;
}
#LogFilterBar QToolButton:checked {
    background-color: #094771;
    border-color: #007ACC;
    color: #FFFFFF;
}
/* 级别按钮按级别着色（checked 时高亮该级别色） */
#LogFilterBar QToolButton#LevelDebugBtn:checked { color: #858585; }
#LogFilterBar QToolButton#LevelInfoBtn:checked  { color: #CCCCCC; }
#LogFilterBar QToolButton#LevelWarnBtn:checked  { color: #D7BA7D; }
#LogFilterBar QToolButton#LevelErrorBtn:checked { color: #F44747; }
#LogFilterBar QToolButton#LevelFatalBtn:checked { color: #FF0000; }

/* QAB 文件搜索框 */
#RibbonSearchEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 2px 6px;
    selection-background-color: #264F78;
}
#RibbonSearchEdit:focus {
    border-color: #007ACC;
}
#RibbonSearchEdit:disabled {
    background-color: #2D2D2D;
    color: #5A5A5A;
    border: 1px solid #2D2D2D;
}

/* Visualizer 容器背景 */
#ValueLabelWidget, #MeterWidget, #WaveformWidget, #GaugeWidget, #LedIndicator {
    background-color: #1E1E1E;
}

/* ===== QSpinBox 主题适配样式 START ===== */
/* QSpinBox / QDoubleSpinBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #3C3C3C #252526 #4B4B4B #363637 #454545 #CCCCCC
 *        #094771 #007ACC #5A5A5A 0 122 204 light
 */
QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #3C3C3C,
                        stop:1 #252526);
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 8px 30px 8px 12px;
    color: #CCCCCC;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #4B4B4B,
                        stop:1 #363637);
    border: 1px solid #007ACC;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #007ACC;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #252526;
    color: #5A5A5A;
    border: 1px solid #454545;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right top;
    width: 28px;
    height: 14px;
    border: none;
    border-top-right-radius: 7px;
    border-left: 1px solid #454545;
    background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: rgba(0, 122, 204, 0.2);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: right bottom;
    width: 28px;
    height: 14px;
    border: none;
    border-bottom-right-radius: 7px;
    border-left: 1px solid #454545;
    background: transparent;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(0, 122, 204, 0.2);
}
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/resources/icons/svg/arrow_up_light.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(:/resources/icons/svg/arrow_up_light.svg);
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_up_light.svg);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_light.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(:/resources/icons/svg/arrow_down_light.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_light.svg);
}
/* 状态样式 */
QSpinBox[status="success"], QDoubleSpinBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.4);
}
QSpinBox[status="success"]:hover, QDoubleSpinBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QSpinBox[status="success"]:focus, QDoubleSpinBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QSpinBox[status="error"], QDoubleSpinBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.4);
}
QSpinBox[status="error"]:hover, QDoubleSpinBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QSpinBox[status="error"]:focus, QDoubleSpinBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QSpinBox[status="warning"], QDoubleSpinBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.4);
}
QSpinBox[status="warning"]:hover, QDoubleSpinBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QSpinBox[status="warning"]:focus, QDoubleSpinBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QSpinBox[size="small"], QDoubleSpinBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    min-height: 28px;
    border-radius: 6px;
}
QSpinBox[size="small"]::up-button, QDoubleSpinBox[size="small"]::up-button {
    width: 22px;
    height: 12px;
    border-top-right-radius: 5px;
}
QSpinBox[size="small"]::down-button, QDoubleSpinBox[size="small"]::down-button {
    width: 22px;
    height: 12px;
    border-bottom-right-radius: 5px;
}
QSpinBox[size="large"], QDoubleSpinBox[size="large"] {
    padding: 12px 36px 12px 16px;
    font-size: 16px;
    min-height: 48px;
    border-radius: 10px;
}
QSpinBox[size="large"]::up-button, QDoubleSpinBox[size="large"]::up-button {
    width: 32px;
    height: 18px;
    border-top-right-radius: 9px;
}
QSpinBox[size="large"]::down-button, QDoubleSpinBox[size="large"]::down-button {
    width: 32px;
    height: 18px;
    border-bottom-right-radius: 9px;
}
/* 圆角样式 */
QSpinBox[rounded="true"], QDoubleSpinBox[rounded="true"] {
    border-radius: 24px;
    padding: 10px 36px 10px 16px;
}
QSpinBox[rounded="true"]::up-button, QDoubleSpinBox[rounded="true"]::up-button {
    border-top-right-radius: 24px;
}
QSpinBox[rounded="true"]::down-button, QDoubleSpinBox[rounded="true"]::down-button {
    border-bottom-right-radius: 24px;
}
/* 无边框样式 */
QSpinBox[frameless="true"], QDoubleSpinBox[frameless="true"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #454545;
    border-radius: 0;
    padding: 8px 30px 8px 0;
}
QSpinBox[frameless="true"]:hover, QDoubleSpinBox[frameless="true"]:hover {
    border-bottom: 2px solid #007ACC;
}
QSpinBox[frameless="true"]:focus, QDoubleSpinBox[frameless="true"]:focus {
    border-bottom: 2px solid #007ACC;
}
QSpinBox[frameless="true"]::up-button, QDoubleSpinBox[frameless="true"]::up-button {
    border-left: none;
}
QSpinBox[frameless="true"]::down-button, QDoubleSpinBox[frameless="true"]::down-button {
    border-left: none;
}
/* ===== QSpinBox 主题适配样式 END ===== */

/* ===== QComboBox 主题适配样式 START ===== */
/* QComboBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #3C3C3C #252526 #4B4B4B #363637 #454545 #CCCCCC
 *        #094771 #007ACC #5A5A5A 0 122 204 light
 */
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #3C3C3C,
                        stop:1 #252526);
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 8px 36px 8px 8px;
    color: #CCCCCC;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
    min-height: 20px;
}
/* 下拉箭头 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    height: 100%;
    border: none;
    border-left: 1px solid #454545;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background: transparent;
}
QComboBox::drop-down:hover {
    background: rgba(0, 122, 204, 0.2);
}
QComboBox::drop-down:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QComboBox::drop-down::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_light.svg);
    subcontrol-origin: margin;
    subcontrol-position: right center;
}
/* 下拉列表视图 */
QComboBox QAbstractItemView {
    background: #252526;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
    outline: none;
    alternate-background-color: transparent;
    color: #CCCCCC;
}
QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    margin: 2px 4px;
    border-radius: 6px;
    min-height: 24px;
    color: #CCCCCC;
}
QComboBox QAbstractItemView::item:hover {
    background: rgba(0, 122, 204, 0.3);
    color: #CCCCCC;
}
QComboBox QAbstractItemView::item:selected {
    background: rgba(0, 122, 204, 0.6);
    color: #FFFFFF;
    border: 1px solid rgba(0, 122, 204, 0.8);
}
QComboBox QAbstractItemView::item:alternate {
    background: transparent;
}
/* 悬停 */
QComboBox:hover {
    border: 1px solid #007ACC;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #4B4B4B,
                        stop:1 #363637);
}
/* 焦点 */
QComboBox:focus {
    border: 2px solid #007ACC;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #4B4B4B,
                        stop:1 #363637);
}
/* 禁用 */
QComboBox:disabled {
    background: #252526;
    color: #5A5A5A;
    border: 1px solid #454545;
}
QComboBox::drop-down:disabled {
    background: #252526;
    border-left: 1px solid #454545;
}
QComboBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_light.svg);
    opacity: 0.5;
}
/* 可编辑状态 */
QComboBox[editable="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #3C3C3C,
                        stop:1 #252526);
}
QComboBox[editable="true"] QLineEdit {
    background: transparent;
    border: none;
    color: #CCCCCC;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
    padding: 0px;
}
QComboBox[editable="true"] QLineEdit:focus {
    border: none;
    outline: none;
}
/* 状态样式 */
QComboBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QComboBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.8);
}
QComboBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QComboBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QComboBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.8);
}
QComboBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QComboBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QComboBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.8);
}
QComboBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QComboBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    border-radius: 6px;
    min-height: 16px;
}
QComboBox[size="small"]::drop-down {
    width: 24px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QComboBox[size="small"]::drop-down::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox[size="small"] QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 20px;
    font-size: 12px;
}
QComboBox[size="large"] {
    padding: 10px 32px 10px 16px;
    font-size: 16px;
    border-radius: 10px;
    min-height: 24px;
}
QComboBox[size="large"]::drop-down {
    width: 36px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}
QComboBox[size="large"]::drop-down::down-arrow {
    width: 14px;
    height: 14px;
}
QComboBox[size="large"] QAbstractItemView::item {
    padding: 12px 16px;
    min-height: 28px;
    font-size: 16px;
}
/* 特殊样式 */
QComboBox[rounded="true"] {
    border-radius: 20px;
    padding: 8px 32px 8px 20px;
}
QComboBox[rounded="true"]::drop-down {
    border-top-right-radius: 19px;
    border-bottom-right-radius: 19px;
}
QComboBox[rounded="true"] QAbstractItemView {
    border-radius: 12px;
}
QComboBox[rounded="true"] QAbstractItemView::item {
    border-radius: 8px;
}
QComboBox[frameless="true"] {
    border: none;
    background: #252526;
}
QComboBox[frameless="true"]::drop-down {
    border-left: none;
}
QComboBox[frameless="true"]:hover {
    background: #363637;
}
QComboBox[frameless="true"]:focus {
    background: #363637;
}
/* ===== QComboBox 主题适配样式 END ===== */

/* ===== QScrollArea 主题适配样式 START ===== */
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
#ScrollAreaContent {
    background: transparent;
}
/* ===== QScrollArea 主题适配样式 END ===== */

/* ===== QGroupBox 主题适配样式 START ===== */
QGroupBox {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 8px;
    margin-top: 0px;
    padding: 22px 12px 12px 12px;
    color: #CCCCCC;
}
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 12px;
    top: 8px;
    padding: 0 4px;
    color: #858585;
    font-size: 12px;
    font-weight: 700;
}
QGroupBox:hover {
    border: 1px solid #007ACC;
}
QGroupBox[selected="true"] {
    border: 2px solid #007ACC;
}
/* ===== QGroupBox 主题适配样式 END ===== */

/* ===== visualizer 副标题状态配色 START ===== */

#WaveformSubtitle[state="warning"], #MeterSubtitle[state="warning"], #GaugeSubtitle[state="warning"], #ValueLabelSubtitle[state="warning"], #LedSubtitle[state="warning"] {
  color: #D56224;
}
#WaveformSubtitle[state="deleted"], #MeterSubtitle[state="deleted"], #GaugeSubtitle[state="deleted"], #ValueLabelSubtitle[state="deleted"], #LedSubtitle[state="deleted"] {
  color: #D56224;
}
/* ===== visualizer 副标题状态配色 END ===== */

