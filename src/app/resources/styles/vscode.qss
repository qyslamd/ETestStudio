}

/* ==================== etest--app--SettingsDialog ==================== */
etest--app--SettingsDialog {
    background-color: transparent;  /* 遮罩由 OverlayDialog paintEvent 绘制，卡片区由 #SettingsContent 覆盖 */
}
QWidget#SettingsContent {
    background-color: #252526;
    border-radius: 16px;
}
QLabel#SettingsAppIcon {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0078D4, stop: 1 #4AA8FF);
    border-radius: 9px;
}
QLabel#SettingsTitleText {
    color: #F0F0F4;
    font-size: 15px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#SettingsTitleSub {
    color: #6A6A84;
    font-size: 12px;
    background-color: transparent;
}
QToolButton#SettingsCloseBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 6px;
}
QToolButton#SettingsCloseBtn:hover {
    background: rgba(255, 255, 255, 0.08);
}
QLabel#SettingsPageTitle {
    color: #F0F0F4;
    font-size: 20px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#SettingsPageSub {
    color: #6A6A84;
    font-size: 13px;
    background-color: transparent;
}
QWidget#SettingsAboutCard {
    background-color: #2D2D33;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}
QLabel#SettingsAboutIcon {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0078D4, stop: 1 #4AA8FF);
    border-radius: 14px;
}
QLabel#SettingsAboutName {
    color: #F0F0F4;
    font-size: 17px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#SettingsAboutVersion,
QLabel#SettingsAboutCopyright {
    color: #6A6A84;
    background-color: transparent;
}
QLabel#SettingsAboutVersion {
    font-size: 13px;
}
QLabel#SettingsAboutCopyright {
    font-size: 12px;
}

/* 左侧分类列表 */
etest--app--SettingsDialog QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border-right: 1px solid #1E1E1E;
    font-size: 13px;
    outline: none;
}
etest--app--SettingsDialog QListWidget::item {
    padding: 9px 12px;
    border: none;
    border-radius: 7px;
    margin: 2px 6px;
}
etest--app--SettingsDialog QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.06);
}
etest--app--SettingsDialog QListWidget::item:selected {
    background-color: rgba(74, 168, 255, 0.16);
    color: #4AA8FF;
}

/* 右侧页面容器 */
/* 右侧平铺滚动区 */
etest--app--SettingsDialog QScrollArea {
    background: transparent;
    border: none;
}

/* 外观页内嵌滚动区 */
etest--app--SettingsDialog QScrollArea {
    background-color: #1E1E1E;
    border: none;
}
etest--app--SettingsDialog QScrollArea > QWidget {
    background-color: #1E1E1E;
}
etest--app--SettingsDialog QScrollArea > QWidget > QWidget {
    background-color: #1E1E1E;
}

/* 卡片容器 */
QWidget#SettingsCard {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}
QLabel#SettingsCardTitle {
    color: #CCCCCC;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0 8px;
    background-color: transparent;
}

/* VS Code 风格设置行 */
QWidget#SettingsRow {
    border-bottom: 1px solid #2D2D2D;
    background-color: transparent;
}
QLabel#SettingsRowTitle {
    color: #CCCCCC;
    font-size: 13px;
    background-color: transparent;
}
QLabel#SettingsRowDesc {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
}
QLabel#SettingsHint {
    color: #888888;
    font-size: 11px;
    padding: 4px 0;
    background-color: transparent;
}

/* 设置页通用标签 */
etest--app--SettingsDialog QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* 底部按钮栏 */
QWidget#SettingsButtonBar {
    border-top: 1px solid #1E1E1E;
    background-color: transparent;  /* 露出卡片圆角底部 */
}
QWidget#SettingsButtonBar QPushButton {
    background-color: transparent;
    color: #CCCCCC;
    border: none;
    border-radius: 6px;
    padding: 6px 18px;
}
QWidget#SettingsButtonBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
    border: 1px solid #454545;
}

/* 设置页中的文本框 */
etest--app--SettingsDialog QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QLineEdit:focus {
    border-color: #007ACC;
}

/* Fluent 下拉 / 数字控件 */
etest--app--SettingsDialog QComboBox,
etest--app--SettingsDialog QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 120px;
}
etest--app--SettingsDialog QComboBox:hover,
etest--app--SettingsDialog QSpinBox:hover,
etest--app--SettingsDialog QComboBox:focus,
etest--app--SettingsDialog QSpinBox:focus {
    border-color: #4AA8FF;
}
etest--app--SettingsDialog QComboBox::drop-down {
    border: none;
    width: 22px;
}
/* Toggle 由 SwitchButton 自绘，删除设置页 QCheckBox 死样式 */

/* 设置页中的按钮 — 已由全局 QPushButton 统一样式覆盖 */

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #252526;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
