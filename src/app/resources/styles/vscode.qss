/* VSCode Dark Theme for ETest Demo */

/* 全局背景色和前景色 */
QMainWindow {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 菜单栏 */
QMenuBar {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border-bottom: 1px solid #252526;
    padding: 2px;
}
QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #094771;
}
QMenu {
    min-width: 200px;
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
}
QMenu::item {
    padding: 6px 28px 6px 20px;
}
QMenu::item:selected {
    background-color: #094771;
}
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 10px;
}

/* 工具栏 */
QToolBar {
    background-color: #2D2D2D;
    border: none;
    padding: 2px 4px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background-color: #454545;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    color: #CCCCCC;
    padding: 4px;
    margin: 1px;
}
QToolButton:hover {
    background-color: #505050;
}
QToolButton:pressed {
    background-color: #3C3C3C;
}
QToolButton:disabled {
    color: #5A5A5A;
}

/* 状态栏 */
QStatusBar {
    background-color: #007ACC;
    color: #FFFFFF;
    font-size: 12px;
    border-top: 1px solid #006BAB;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #FFFFFF;
    padding: 0px 8px;
}
QStatusBar QLabel:hover {
    background-color: rgba(255, 255, 255, 30);
}

/* ==================== QADS Dock 样式（暗色覆盖）已迁移至 ads_dark.qss ==================== */
/* QADS的样式必须设置到CDockManager自身，否则会被QADS内置的default.css覆盖 */

/* 滚动条 */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4F4F4F;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4F4F4F;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 分割器 */
QSplitter::handle {
    background-color: #252526;
}
QSplitter::handle:hover {
    background-color: #007ACC;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}
QTabBar::tab {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 6px 12px;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
}
QTabBar::tab:hover:!selected {
    color: #FFFFFF;
}

/* 文本编辑区 */
QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* 表格 */
QTableWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    gridline-color: #333333;
    selection-background-color: #094771;
}
QTableWidget::item {
    padding: 4px;
}
QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    font-weight: bold;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

/* 树形视图 */
QTreeView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QTreeView::item {
    padding: 2px 4px 2px 0px;
    border: none;
}
QTreeView::item:hover {
    background-color: #2A2D2E;
}
QTreeView::item:selected {
    background-color: #094771;
}
QTreeView::branch {
    background-color: #252526;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}
QTreeView QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #007ACC;
    padding: 0px 2px;
    margin: 0px;
    selection-background-color: #264F78;
}

/* 硬件树 */
QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeWidget::item {
    padding: 3px 0px;
    border: none;
}
QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
QTreeWidget::item:selected {
    background-color: #094771;
}
QTreeWidget::branch {
    background-color: #252526;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}

/* 按钮 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #1177BB;
}
QPushButton:pressed {
    background-color: #0D5A8F;
}
QPushButton:disabled {
    background-color: #3C3C3C;
    color: #5A5A5A;
    border-color: #3C3C3C;
}

/* 输入框 */
QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
QLineEdit:focus {
    border-color: #007ACC;
}

/* 对话框 */
QDialog {
    background-color: #252526;
    color: #CCCCCC;
}

/* Label */
QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* ComboBox */
QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #007ACC;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
}

/* SpinBox */
QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QSpinBox:focus {
    border-color: #007ACC;
}

/* CheckBox */
QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* RadioButton */
QRadioButton {
    color: #CCCCCC;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 7px;
    background-color: #3C3C3C;
}
QRadioButton::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

/* GroupBox */
QGroupBox {
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
}

/* ToolTip */
QToolTip {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    padding: 4px 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #3C3C3C;
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 2px;
}

/* ListBox / ListWidget */
QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
}
QListWidget::item:hover {
    background-color: #2A2D2E;
}
QListWidget::item:selected {
    background-color: #094771;
}

/* ScrollArea */
QScrollArea {
    background-color: #1E1E1E;
    border: none;
}

/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #333333;
    border-right: 1px solid #252526;
}
QWidget#sidebarActivityBar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #858585;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QPushButton:hover {
    background-color: #2A2D2E;
    color: #FFFFFF;
}
QWidget#sidebarActivityBar QPushButton:checked {
    border-left: 2px solid #007ACC;
    color: #FFFFFF;
    background-color: #2A2D2E;
}

/* ==================== SidebarWidget ==================== */
SidebarWidget {
    background-color: #252526;
    border-right: 1px solid #1E1E1E;
}
SidebarWidget QLabel {
    color: #BBBBBB;
    font-size: 11px;
    font-weight: bold;
}
SidebarWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
SidebarWidget QToolButton:hover {
    color: #FFFFFF;
}
#sidebarTitleBar {
    background-color: #252526;
}

/* ==================== ProtocolManagerWidget ==================== */
ProtocolManagerWidget {
    background-color: #252526;
}
ProtocolManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
ProtocolManagerWidget QTreeWidget::item {
    padding: 4px 8px;
    min-height: 22px;
}
ProtocolManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
ProtocolManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
#protocolManagerToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#protocolNewBtn, #protocolImportBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 2px 12px;
    font-size: 12px;
}
#protocolNewBtn:hover, #protocolImportBtn:hover {
    background-color: #505050;
}
#protocolNewBtn:pressed, #protocolImportBtn:pressed {
    background-color: #2D2D2D;
}

/* ==================== TestProgramManagerWidget ==================== */
TestProgramManagerWidget {
    background-color: #252526;
}
TestProgramManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
TestProgramManagerWidget QTreeWidget::item {
    padding: 4px 8px;
    min-height: 22px;
}
TestProgramManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
TestProgramManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
#testProgramToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#testProgramNewBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 2px 12px;
    font-size: 12px;
}
#testProgramNewBtn:hover {
    background-color: #505050;
}
#testProgramNewBtn:pressed {
    background-color: #2D2D2D;
}

/* ==================== TestProgramEditorWidget ==================== */
TestProgramEditorWidget {
    background-color: #1E1E1E;
}
TestProgramEditorWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QLineEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QTextEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTableWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    gridline-color: #3C3C3C;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
TestProgramEditorWidget QTableWidget::item {
    padding: 4px 8px;
}
TestProgramEditorWidget QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: none;
    border-bottom: 1px solid #3C3C3C;
    padding: 4px 8px;
    font-weight: bold;
}
TestProgramEditorWidget QTabWidget::pane {
    border: 1px solid #3C3C3C;
    background-color: #252526;
}
TestProgramEditorWidget QTabBar::tab {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: none;
    padding: 6px 16px;
    margin-right: 2px;
}
TestProgramEditorWidget QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border-bottom: 2px solid #007ACC;
}
TestProgramEditorWidget QTabBar::tab:hover {
    background-color: #3C3C3C;
}
#testProgramEditorToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#testProgramEditorAddCaseBtn, #testProgramEditorRemoveCaseBtn,
#testProgramEditorAddStepBtn, #testProgramEditorRemoveStepBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
#testProgramEditorAddCaseBtn:hover, #testProgramEditorRemoveCaseBtn:hover,
#testProgramEditorAddStepBtn:hover, #testProgramEditorRemoveStepBtn:hover {
    background-color: #505050;
}
#testProgramEditorAddCaseBtn:pressed, #testProgramEditorRemoveCaseBtn:pressed,
#testProgramEditorAddStepBtn:pressed, #testProgramEditorRemoveStepBtn:pressed {
    background-color: #2D2D2D;
}

/* ==================== SearchWidget ==================== */
SearchWidget {
    background-color: #252526;
}
SearchWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
SearchWidget QLineEdit:focus {
    border-color: #007ACC;
}
SearchWidget QPushButton {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    color: #CCCCCC;
    padding: 2px;
}
SearchWidget QPushButton:hover {
    background-color: #505050;
    border-color: #007ACC;
}
SearchWidget QCheckBox {
    color: #858585;
    spacing: 2px;
    background-color: transparent;
}
SearchWidget QCheckBox::indicator {
    width: 14px;
    height: 14px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
SearchWidget QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
SearchWidget QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
SearchWidget QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
SearchWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
SearchWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
SearchWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
SearchWidget QTreeWidget::item:selected {
    background-color: #094771;
}
SearchWidget QFrame {
    background-color: #3C3C3C;
    max-height: 1px;
}
SearchWidget QLabel {
    color: #858585;
    font-size: 12px;
    background-color: transparent;
}

/* ==================== GitWidget ==================== */
GitWidget {
    background-color: #252526;
}
GitWidget QLabel {
    color: #CCCCCC;
    background-color: transparent;
}
GitWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
    font-size: 13px;
}
GitWidget QTextEdit:focus {
    border-color: #007ACC;
}
GitWidget QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 2px 6px;
}
GitWidget QPushButton:hover {
    background-color: #1177BB;
}
GitWidget QPushButton:pressed {
    background-color: #0D5A8F;
}
GitWidget QPushButton#refresh_button_ {
    background-color: transparent;
    border: none;
    padding: 0px;
}
GitWidget QPushButton#refresh_button_:hover {
    background-color: #505050;
    border-radius: 3px;
}
GitWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
GitWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
GitWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
GitWidget QTreeWidget::item:selected {
    background-color: #094771;
}
GitWidget QLabel#gitEmptyLabel {
    color: #858585;
    font-size: 13px;
}

/* ==================== BottomContainerWidget ==================== */
BottomContainerWidget {
    background-color: #1E1E1E;
}
BottomContainerWidget QTabWidget {
    background-color: #1E1E1E;
}
BottomContainerWidget QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}
BottomContainerWidget QTabBar::tab {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 4px 12px;
    margin-right: 1px;
}
BottomContainerWidget QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border-bottom: 1px solid #007ACC;
}
BottomContainerWidget QTabBar::tab:hover:!selected {
    color: #FFFFFF;
}
BottomContainerWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
BottomContainerWidget QToolButton:hover {
    color: #FFFFFF;
}

/* ==================== NewProjectDialog ==================== */
QLabel#previewLabel {
    color: gray;
}
QLabel#errorLabel {
    color: red;
}

/* ==================== TerminalPanel ==================== */
TerminalPanel QPlainTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* ==================== ProtocolEditorWidget ==================== */
#protocolToolbar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}
#protocolTitleLabel {
    font-weight: bold;
    color: #cccccc;
    padding-right: 12px;
}
#frameNameLabel {
    color: #4ec9b0;
    padding-right: 16px;
}
#idLabel {
    color: #888888;
    padding-left: 12px;
}
#lengthLabel {
    color: #888888;
    padding-right: 8px;
}
#protocolStatusBar {
    background-color: #007acc;
    color: white;
    font-size: 12px;
}

/* ==================== TopologyEditorWidget ==================== */
etest--topology--TopologyEditorWidget {
    background-color: #1E1E1E;
}
QToolBar#topologyToolbar {
    background-color: #2D2D2D;
    border-bottom: 1px solid #252526;
    spacing: 2px;
    padding: 2px;
}
QLabel#topologyZoomLabel {
    padding: 0 4px;
    color: #CCCCCC;
}
QWidget#PhLoadingOverlay {
    background-color: #1E1E1E;
}
QLabel#PhLoadingOverlayLabel {
    font-size: 13px;
    color: #888888;
    background: transparent;
}

/* ==================== PropertyPanelWidget ==================== */
#emptyPage, #uutPage, #portPage, #devicePage, #connectionPage, #devicePortPage {
    background-color: #3C3C3C;
}
#emptyPage QLabel {
    color: #888888;
}

/* ==================== GitWidget ==================== */
GitWidget QLabel#gitTitleLabel {
    color: #BBBBBB;
    font-weight: bold;
    font-size: 11px;
    background: transparent;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: white;
    border: 1px solid #ccc;
    border-radius: 8px;
}

/* ==================== 欢迎页 ==================== */
QWidget#WelcomeWidget {
    background-color: #1E1E1E;
}

/* --- Action Tiles (新建/打开项目, 1x1) --- */
QLabel#WelcomeActionIcon {
    color: #0E639C;
    font-size: 28px;
}
QLabel#WelcomeActionText {
    color: #CCCCCC;
    font-size: 14px;
    font-weight: bold;
}

/* --- Eye Widget Tile (4x1) --- */
QWidget#WelcomeEyeContent {
    background: transparent;
}
QWidget#WelcomeEyeTopBar {
    background: transparent;
}
QLabel#WelcomeEyeLogoLabel {
    color: #CCCCCC;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#WelcomeEyeVersionLabel {
    color: #888888;
    font-size: 11px;
    background: transparent;
}
QLabel#WelcomeEyeIconLabel {
    background: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* --- Recent Project Tiles (1x1) --- */
QWidget#WelcomeProjectCardContent {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}
QWidget#WelcomeProjectCardContent:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QLabel#WelcomeRecentCardName {
    color: #E0E0E0;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeRecentCardPath {
    color: #aaaaaa;
    font-size: 11px;
}
QLabel#WelcomeRecentCardTime {
    color: #666666;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #CCCCCC;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
QLabel#gridTileName {
    color: #999999;
    font-size: 11px;
}

/* --- Daily Tip Tile --- */
QLabel#WelcomeTipTitle {
    color: #cccccc;
    font-size: 14px;
    font-weight: bold;
}
QLabel#WelcomeTipContent {
    color: #aaaaaa;
    font-size: 12px;
}

/* ==================== SettingsDialog ==================== */
SettingsDialog {
    background-color: #252526;
}

/* 左侧分类树 */
SettingsDialog QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border-right: 1px solid #1E1E1E;
    font-size: 13px;
    outline: none;
}
SettingsDialog QTreeWidget::item {
    padding: 6px 12px;
    border: none;
    color: #CCCCCC;
}
SettingsDialog QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
SettingsDialog QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}

/* 右侧滚动区 + 内部 QStackedWidget + 页面 */
SettingsDialog QScrollArea {
    background-color: #1E1E1E;
    border: none;
}
SettingsDialog QScrollArea QWidget {
    background-color: #1E1E1E;
}
SettingsDialog QStackedWidget {
    background-color: #1E1E1E;
}

/* 分组标题 */
QLabel#SettingsSectionHeader {
    color: #CCCCCC;
    font-weight: bold;
    font-size: 13px;
    padding-top: 8px;
    padding-bottom: 4px;
    background-color: transparent;
}

/* 设置页中的表单标签 */
SettingsDialog QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* 设置页中的数值控件 */
SettingsDialog QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
SettingsDialog QSpinBox:focus {
    border-color: #007ACC;
}
SettingsDialog QSpinBox::up-button,
SettingsDialog QSpinBox::down-button {
    background-color: #3C3C3C;
    border: none;
    width: 16px;
}
SettingsDialog QSpinBox::up-arrow,
SettingsDialog QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* 设置页中的下拉框 */
SettingsDialog QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
SettingsDialog QComboBox:hover {
    border-color: #007ACC;
}
SettingsDialog QComboBox::drop-down {
    background-color: #3C3C3C;
    border: none;
    width: 20px;
}
SettingsDialog QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
    border: 1px solid #454545;
}

/* 设置页中的复选框 */
SettingsDialog QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
    background-color: transparent;
}
SettingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
SettingsDialog QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
SettingsDialog QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
SettingsDialog QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
SettingsDialog QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
SettingsDialog QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
SettingsDialog QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* 设置页中的按钮 */
SettingsDialog QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
SettingsDialog QPushButton:hover {
    background-color: #1177BB;
}
SettingsDialog QPushButton:pressed {
    background-color: #0D5A8F;
}

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #252526;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1A8FE3, stop: 1 #0A5CA8);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #CCCCCC;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #3C3C3C;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #888888;
    font-size: 11px;
    background: transparent;
}
#aboutOkButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
#aboutOkButton:hover {
    background-color: #1177BB;
}
#aboutOkButton:pressed {
    background-color: #0D5A8F;
}
#aboutCopyright {
    color: #666666;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #555555;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: #252526;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1565C0, stop:1 #4527A0);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#loginUsername, #loginPassword {
  background: #3c3c3c;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #CCCCCC;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #4FC3F7;
  background: #3c3c3c;
}
#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #1565C0, stop:1 #42A5F5);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1E88E5);
}
#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1565C0);
}
#loginHint {
  color: #ef5350;
  font-size: 12px;
}
#loginCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
#loginCloseBtn:hover {
  color: #eee;
}
#loginRemember {
  font-size: 12px;
  color: #aaa;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: #252526;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
#userMgrAddBtn {
  background: #0D47A1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
#userMgrAddBtn:hover {
  background: #1565C0;
}
#userMgrTable {
  border: 1px solid #3c3c3c;
  border-radius: 8px;
  gridline-color: #333;
  color: #CCCCCC;
  background: #1e1e1e;
}
#userMgrTable::item {
  padding: 6px 12px;
}
#userMgrEditBtn {
  background: transparent;
  color: #4FC3F7;
  border: none;
  font-size: 12px;
}
#userMgrDeleteBtn {
  background: transparent;
  color: #ef5350;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #666;
}
#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
#userMgrCloseBtn:hover {
  color: #eee;
}

/* ==================== HintBar ==================== */
QWidget#HintBar {
    background-color: #252526;
    border-bottom: 1px solid #3C3C3C;
}
QWidget#HintItem {
    background-color: #3D3200;
    border-bottom: 1px solid #665500;
}
QLabel#HintIndicator {
    color: #569CD6;
    font-size: 10px;
}
QLabel#HintText {
    color: #CCCCCC;
    font-size: 12px;
}
QPushButton#HintActionBtn {
    background-color: #2D2D2D;
    color: #75BEFF;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    font-size: 11px;
    padding: 0 8px;
}
QPushButton#HintActionBtn:hover {
    background-color: #383838;
    border-color: #569CD6;
}
QPushButton#HintCloseBtn {
    background: transparent;
    border: none;
    color: #666;
    font-size: 12px;
}
QPushButton#HintCloseBtn:hover {
    color: #FFFFFF;
}

/* ==================== ProjectStructureWidget Placeholder ==================== */
QWidget#PhPlaceholder {
    background-color: #252526;
}
QScrollArea#PhScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea#PhScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QWidget#PhScrollContent {
    background-color: transparent;
}

/* Section headers (项目管理/最近项目) */
QLabel#PhSectionLabel {
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
    background: transparent;
}

/* Project action buttons (新建项目/打开项目) */
QPushButton#PhProjectBtn {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    text-align: left;
    padding: 0 12px;
    font-size: 12px;
}
QPushButton#PhProjectBtn:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QPushButton#PhProjectBtn:pressed {
    background-color: #094771;
}

QLabel#PhTitle {
    font-size: 14px;
    font-weight: 600;
    color: #888888;
}
QLabel#PhDesc {
    font-size: 12px;
    color: #AAAAAA;
}
QFrame#PhSeparator {
    color: #3C3C3C;
    max-height: 1px;
}
QLabel#PhRecentEmpty {
    color: #666666;
    font-size: 11px;
    padding: 16px 0;
}
QPushButton#PhQuickBtn {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QPushButton#PhQuickBtn:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QPushButton#PhQuickBtn:pressed {
    background-color: #094771;
}

/* --- RecentProjectCard in placeholder (narrow sidebar context) --- */
QWidget#PhRecentCard {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
}
QWidget#PhRecentCard:hover {
    background-color: #37373D;
    border-color: #007ACC;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #3C3C3C;
}
QDockWidget > QWidget {
    background: #252526;
}
etest--ui--DockTitleBar {
    background: #2D2D2D;
    border-bottom: 1px solid #3C3C3C;
}
QLabel#dockTitleBarLabel {
    color: #CCCCCC;
    font-size: 12px;
    background: transparent;
}
QPushButton#dockFloatButton, QPushButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QPushButton#dockFloatButton:hover, QPushButton#dockCloseButton:hover {
    background: rgba(255, 255, 255, 0.1);
}
QPushButton#dockFloatButton:pressed, QPushButton#dockCloseButton:pressed {
    background: rgba(255, 255, 255, 0.18);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    padding: 4px 8px;
}
QToolButton#PhOpenFilesHeaderBtn:hover {
    color: #CCCCCC;
}
}
