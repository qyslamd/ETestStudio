/* VSCode Dark Theme for ETest Demo */

/* 全局背景色和前景色 */
QMainWindow {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 菜单栏 */
QMenuBar {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border-bottom: 1px solid #252526;
    padding: 2px;
}
QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #094771;
}
QMenu {
    min-width: 200px;
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
}
QMenu::item {
    padding: 6px 28px 6px 20px;
}
QMenu::item:selected {
    background-color: #094771;
}
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 10px;
}

/* 工具栏 */
QToolBar {
    background-color: #2D2D2D;
    border: none;
    padding: 2px 4px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background-color: #454545;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    color: #CCCCCC;
    padding: 4px;
    margin: 1px;
}
QToolButton:hover {
    background-color: #505050;
}
QToolButton:pressed {
    background-color: #3C3C3C;
}
QToolButton:disabled {
    color: #5A5A5A;
}

/* 状态栏 */
QStatusBar {
    background-color: #007ACC;
    color: #FFFFFF;
    font-size: 12px;
    border-top: 1px solid #006BAB;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #FFFFFF;
    padding: 0px 8px;
}
QStatusBar QLabel:hover {
    background-color: rgba(255, 255, 255, 30);
}

/* ==================== QADS Dock 样式（暗色覆盖）已迁移至 ads_dark.qss ==================== */
/* QADS的样式必须设置到CDockManager自身，否则会被QADS内置的default.css覆盖 */

/* 滚动条 */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4F4F4F;
}
QScrollBar::handle:vertical:pressed {
    background-color: #3F3F3F;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4F4F4F;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #3F3F3F;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 分割器 */
QSplitter::handle {
    background-color: #3C3C3C;
}
QSplitter::handle:horizontal {
    background-color: #3C3C3C;
    width: 3px;
}
QSplitter::handle:horizontal:hover {
    background-color: #007ACC;
}
QSplitter::handle:vertical {
    background-color: #3C3C3C;
    height: 3px;
}
QSplitter::handle:vertical:hover {
    background-color: #007ACC;
}

/* Tab Widget — 由 TabBarStyle 全权自绘，不使用 QSS */
QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}

/* 文本编辑区 */
QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* 表格 */
QTableWidget, QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #252526;
    color: #CCCCCC;
    border: none;
    gridline-color: #333333;
    selection-background-color: #094771;
}
QTableWidget::item, QTableView::item {
    padding: 4px;
}
QHeaderView {
    background-color: #1E1E1E;
}
QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    font-weight: bold;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}
QTableCornerButton::section {
    background-color: #2D2D2D;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
}
QTableCornerButton::section:hover {
    background-color: #3C3C3C;
}

/* 树形视图 */
QTreeView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QTreeView::item {
    padding: 2px 4px 2px 0px;
    border: none;
}
QTreeView::item:hover {
    background-color: #2A2D2E;
}
QTreeView::item:selected {
    background-color: #094771;
}
QTreeView::branch {
    background-color: #252526;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}
QTreeView QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #007ACC;
    padding: 0px 2px;
    margin: 0px;
    selection-background-color: #264F78;
}

/* 列表视图（最近文件等） */
QListView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QListView::item {
    padding: 2px 4px;
    border: none;
}
QListView::item:hover {
    background-color: #2A2D2E;
}
QListView::item:selected {
    background-color: #094771;
}

/* 硬件树 */
QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeWidget::item {
    padding: 3px 0px;
    border: none;
}
QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
QTreeWidget::item:selected {
    background-color: #094771;
}
QTreeWidget::branch {
    background-color: #252526;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}

/* 按钮 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #1177BB;
}
QPushButton:pressed {
    background-color: #0D5A8F;
}
QPushButton:disabled {
    background-color: #3C3C3C;
    color: #5A5A5A;
    border-color: #3C3C3C;
}

/* 输入框 */
QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
QLineEdit:focus {
    border-color: #007ACC;
}

/* 对话框 */
QDialog {
    background-color: #252526;
    color: #CCCCCC;
}

/* Label */
QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* ComboBox */
QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #007ACC;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/resources/icons/svg/drop_down_arrow_light.svg);
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
}

/* SpinBox */
QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QSpinBox:focus {
    border-color: #007ACC;
}

/* DoubleSpinBox */
QDoubleSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}
QDoubleSpinBox:hover {
    border-color: #007ACC;
}
QDoubleSpinBox:focus {
    border-color: #007ACC;
}
QDoubleSpinBox:disabled {
    background-color: #2D2D2D;
    color: #5A5A5A;
    border-color: #2D2D2D;
}
/* CheckBox */
QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* RadioButton */
QRadioButton {
    color: #CCCCCC;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 7px;
    background-color: #3C3C3C;
}
QRadioButton::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

/* GroupBox */
QGroupBox {
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
}

/* ToolTip */
QToolTip {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    padding: 4px 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #3C3C3C;
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 2px;
}

/* ListBox / ListWidget */
QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
}
QListWidget::item:hover {
    background-color: #2A2D2E;
}
QListWidget::item:selected {
    background-color: #094771;
}

/* ScrollArea */
QScrollArea {
    background-color: #1E1E1E;
    border: none;
}

/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #333333;
    border-right: 1px solid #252526;
}
QWidget#sidebarActivityBar QToolButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #858585;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QToolButton:hover {
    background-color: #2A2D2E;
    color: #FFFFFF;
}
QWidget#sidebarActivityBar QToolButton:checked {
    border-left: 2px solid #007ACC;
    color: #FFFFFF;
    background-color: #2A2D2E;
}

/* ==================== SidebarWidget ==================== */
SidebarWidget {
    background-color: #252526;
    border-right: 1px solid #1E1E1E;
}
SidebarWidget QLabel {
    color: #BBBBBB;
    font-size: 11px;
    font-weight: bold;
}
SidebarWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
SidebarWidget QToolButton:hover {
    color: #FFFFFF;
}
#sidebarTitleBar {
    background-color: #252526;
}

/* ==================== ProtocolManagerWidget (ICDConfig 视图) ==================== */
ProtocolManagerWidget {
    background-color: #252526;
}
ProtocolManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    alternate-background-color: #252526;
}
ProtocolManagerWidget QTreeWidget::item {
    padding: 3px 6px;
    min-height: 20px;
    border: 0;
}
ProtocolManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
ProtocolManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
/* 帧条目禁用态：灰色 + 删除线（在代码中通过 font strikeOut + foreground 实现） */
ProtocolManagerWidget QTreeWidget::indicator {
    width: 13px;
    height: 13px;
}
ProtocolManagerWidget QHeaderView {
    background-color: #1E1E1E;
    border: none;
    border-bottom: 1px solid #1E1E1E;
}
ProtocolManagerWidget QHeaderView::section {
    background-color: #252526;
    color: #969696;
    padding: 4px 8px;
    border: 0;
    border-right: 1px solid #1E1E1E;
    font-weight: 600;
    font-size: 11px;
}
ProtocolManagerWidget QHeaderView::section:last {
    border-right: 0;
}

#protocolManagerTitle {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#protocolManagerConfigLabel {
    color: #CCCCCC;
    font-size: 12px;
    font-weight: 600;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn {
    background-color: transparent;
    border: none;
    padding: 0px;
    border-radius: 3px;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:hover {
    background-color: #505050;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:pressed {
    background-color: #094771;
}

#protocolManagerToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}

#protocolManagerEmpty {
    background-color: #252526;
}
#protocolManagerEmptyText {
    color: #969696;
    font-size: 12px;
    line-height: 1.5;
}
QToolButton#protocolManagerCreateBtn {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #1177BB;
    border-radius: 3px;
    padding: 2px 16px;
    font-size: 12px;
}
QToolButton#protocolManagerCreateBtn:hover {
    background-color: #1177BB;
}
QToolButton#protocolManagerCreateBtn:pressed {
    background-color: #0A4A75;
}

#protocolManagerStatus {
    background-color: #1E1E1E;
    border-top: 1px solid #1E1E1E;
}
#protocolManagerStatusLabel {
    color: #969696;
    font-size: 11px;
}

/* ==================== TestProgramManagerWidget ==================== */
TestProgramManagerWidget {
    background-color: #252526;
}
TestProgramManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
TestProgramManagerWidget QTreeWidget::item {
    padding: 4px 8px;
    min-height: 22px;
}
TestProgramManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
TestProgramManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
#testProgramToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}

/* ==================== TestProgramEditorWidget ==================== */
TestProgramEditorWidget {
    background-color: #1E1E1E;
}
TestProgramEditorWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QLineEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QTextEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTableWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    gridline-color: #3C3C3C;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
TestProgramEditorWidget QTableWidget::item {
    padding: 4px 8px;
}
TestProgramEditorWidget QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: none;
    border-bottom: 1px solid #3C3C3C;
    padding: 4px 8px;
    font-weight: bold;
}
TestProgramEditorWidget QTabWidget::pane {
    border: 1px solid #3C3C3C;
    background-color: #252526;
}
#testProgramEditorToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#testProgramEditorAddCaseBtn, #testProgramEditorRemoveCaseBtn,
#testProgramEditorAddStepBtn, #testProgramEditorRemoveStepBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
#testProgramEditorAddCaseBtn:hover, #testProgramEditorRemoveCaseBtn:hover,
#testProgramEditorAddStepBtn:hover, #testProgramEditorRemoveStepBtn:hover {
    background-color: #505050;
}
#testProgramEditorAddCaseBtn:pressed, #testProgramEditorRemoveCaseBtn:pressed,
#testProgramEditorAddStepBtn:pressed, #testProgramEditorRemoveStepBtn:pressed {
    background-color: #2D2D2D;
}

/* ── Validation label ── */
#testProgramValidationLabel {
    color: #F48771;
    font-size: 11px;
    padding: 2px 8px;
    background-color: #3C2020;
    border-radius: 2px;
}

/* ── Step detail panel ── */
StepDetailPanel QLabel {
    color: #CCCCCC;
    font-size: 12px;
}
#stepDetailTitle {
    font-weight: bold;
}
#stepDetailEmptyLabel {
    color: #888;
}

StepDetailPanel QDoubleSpinBox,
StepDetailPanel QLineEdit,
StepDetailPanel QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
}

StepDetailPanel QDoubleSpinBox:focus,
StepDetailPanel QLineEdit:focus,
StepDetailPanel QComboBox:focus {
    border-color: #007ACC;
}

StepDetailPanel QComboBox::drop-down {
    border: none;
    width: 20px;
}

StepDetailPanel QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #CCCCCC;
    margin-right: 4px;
}

StepDetailPanel QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    selection-background-color: #094771;
}

StepDetailPanel QCheckBox {
    color: #CCCCCC;
    spacing: 6px;
}

StepDetailPanel QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3C3C3C;
}

StepDetailPanel QCheckBox::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

StepDetailPanel QTableWidget {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    gridline-color: #3C3C3C;
    selection-background-color: #094771;
}

/* ==================== SearchWidget ==================== */
etest--app--SearchWidget {
    background-color: #252526;
}
etest--app--SearchWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
etest--app--SearchWidget QLineEdit:focus {
    border-color: #007ACC;
}
etest--app--SearchWidget QToolButton {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    color: #CCCCCC;
    padding: 2px;
}
etest--app--SearchWidget QToolButton:hover {
    background-color: #505050;
    border-color: #007ACC;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn,
etest--app--SearchWidget QToolButton#searchWholeWordBtn,
etest--app--SearchWidget QToolButton#searchRegexModeBtn {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    color: #858585;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:hover,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:hover,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:hover {
    background-color: #505050;
    color: #CCCCCC;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:checked,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:checked,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:checked {
    background-color: #094771;
    border-color: #007ACC;
    color: #FFFFFF;
}
etest--app--SearchWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
etest--app--SearchWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
etest--app--SearchWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
etest--app--SearchWidget QTreeWidget::item:selected {
    background-color: #094771;
}
etest--app--SearchWidget QFrame#searchSeparator {
    background-color: #3C3C3C;
    max-height: 1px;
}
etest--app--SearchWidget QLabel {
    color: #858585;
    font-size: 12px;
    background-color: transparent;
}
etest--app--SearchWidget QLabel#fileSectionLabel,
etest--app--SearchWidget QLabel#contentSectionLabel {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
etest--app--SearchWidget QListWidget::item {
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget::item:hover {
    background-color: #2A2D2E;
}
etest--app--SearchWidget QListWidget::item:selected {
    background-color: #094771;
}

/* ==================== GitWidget ==================== */
GitWidget {
    background-color: #252526;
}
GitWidget QLabel {
    color: #CCCCCC;
    background-color: transparent;
}
GitWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
    font-size: 13px;
}
GitWidget QTextEdit:focus {
    border-color: #007ACC;
}
GitWidget QToolButton#refresh_button_ {
    background-color: transparent;
    border: none;
    padding: 0px;
}
GitWidget QToolButton#refresh_button_:hover {
    background-color: #505050;
    border-radius: 3px;
}
GitWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
GitWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
GitWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
GitWidget QTreeWidget::item:selected {
    background-color: #094771;
}
GitWidget QLabel#gitEmptyLabel {
    color: #858585;
    font-size: 13px;
}

/* ==================== etest--app--BottomContainerWidget ==================== */
etest--app--BottomContainerWidget {
    background-color: #1E1E1E;
}
etest--app--BottomContainerWidget QTabWidget {
    background-color: #1E1E1E;
}
etest--app--BottomContainerWidget QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}
etest--app--BottomContainerWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
etest--app--BottomContainerWidget QToolButton:hover {
    color: #FFFFFF;
}

/* Output 面板（QTextEdit） */
etest--app--BottomContainerWidget QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
}

/* 问题面板（QTableWidget） */
etest--app--BottomContainerWidget QTableWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    gridline-color: #3C3C3C;
}
etest--app--BottomContainerWidget QTableWidget::item {
    color: #CCCCCC;
}
etest--app--BottomContainerWidget QTableWidget::item:selected {
    background-color: #264F78;
    color: #FFFFFF;
}
etest--app--BottomContainerWidget QHeaderView::section {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 4px;
}

/* ==================== NewProjectDialog ==================== */
QLabel#previewLabel {
    color: gray;
}
QLabel#errorLabel {
    color: red;
}

/* ==================== EtlogViewerWidget ==================== */
etest--app--EtlogViewerWidget {
    background-color: #1E1E1E;
}
#etlogSummaryBar {
    background-color: #2D2D2D;
    border-bottom: 1px solid #3C3C3C;
}
#etlogTitleLabel {
    font-weight: bold;
    font-size: 14px;
}
#etlogFooterBar {
    background-color: #2D2D2D;
    border-top: 1px solid #3C3C3C;
}
#etlogFooterLabel {
    color: #888;
    font-size: 11px;
}
#etlogEmptyLabel {
    color: #858585;
    font-size: 16px;
}
#etlogDetailScroll {
    background-color: #1E1E1E;
}
#etlogDetailViewport {
    background-color: #1E1E1E;
}
#etlogDetailInner {
    background-color: #1E1E1E;
}
#etlogDetailStatus {
    font-size: 16px;
    font-weight: bold;
}

/* ==================== etest--app--TerminalPanel ==================== */
etest--app--TerminalPanel {
    background-color: #1E1E1E;
}
etest--app--TerminalPanel QPlainTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* ==================== ProtocolEditorWidget ==================== */
#protocolToolbar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}
#protocolToolbar QToolButton:checked {
    background-color: #094771;
    border: 1px solid #1A6BB5;
    border-radius: 3px;
}
#protocolTitleLabel {
    font-weight: bold;
    color: #cccccc;
    padding-right: 12px;
}
#frameNameLabel {
    color: #4ec9b0;
    padding-right: 16px;
}
#idLabel {
    color: #888888;
    padding-left: 12px;
}
#lengthLabel {
    color: #888888;
    padding-right: 8px;
}
#protocolStatusBar {
    background-color: #007acc;
    color: white;
    font-size: 12px;
}

/* ==================== TopologyManagerWidget ==================== */
QToolButton#topologyNewBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
QToolButton#topologyNewBtn:hover {
    background-color: #505050;
}
QToolButton#topologyNewBtn:pressed {
    background-color: #2D2D2D;
}

/* ==================== IcdFramePreviewPanel ==================== */
QToolButton#icdFramePreviewDecodeBtn {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 4px 12px;
    font-size: 12px;
}
QToolButton#icdFramePreviewDecodeBtn:hover {
    background-color: #1177BB;
}
QToolButton#icdFramePreviewDecodeBtn:pressed {
    background-color: #0D5A8F;
}
QToolButton#icdFramePreviewDecodeBtn:disabled {
    background-color: #3C3C3C;
    color: #5A5A5A;
    border-color: #3C3C3C;
}

/* ==================== TopologyEditorWidget ==================== */
etest--topology--TopologyEditorWidget {
    background-color: #1E1E1E;
}
QToolBar#topologyToolbar {
    background-color: #2D2D2D;
    border-bottom: 1px solid #252526;
    spacing: 2px;
    padding: 2px;
}
QToolBar#topologyToolbar QToolButton:checked {
    background-color: #094771;
    border: 1px solid #1A6BB5;
    border-radius: 3px;
}
QLabel#topologyZoomLabel {
    padding: 0 4px;
    color: #CCCCCC;
}
QWidget#PhLoadingOverlay {
    background-color: #1E1E1E;
}
QLabel#PhLoadingOverlayLabel {
    font-size: 13px;
    color: #888888;
    background: transparent;
}

/* ==================== PropertyPanelWidget ==================== */
QWidget#topologyPropertyPanel {
    background-color: #252526;
}
QStackedWidget#topologyPropertyStack {
    background-color: #252526;
}
#emptyPage, #uutPage, #portPage, #devicePage, #connectionPage, #devicePortPage, #monitorPage {
    background-color: #252526;
}
#emptyPage QLabel {
    color: #888888;
}

/* ==================== GitWidget ==================== */
GitWidget QLabel#gitTitleLabel {
    color: #BBBBBB;
    font-weight: bold;
    font-size: 11px;
    background: transparent;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: #252526;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
}

/* ==================== 欢迎页 ==================== */
QWidget#WelcomeWidget {
    background-color: #1E1E1E;
}

/* --- Action Tiles (新建/打开项目, 1x1) --- */
QLabel#WelcomeActionIcon {
    color: #0E639C;
    font-size: 28px;
}
QLabel#WelcomeActionText {
    color: #CCCCCC;
    font-size: 14px;
    font-weight: bold;
}

/* --- Eye Widget Tile (4x1) --- */
QWidget#WelcomeEyeContent {
    background: transparent;
}
QWidget#WelcomeEyeTopBar {
    background: transparent;
}
QLabel#WelcomeEyeLogoLabel {
    color: #CCCCCC;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#WelcomeEyeVersionLabel {
    color: #888888;
    font-size: 11px;
    background: transparent;
}
QLabel#WelcomeEyeIconLabel {
    background: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* --- Recent Project Tiles (1x1) --- */
QWidget#WelcomeProjectCardContent {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}
QWidget#WelcomeProjectCardContent:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QLabel#WelcomeRecentCardName {
    color: #E0E0E0;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeRecentCardPath {
    color: #aaaaaa;
    font-size: 11px;
}
QLabel#WelcomeRecentCardTime {
    color: #666666;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #CCCCCC;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
QLabel#gridTileName {
    color: #999999;
    font-size: 11px;
}

/* --- Daily Tip Tile --- */
QLabel#WelcomeTipTitle {
    color: #cccccc;
    font-size: 14px;
    font-weight: bold;
}
QLabel#WelcomeTipContent {
    color: #aaaaaa;
    font-size: 12px;
}

/* ==================== etest--app--SettingsDialog ==================== */
etest--app--SettingsDialog {
    background-color: #252526;
}

/* 左侧分类列表 */
etest--app--SettingsDialog QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border-right: 1px solid #1E1E1E;
    font-size: 13px;
    outline: none;
}
etest--app--SettingsDialog QListWidget::item {
    padding: 8px 12px;
    border: none;
}
etest--app--SettingsDialog QListWidget::item:hover {
    background-color: #2A2D2E;
}
etest--app--SettingsDialog QListWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}

/* 右侧页面容器 */
etest--app--SettingsDialog QStackedWidget {
    background-color: #1E1E1E;
}
etest--app--SettingsDialog QStackedWidget > QWidget {
    background-color: #1E1E1E;
}

/* 外观页内嵌滚动区 */
etest--app--SettingsDialog QScrollArea {
    background-color: #1E1E1E;
    border: none;
}
etest--app--SettingsDialog QScrollArea > QWidget {
    background-color: #1E1E1E;
}
etest--app--SettingsDialog QScrollArea > QWidget > QWidget {
    background-color: #1E1E1E;
}

/* 卡片容器 */
QWidget#SettingsCard {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
}
QLabel#SettingsCardTitle {
    color: #CCCCCC;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0 8px;
    background-color: transparent;
}

/* VS Code 风格设置行 */
QWidget#SettingsRow {
    border-bottom: 1px solid #2D2D2D;
    background-color: transparent;
}
QLabel#SettingsRowTitle {
    color: #CCCCCC;
    font-size: 13px;
    background-color: transparent;
}
QLabel#SettingsRowDesc {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
}
QLabel#SettingsHint {
    color: #888888;
    font-size: 11px;
    padding: 4px 0;
    background-color: transparent;
}

/* 设置页通用标签 */
etest--app--SettingsDialog QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* 底部按钮栏 */
QWidget#SettingsButtonBar {
    border-top: 1px solid #1E1E1E;
    background-color: #252526;
}

/* 设置页中的数值控件 */
etest--app--SettingsDialog QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QSpinBox:focus {
    border-color: #007ACC;
}
etest--app--SettingsDialog QSpinBox::up-button,
etest--app--SettingsDialog QSpinBox::down-button {
    background-color: #3C3C3C;
    border: none;
    width: 16px;
}
etest--app--SettingsDialog QSpinBox::up-arrow,
etest--app--SettingsDialog QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* 设置页中的下拉框 */
etest--app--SettingsDialog QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QComboBox:hover {
    border-color: #007ACC;
}
etest--app--SettingsDialog QComboBox::drop-down {
    background-color: #3C3C3C;
    border: none;
    width: 20px;
}
etest--app--SettingsDialog QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/resources/icons/svg/drop_down_arrow_light.svg);
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
    border: 1px solid #454545;
}

/* 设置页中的文本框 */
etest--app--SettingsDialog QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QLineEdit:focus {
    border-color: #007ACC;
}

/* 设置页中的复选框 */
etest--app--SettingsDialog QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
    background-color: transparent;
}
etest--app--SettingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* 设置页中的按钮 — 已由全局 QPushButton 统一样式覆盖 */

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #252526;
    border: 1px solid #3C3C3C;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1A8FE3, stop: 1 #0A5CA8);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #CCCCCC;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #3C3C3C;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #888888;
    font-size: 11px;
    background: transparent;
}
QToolButton#aboutOkButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
QToolButton#aboutOkButton:hover {
    background-color: #1177BB;
}
QToolButton#aboutOkButton:pressed {
    background-color: #0D5A8F;
}
#aboutCopyright {
    color: #666666;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #555555;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: #252526;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1565C0, stop:1 #4527A0);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#loginUsername, #loginPassword {
  background: #3c3c3c;
  border: 1px solid #555;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #CCCCCC;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #4FC3F7;
  background: #3c3c3c;
}
QToolButton#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #1565C0, stop:1 #42A5F5);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1E88E5);
}
QToolButton#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #0D47A1, stop:1 #1565C0);
}
#loginHint {
  color: #ef5350;
  font-size: 12px;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#loginCloseBtn:hover {
  color: #eee;
}
#loginRemember {
  font-size: 12px;
  color: #aaa;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: #252526;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #CCCCCC;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
QToolButton#userMgrAddBtn {
  background: #0D47A1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
QToolButton#userMgrAddBtn:hover {
  background: #1565C0;
}
#userMgrTable {
  border: 1px solid #3c3c3c;
  border-radius: 8px;
  gridline-color: #333;
  color: #CCCCCC;
  background: #1e1e1e;
}
#userMgrTable::item {
  padding: 6px 12px;
}
QToolButton#userMgrEditBtn {
  background: transparent;
  color: #4FC3F7;
  border: none;
  font-size: 12px;
}
QToolButton#userMgrDeleteBtn {
  background: transparent;
  color: #ef5350;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #666;
}
#userMgrErrorHint {
  font-size: 12px;
  color: #ef5350;
}
QToolButton#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #888;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#userMgrCloseBtn:hover {
  color: #eee;
}

/* ==================== HintBar ==================== */
QWidget#HintBar {
    background-color: #252526;
    border-bottom: 1px solid #3C3C3C;
}
QWidget#HintItem {
    background-color: #3D3200;
    border-bottom: 1px solid #665500;
}
QLabel#HintIndicator {
    color: #569CD6;
    font-size: 10px;
}
QLabel#HintText {
    color: #CCCCCC;
    font-size: 12px;
}
QToolButton#HintActionBtn {
    background-color: #2D2D2D;
    color: #75BEFF;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    font-size: 11px;
    padding: 0 8px;
}
QToolButton#HintActionBtn:hover {
    background-color: #383838;
    border-color: #569CD6;
}
QToolButton#HintCloseBtn {
    background: transparent;
    border: none;
    color: #666;
    font-size: 12px;
}
QToolButton#HintCloseBtn:hover {
    color: #FFFFFF;
}

/* ==================== ProjectStructureWidget Placeholder ==================== */
QWidget#PhPlaceholder {
    background-color: #252526;
}
QScrollArea#PhScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea#PhScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QWidget#PhScrollContent {
    background-color: transparent;
}

/* Section headers (项目管理/最近项目) */
QLabel#PhSectionLabel {
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
    background: transparent;
}

/* Project action buttons (新建项目/打开项目) */
QToolButton#PhProjectBtn {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhProjectBtn:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QToolButton#PhProjectBtn:pressed {
    background-color: #094771;
}

QLabel#PhTitle {
    font-size: 14px;
    font-weight: 600;
    color: #888888;
}
QLabel#PhDesc {
    font-size: 12px;
    color: #AAAAAA;
}
QFrame#PhSeparator {
    color: #3C3C3C;
    max-height: 1px;
}

/* Placeholder page round-corner cards */
QFrame#PhCard {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
}
QFrame#PhCard:hover {
    border-color: #007ACC;
}
QToolButton#PhQuickBtn {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhQuickBtn:hover {
    background-color: #383838;
    border-color: #007ACC;
}
QToolButton#PhQuickBtn:pressed {
    background-color: #094771;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #3C3C3C;
}
QDockWidget > QWidget {
    background: #252526;
}

/* IcdPropertyPanel 内容区 */
QScrollArea#icdPropertyScroll {
    background-color: #252526;
    border: none;
}
QScrollArea#icdPropertyScroll > QWidget > QWidget {
    background-color: #252526;
}
QWidget#icdPropertyForm {
    background-color: #252526;
}
etest--ui--DockTitleBar {
    background: #2D2D2D;
    border-bottom: 1px solid #3C3C3C;
}
QLabel#dockTitleBarLabel {
    color: #CCCCCC;
    font-size: 12px;
    background: transparent;
}
QToolButton#dockFloatButton, QToolButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QToolButton#dockFloatButton:hover, QToolButton#dockCloseButton:hover {
    background: rgba(255, 255, 255, 0.1);
}
QToolButton#dockFloatButton:pressed, QToolButton#dockCloseButton:pressed {
    background: rgba(255, 255, 255, 0.18);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    padding: 4px 8px;
}QToolButton#PhOpenFilesHeaderBtn:hover {
    color: #CCCCCC;
}

/* ==================== TuxSaverOverlay ==================== */
QToolButton#saverCloseBtn {
    color: rgba(255,255,255,160);
    background: rgba(255,255,255,25);
    border: 1px solid rgba(255,255,255,40);
    border-style: solid;
    font-size: 16px;
    border-radius: 16px;
    padding: 0px;
    margin: 0px;
}
QToolButton#saverCloseBtn:hover {
    background: rgba(255,80,80,160);
    color: white;
    border-color: rgba(255,80,80,230);
    border-width: 1.5px;
    border-style: solid;
}
QToolButton#saverCloseBtn:pressed {
    background: rgba(200,50,50,180);
    color: white;
    border-color: rgba(200,50,50,220);
    border-style: solid;
}

/* ==================== Tab Close Button (Dark) ==================== */
#bottomTabWidget QTabBar::close-button {
    image: url(:/resources/icons/svg/close_light.svg);
    subcontrol-position: right;
    width: 20px;
    height: 20px;
}
#bottomTabWidget QTabBar::close-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

/* ==================== Signal Visualizers (Dark) ==================== */

/* WaveformWidget */
#WaveformTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
    color: #CCCCCC;
}
#WaveformPlot {
    border: 1px solid #3C3C3C;
    border-radius: 2px;
}

/* StateLEDWidget */
#LEDTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#LEDDot {
    min-width: 20px; max-width: 20px;
    min-height: 20px; max-height: 20px;
    border-radius: 10px;
}
#LEDDot[ledState="on"] {
    background-color: #00cc66;
}
#LEDDot[ledState="off"] {
    background-color: #cc3333;
}
#LEDStateText {
    font-size: 14px;
    font-weight: bold;
}
#LEDPulse {
    font-size: 11px;
    color: #808080;
}
#LEDTs {
    font-size: 10px;
    color: #808080;
}

/* DigitalMeterWidget */
#MeterTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#MeterValue {
    font-size: 28px;
    font-weight: bold;
    color: #E0E0E0;
}
#MeterTrend {
    font-size: 18px;
}
#MeterRange {
    font-size: 11px;
    color: #808080;
}
#MeterRaw {
    font-size: 11px;
    color: #808080;
}
#MeterTs {
    font-size: 10px;
    color: #808080;
}

/* ValueLabelWidget */
#ValueLabelTitle {
    font-size: 12px;
    font-weight: bold;
    color: #CCCCCC;
}
#ValueLabelValue {
    font-size: 22px;
    font-weight: bold;
    color: #E0E0E0;
}
#ValueLabelRaw {
    font-size: 11px;
    color: #808080;
}
#ValueLabelTs {
    font-size: 10px;
    color: #808080;
}

/* SignalTreePanel */
#SignalTreeSearch {
    padding: 4px;
    margin: 2px 4px;
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #505050;
    border-radius: 3px;
}
#SignalTree {
    background: transparent;
}

/* VisualizationArea */
#VisualizationArea {
    background: #252526;
    border: none;
}

/* RunStatusPanel */
#RunStatusTree {
    background: transparent;
}
#RunStatusStats {
    padding: 4px;
    font-size: 11px;
    color: #CCCCCC;
}

/* ExecutionDashboard splitter */
#ExecDashboardSplitter::handle {
    width: 2px;
    background: #3C3C3C;
}

/* Ribbon running mode indicator */
#RunningMode {
    border-bottom: 3px solid #ff8800;
}
