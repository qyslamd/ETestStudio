/* VSCode Dark Theme for ETest Demo */

/* 全局背景色和前景色 */
QMainWindow {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 菜单栏 */
QMenuBar {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border-bottom: 1px solid #252526;
    padding: 2px;
}
QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #094771;
}
QMenu {
    min-width: 200px;
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
}
QMenu::item {
    padding: 6px 28px 6px 20px;
}
QMenu::item:selected {
    background-color: #094771;
}
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 10px;
}

/* 工具栏 */
QToolBar {
    background-color: #2D2D2D;
    border: none;
    padding: 2px 4px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background-color: #454545;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    color: #CCCCCC;
    padding: 4px;
    margin: 1px;
}
QToolButton:hover {
    background-color: #505050;
}
QToolButton:pressed {
    background-color: #3C3C3C;
}
QToolButton:disabled {
    color: #5A5A5A;
}

/* 状态栏 */
QStatusBar {
    background-color: #007ACC;
    color: #FFFFFF;
    font-size: 12px;
    border-top: 1px solid #006BAB;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #FFFFFF;
    padding: 0px 8px;
}
QStatusBar QLabel:hover {
    background-color: rgba(255, 255, 255, 30);
}

/* ==================== QADS Dock 样式（暗色覆盖）已迁移至 ads_dark.qss ==================== */
/* QADS的样式必须设置到CDockManager自身，否则会被QADS内置的default.css覆盖 */

/* 滚动条 */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4F4F4F;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4F4F4F;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 分割器 */
QSplitter::handle {
    background-color: #252526;
}
QSplitter::handle:hover {
    background-color: #007ACC;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}
QTabBar::tab {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 6px 12px;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
}
QTabBar::tab:hover:!selected {
    color: #FFFFFF;
}

/* 文本编辑区 */
QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* 表格 */
QTableWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    gridline-color: #333333;
    selection-background-color: #094771;
}
QTableWidget::item {
    padding: 4px;
}
QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    font-weight: bold;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

/* 树形视图 */
QTreeView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QTreeView::item {
    padding: 2px 4px 2px 0px;
    border: none;
}
QTreeView::item:hover {
    background-color: #2A2D2E;
}
QTreeView::item:selected {
    background-color: #094771;
}
QTreeView::branch {
    background-color: #252526;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}
QTreeView QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #007ACC;
    padding: 0px 2px;
    margin: 0px;
    selection-background-color: #264F78;
}

/* 硬件树 */
QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeWidget::item {
    padding: 3px 0px;
    border: none;
}
QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
QTreeWidget::item:selected {
    background-color: #094771;
}
QTreeWidget::branch {
    background-color: #252526;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}

/* 按钮 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #1177BB;
}
QPushButton:pressed {
    background-color: #0D5A8F;
}
QPushButton:disabled {
    background-color: #3C3C3C;
    color: #5A5A5A;
    border-color: #3C3C3C;
}

/* 输入框 */
QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
QLineEdit:focus {
    border-color: #007ACC;
}

/* 对话框 */
QDialog {
    background-color: #252526;
    color: #CCCCCC;
}

/* Label */
QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* ComboBox */
QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #007ACC;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
}

/* SpinBox */
QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QSpinBox:focus {
    border-color: #007ACC;
}

/* CheckBox */
QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* RadioButton */
QRadioButton {
    color: #CCCCCC;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 7px;
    background-color: #3C3C3C;
}
QRadioButton::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

/* GroupBox */
QGroupBox {
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
}

/* ToolTip */
QToolTip {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    padding: 4px 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #3C3C3C;
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 2px;
}

/* ListBox / ListWidget */
QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
}
QListWidget::item:hover {
    background-color: #2A2D2E;
}
QListWidget::item:selected {
    background-color: #094771;
}

/* ScrollArea */
QScrollArea {
    background-color: #1E1E1E;
    border: none;
}

/* ==================== ActivityBarWidget ==================== */
ActivityBarWidget {
    background-color: #333333;
    border-right: 1px solid #252526;
}
ActivityBarWidget QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #858585;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
ActivityBarWidget QPushButton:hover {
    background-color: #2A2D2E;
    color: #FFFFFF;
}
ActivityBarWidget QPushButton:checked {
    border-left: 2px solid #007ACC;
    color: #FFFFFF;
    background-color: #2A2D2E;
}

/* ==================== SidebarWidget ==================== */
SidebarWidget {
    background-color: #252526;
    border-right: 1px solid #1E1E1E;
}
SidebarWidget QLabel {
    color: #BBBBBB;
    font-size: 11px;
    font-weight: bold;
}
SidebarWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
SidebarWidget QToolButton:hover {
    color: #FFFFFF;
}

/* ==================== SearchWidget ==================== */
SearchWidget {
    background-color: #252526;
}
SearchWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
SearchWidget QLineEdit:focus {
    border-color: #007ACC;
}
SearchWidget QPushButton {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    color: #CCCCCC;
    padding: 2px;
}
SearchWidget QPushButton:hover {
    background-color: #505050;
    border-color: #007ACC;
}
SearchWidget QCheckBox {
    color: #858585;
    spacing: 2px;
    background-color: transparent;
}
SearchWidget QCheckBox::indicator {
    width: 14px;
    height: 14px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
SearchWidget QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
SearchWidget QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
SearchWidget QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
SearchWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
SearchWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
SearchWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
SearchWidget QTreeWidget::item:selected {
    background-color: #094771;
}
SearchWidget QLabel {
    color: #858585;
    font-size: 12px;
    background-color: transparent;
}

/* ==================== GitWidget ==================== */
GitWidget {
    background-color: #252526;
}
GitWidget QLabel {
    color: #CCCCCC;
    background-color: transparent;
}
GitWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
    font-size: 13px;
}
GitWidget QTextEdit:focus {
    border-color: #007ACC;
}
GitWidget QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 2px 6px;
}
GitWidget QPushButton:hover {
    background-color: #1177BB;
}
GitWidget QPushButton:pressed {
    background-color: #0D5A8F;
}
GitWidget QPushButton#refresh_button_ {
    background-color: transparent;
    border: none;
    padding: 0px;
}
GitWidget QPushButton#refresh_button_:hover {
    background-color: #505050;
    border-radius: 3px;
}
GitWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
GitWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
GitWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
GitWidget QTreeWidget::item:selected {
    background-color: #094771;
}
GitWidget QLabel#gitEmptyLabel {
    color: #858585;
    font-size: 13px;
}

/* ==================== PanelContainerWidget ==================== */
PanelContainerWidget {
    background-color: #1E1E1E;
}
PanelContainerWidget QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}
PanelContainerWidget QTabBar::tab {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 4px 12px;
    margin-right: 1px;
}
PanelContainerWidget QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border-bottom: 1px solid #007ACC;
}
PanelContainerWidget QTabBar::tab:hover:!selected {
    color: #FFFFFF;
}
PanelContainerWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
PanelContainerWidget QToolButton:hover {
    color: #FFFFFF;
}

/* ==================== NewProjectDialog ==================== */
QLabel#previewLabel {
    color: gray;
}
QLabel#errorLabel {
    color: red;
}

/* ==================== TerminalPanel ==================== */
TerminalPanel QPlainTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* ==================== ProtocalEditorWidget ==================== */
#protocalToolbar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}
#protocalTitleLabel {
    font-weight: bold;
    color: #cccccc;
    padding-right: 12px;
}
#frameNameLabel {
    color: #4ec9b0;
    padding-right: 16px;
}
#idLabel {
    color: #888888;
    padding-left: 12px;
}
#lengthLabel {
    color: #888888;
    padding-right: 8px;
}
#protocalStatusBar {
    background-color: #007acc;
    color: white;
    font-size: 12px;
}

/* ==================== TopologyEditorWidget ==================== */
#topologyToolbar {
    background-color: #2D2D2D;
    border-bottom: 1px solid #252526;
}
#topologyStatusBar {
    background-color: #252526;
    border-top: 1px solid #3C3C3C;
}

/* ==================== PropertyPanelWidget ==================== */
#emptyPage, #uutPage, #portPage, #devicePage, #connectionPage, #devicePortPage {
    background-color: #3C3C3C;
}
#emptyPage QLabel {
    color: #888888;
}

/* ==================== GitWidget ==================== */
GitWidget QLabel#gitTitleLabel {
    color: #BBBBBB;
    font-weight: bold;
    font-size: 11px;
    background: transparent;
}

/* ==================== ProtocalEditor Section Header (IcdNodeTreeWidget / IcdPropertyPanel) ==================== */
ProtocalEditorWidget #sectionHeader {
    font-weight: bold;
    padding: 4px 8px;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: white;
    border: 1px solid #ccc;
    border-radius: 8px;
}

/* ==================== 欢迎页 ==================== */
QWidget#WelcomeWidget {
    background-color: #1E1E1E;
}
QWidget#WelcomeCenter {
    background-color: #1E1E1E;
}
QLabel#WelcomeLogo {
    color: #CCCCCC;
    font-size: 28px;
    font-weight: bold;
}
QLabel#WelcomeVersion {
    color: #888888;
    font-size: 13px;
}
QLabel#WelcomeSectionHeader {
    color: #BBBBBB;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#WelcomeActionButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 20px;
    font-size: 13px;
}
QPushButton#WelcomeActionButton:hover {
    background-color: #1177BB;
}
QPushButton#WelcomeActionButton:pressed {
    background-color: #0D5A8F;
}
QListWidget#WelcomeRecentList {
    background-color: #252526;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    color: #CCCCCC;
    font-size: 13px;
    outline: none;
}
QListWidget#WelcomeRecentList::item {
    padding: 6px 10px;
    border-bottom: 1px solid #2D2D2D;
}
QListWidget#WelcomeRecentList::item:hover {
    background-color: #2A2D2E;
}
QListWidget#WelcomeRecentList::item:selected {
    background-color: #094771;
}
QLabel#WelcomeShortcutKey {
    color: #888888;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QLabel#WelcomeShortcutDesc {
    color: #CCCCCC;
    font-size: 12px;
}

/* ==================== SettingsDialog ==================== */
SettingsWidget {
    background-color: #252526;
}

/* 左侧分类树 */
SettingsWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border-right: 1px solid #1E1E1E;
    font-size: 13px;
    outline: none;
}
SettingsWidget QTreeWidget::item {
    padding: 6px 12px;
    border: none;
    color: #CCCCCC;
}
SettingsWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
SettingsWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}

/* 右侧滚动区 + 内部 QStackedWidget + 页面 */
SettingsWidget QScrollArea {
    background-color: #1E1E1E;
    border: none;
}
SettingsWidget QScrollArea QWidget {
    background-color: #1E1E1E;
}
SettingsWidget QStackedWidget {
    background-color: #1E1E1E;
}

/* 分组标题 */
QLabel#SettingsSectionHeader {
    color: #CCCCCC;
    font-weight: bold;
    font-size: 13px;
    padding-top: 8px;
    padding-bottom: 4px;
    background-color: transparent;
}

/* 设置页中的表单标签 */
SettingsWidget QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* 设置页中的数值控件 */
SettingsWidget QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
SettingsWidget QSpinBox:focus {
    border-color: #007ACC;
}
SettingsWidget QSpinBox::up-button,
SettingsWidget QSpinBox::down-button {
    background-color: #3C3C3C;
    border: none;
    width: 16px;
}
SettingsWidget QSpinBox::up-arrow,
SettingsWidget QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* 设置页中的下拉框 */
SettingsWidget QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
SettingsWidget QComboBox:hover {
    border-color: #007ACC;
}
SettingsWidget QComboBox::drop-down {
    background-color: #3C3C3C;
    border: none;
    width: 20px;
}
SettingsWidget QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
    border: 1px solid #454545;
}

/* 设置页中的复选框 */
SettingsWidget QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
    background-color: transparent;
}
SettingsWidget QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
SettingsWidget QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
SettingsWidget QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
SettingsWidget QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
SettingsWidget QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
SettingsWidget QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
SettingsWidget QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* 设置页中的按钮 */
SettingsWidget QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
SettingsWidget QPushButton:hover {
    background-color: #1177BB;
}
SettingsWidget QPushButton:pressed {
    background-color: #0D5A8F;
}