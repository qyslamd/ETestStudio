/* VSCode Dark Theme for ETest Demo */

/* 全局背景色和前景色 */
QMainWindow {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 菜单栏 */
QMenuBar {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border-bottom: 1px solid #252526;
    padding: 2px;
}
QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #094771;
}
QMenu {
    min-width: 200px;
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
}
QMenu::item {
    padding: 6px 28px 6px 20px;
}
QMenu::item:selected {
    background-color: #094771;
}
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 10px;
}

/* 工具栏 */
QToolBar {
    background-color: #2D2D2D;
    border: none;
    padding: 2px 4px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background-color: #454545;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    color: #CCCCCC;
    padding: 4px;
    margin: 1px;
}
QToolButton:hover {
    background-color: #505050;
}
QToolButton:pressed {
    background-color: #3C3C3C;
}
QToolButton:disabled {
    color: #5A5A5A;
}

/* 状态栏 */
QStatusBar {
    background-color: #007ACC;
    color: #FFFFFF;
    font-size: 12px;
    border-top: 1px solid #006BAB;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #FFFFFF;
    padding: 0px 8px;
}
QStatusBar QLabel:hover {
    background-color: rgba(255, 255, 255, 30);
}

/* ==================== QADS Dock 样式已迁移至 ads_vscode.qss ==================== */
/* QADS的样式必须设置到CDockManager自身，否则会被QADS内置的default.css覆盖 */

/* 滚动条 */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4F4F4F;
}
QScrollBar::handle:vertical:pressed {
    background-color: #3F3F3F;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #4F4F4F;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #3F3F3F;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== QSplitter ==================== */
QSplitter {
  border: none;
  background-color: transparent;
}

QSplitter::handle {
  background-color: transparent;
  border: none;
  image: none;
}
QSplitter::handle:pressed {
    background-color: #0055aa; 
}
QSplitter::handle:hover {
    background-color: #0055aa; 
}

QSplitter::handle:horizontal {
    background-color: transparent;
    border: none;
    image: none;
    width: 6px;
}
QSplitter::handle:horizontal:hover {
    background-color: #0055aa;
}
QSplitter::handle:horizontal:pressed {
    background-color: #0055aa; 
}

QSplitter::handle:vertical {
    background-color: transparent;
    border: none;
    image: none;
    height: 6px;
}
QSplitter::handle:vertical:hover {
    background-color: #0055aa;
}
QSplitter::handle:vertical:pressed {
    background-color: #0055aa; 
}

/* Tab Widget — 由 TabBarStyle 全权自绘，不使用 QSS */
QTabWidget::pane {
    border: none;
    background-color: #1E1E1E;
}

/* 文本编辑区 */
QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}

/* 表格 */
QTableWidget, QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #252526;
    color: #CCCCCC;
    border: none;
    gridline-color: #333333;
    selection-background-color: #094771;
}
QTableWidget::item, QTableView::item {
    padding: 4px;
}
QHeaderView {
    background-color: #1E1E1E;
}
QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    font-weight: bold;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}
QTableCornerButton::section {
    background-color: #2D2D2D;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
}
QTableCornerButton::section:hover {
    background-color: #3C3C3C;
}

/* 树形视图 */
QTreeView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QTreeView::item {
    padding: 2px 4px 2px 0px;
    border: none;
}
QTreeView::item:hover {
    background-color: #2A2D2E;
}
QTreeView::item:selected {
    background-color: #094771;
}
QTreeView::branch {
    background-color: #252526;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}
QTreeView QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #007ACC;
    padding: 0px 2px;
    margin: 0px;
    selection-background-color: #264F78;
}

/* 列表视图（最近文件等） */
QListView {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QListView::item {
    padding: 5px 8px;
    border: none;
    border-radius: 6px;
}
QListView::item:hover {
    background-color: #383838;
}
QListView::item:selected {
    background-color: rgba(0, 122, 204, 0.25);
}
/* Welcome 启动页最近项目列表：透明背景融入 Mica 卡片（覆盖全局 QListView 底色） */
QListView#WelcomeRecentList {
    background-color: transparent;
    border: none;
}

/* 硬件树 */
QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeWidget::item {
    padding: 3px 0px;
    border: none;
}
QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
QTreeWidget::item:selected {
    background-color: #094771;
}
QTreeWidget::branch {
    background-color: #252526;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}

/* 按钮 */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
    border-radius: 2px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #1177BB;
}
QPushButton:pressed {
    background-color: #0D5A8F;
}
QPushButton:disabled {
    background-color: #3C3C3C;
    color: #5A5A5A;
    border-color: #3C3C3C;
}

/* 输入框 */
QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
QLineEdit:focus {
    border-color: #007ACC;
}

/* 对话框 */
QDialog {
    background-color: #252526;
    color: #CCCCCC;
}

/* Label */
QLabel {
    color: #CCCCCC;
    background-color: transparent;
}

/* ComboBox */
QComboBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #007ACC;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/resources/icons/svg/drop_down_arrow_light.svg);
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #CCCCCC;
    selection-background-color: #094771;
}

/* SpinBox */
QSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
}
QSpinBox:focus {
    border-color: #007ACC;
}

/* DoubleSpinBox */
QDoubleSpinBox {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}
QDoubleSpinBox:hover {
    border-color: #007ACC;
}
QDoubleSpinBox:focus {
    border-color: #007ACC;
}
QDoubleSpinBox:disabled {
    background-color: #2D2D2D;
    color: #5A5A5A;
    border-color: #2D2D2D;
}
/* CheckBox */
QCheckBox {
    color: #CCCCCC;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* RadioButton */
QRadioButton {
    color: #CCCCCC;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 7px;
    background-color: #3C3C3C;
}
QRadioButton::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

/* QGroupBox 样式由 gen_themes.py 注入（删除此处原有块，避免 subcontrol-origin:margin 泄漏） */

/* ToolTip */
QToolTip {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    padding: 4px 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #3C3C3C;
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 2px;
}

/* ListBox / ListWidget */
QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    selection-background-color: #094771;
}
QListWidget::item:hover {
    background-color: #2A2D2E;
}
QListWidget::item:selected {
    background-color: #094771;
}

/* ScrollArea */
QScrollArea {
    background-color: #1E1E1E;
    border: none;
}

/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarNavBar {
    background-color: #333333;
    border-right: 1px solid #252526;
}
QWidget#sidebarNavBar QToolButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #858585;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarNavBar QToolButton:hover {
    background-color: #2A2D2E;
    color: #FFFFFF;
}
QWidget#sidebarNavBar QToolButton:checked {
    border-left: 2px solid #007ACC;
    color: #FFFFFF;
    background-color: #2A2D2E;
}

/* ==================== SidebarContentWidget ==================== */
etest--app--SidebarContentWidget {
    background-color: #252526;
    border-radius:8px;
    border:1px solid #454545;
}
etest--app--SidebarContentWidget QLabel {
    color: #BBBBBB;
    font-size: 11px;
    font-weight: bold;
}
etest--app--SidebarContentWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
etest--app--SidebarContentWidget QToolButton:hover {
    color: #FFFFFF;
}
#sidebarTitleBar {
    background-color: #252526;
    border:none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* ==================== EditorArea ==================== */
#EditorArea{
    background-color:#252526;
    border-radius:8px;
    border:1px solid #454545;
}

/* ==================== etest--app--BottomContainerWidget ==================== */
etest--app--BottomContainerWidget {
    background-color:#252526;
    border-radius:8px;
    border:1px solid #454545;
}
etest--app--BottomContainerWidget QTabWidget {
    background-color: #1E1E1E;
    border:none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
etest--app--BottomContainerWidget QTabWidget::pane {
    background-color: #1E1E1E;
    border:none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
etest--app--BottomContainerWidget QTabWidget::tab-bar {
    background-color: #1E1E1E;
    border:none;
}
etest--app--BottomContainerWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
etest--app--BottomContainerWidget QToolButton:hover {
    color: #FFFFFF;
}

/* Output 面板（QTextEdit） */
etest--app--BottomContainerWidget QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* 问题面板（QTableWidget） */
etest--app--BottomContainerWidget QTableWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    gridline-color: #3C3C3C;
}
etest--app--BottomContainerWidget QTableWidget::item {
    color: #CCCCCC;
}
etest--app--BottomContainerWidget QTableWidget::item:selected {
    background-color: #264F78;
    color: #FFFFFF;
}
etest--app--BottomContainerWidget QHeaderView::section {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 4px;
}

etest--app--BottomContainerWidget QTabBar::close-button {
    image: url(:/resources/icons/svg/close_light.svg);
    subcontrol-position: right;
    width: 14px;
    height: 14px;
}
etest--app--BottomContainerWidget QTabBar::close-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

/* ==================== ProtocolManagerWidget (ICDConfig 视图) ==================== */
ProtocolManagerWidget {
    background-color: #252526;
}
ProtocolManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    alternate-background-color: #252526;
}
ProtocolManagerWidget QTreeWidget::item {
    padding: 3px 6px;
    min-height: 20px;
    border: 0;
}
ProtocolManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
ProtocolManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
/* 帧条目禁用态：灰色 + 删除线（在代码中通过 font strikeOut + foreground 实现） */
ProtocolManagerWidget QTreeWidget::indicator {
    width: 13px;
    height: 13px;
}
ProtocolManagerWidget QHeaderView {
    background-color: #1E1E1E;
    border: none;
    border-bottom: 1px solid #1E1E1E;
}
ProtocolManagerWidget QHeaderView::section {
    background-color: #252526;
    color: #969696;
    padding: 4px 8px;
    border: 0;
    border-right: 1px solid #1E1E1E;
    font-weight: 600;
    font-size: 11px;
}
ProtocolManagerWidget QHeaderView::section:last {
    border-right: 0;
}

#protocolManagerTitle {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#protocolManagerConfigLabel {
    color: #CCCCCC;
    font-size: 12px;
    font-weight: 600;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn {
    background-color: transparent;
    border: none;
    padding: 0px;
    border-radius: 3px;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:hover {
    background-color: #505050;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:pressed {
    background-color: #094771;
}

#protocolManagerToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}

#protocolManagerEmpty {
    background-color: #252526;
}
#protocolManagerEmptyText {
    color: #969696;
    font-size: 12px;
    line-height: 1.5;
}
QToolButton#protocolManagerCreateBtn {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #1177BB;
    border-radius: 3px;
    padding: 2px 16px;
    font-size: 12px;
}
QToolButton#protocolManagerCreateBtn:hover {
    background-color: #1177BB;
}
QToolButton#protocolManagerCreateBtn:pressed {
    background-color: #0A4A75;
}

#protocolManagerStatus {
    background-color: #1E1E1E;
    border-top: 1px solid #1E1E1E;
}
#protocolManagerStatusLabel {
    color: #969696;
    font-size: 11px;
}

/* ==================== TestProgramManagerWidget ==================== */
TestProgramManagerWidget {
    background-color: #252526;
}
TestProgramManagerWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
TestProgramManagerWidget QTreeWidget::item {
    padding: 4px 8px;
    min-height: 22px;
}
TestProgramManagerWidget QTreeWidget::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}
TestProgramManagerWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
#testProgramToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}

/* ==================== TestProgramEditorWidget ==================== */
TestProgramEditorWidget {
    background-color: #1E1E1E;
}
TestProgramEditorWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QLineEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
}
TestProgramEditorWidget QTextEdit:focus {
    border-color: #007ACC;
}
TestProgramEditorWidget QTableWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    gridline-color: #3C3C3C;
    outline: none;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
TestProgramEditorWidget QTableWidget::item {
    padding: 4px 8px;
}
TestProgramEditorWidget QHeaderView::section {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: none;
    border-bottom: 1px solid #3C3C3C;
    padding: 4px 8px;
    font-weight: bold;
}
TestProgramEditorWidget QTabWidget::pane {
    border: 1px solid #3C3C3C;
    background-color: #252526;
}
#testProgramEditorToolbar {
    background-color: #252526;
    border-bottom: 1px solid #1E1E1E;
}
#testProgramEditorAddCaseBtn, #testProgramEditorRemoveCaseBtn,
#testProgramEditorAddStepBtn, #testProgramEditorRemoveStepBtn {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
#testProgramEditorAddCaseBtn:hover, #testProgramEditorRemoveCaseBtn:hover,
#testProgramEditorAddStepBtn:hover, #testProgramEditorRemoveStepBtn:hover {
    background-color: #505050;
}
#testProgramEditorAddCaseBtn:pressed, #testProgramEditorRemoveCaseBtn:pressed,
#testProgramEditorAddStepBtn:pressed, #testProgramEditorRemoveStepBtn:pressed {
    background-color: #2D2D2D;
}

/* ── Validation label ── */
#testProgramValidationLabel {
    color: #F48771;
    font-size: 11px;
    padding: 2px 8px;
    background-color: #3C2020;
    border-radius: 2px;
}

/* ── Step detail panel ── */
StepDetailPanel QLabel {
    color: #CCCCCC;
    font-size: 12px;
}
#stepDetailTitle {
    font-weight: bold;
}
#stepDetailEmptyLabel {
    color: #888;
}
StepDetailPanel QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
}
StepDetailPanel QLineEdit:focus {
    border-color: #007ACC;
}

StepDetailPanel QCheckBox {
    color: #CCCCCC;
    spacing: 6px;
}

StepDetailPanel QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3C3C3C;
}

StepDetailPanel QCheckBox::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

StepDetailPanel QTableWidget {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    gridline-color: #3C3C3C;
    selection-background-color: #094771;
}

/* ==================== SearchWidget ==================== */
etest--app--SearchWidget {
    background-color: #252526;
}
etest--app--SearchWidget QLineEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #264F78;
}
etest--app--SearchWidget QLineEdit:focus {
    border-color: #007ACC;
}
etest--app--SearchWidget QToolButton {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    color: #CCCCCC;
    padding: 2px;
}
etest--app--SearchWidget QToolButton:hover {
    background-color: #505050;
    border-color: #007ACC;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn,
etest--app--SearchWidget QToolButton#searchWholeWordBtn,
etest--app--SearchWidget QToolButton#searchRegexModeBtn {
    background-color: transparent;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    color: #858585;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:hover,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:hover,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:hover {
    background-color: #505050;
    color: #CCCCCC;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:checked,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:checked,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:checked {
    background-color: #094771;
    border-color: #007ACC;
    color: #FFFFFF;
}
etest--app--SearchWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
etest--app--SearchWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
etest--app--SearchWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
etest--app--SearchWidget QTreeWidget::item:selected {
    background-color: #094771;
}
etest--app--SearchWidget QFrame#searchSeparator {
    background-color: #3C3C3C;
    max-height: 1px;
}
etest--app--SearchWidget QLabel {
    color: #858585;
    font-size: 12px;
    background-color: transparent;
}
etest--app--SearchWidget QLabel#fileSectionLabel,
etest--app--SearchWidget QLabel#contentSectionLabel {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
}
etest--app--SearchWidget QListWidget::item {
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget::item:hover {
    background-color: #2A2D2E;
}
etest--app--SearchWidget QListWidget::item:selected {
    background-color: #094771;
}

/* ==================== GitWidget ==================== */
GitWidget {
    background-color: #252526;
}
GitWidget QLabel {
    color: #CCCCCC;
    background-color: transparent;
}
GitWidget QTextEdit {
    background-color: #3C3C3C;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 2px;
    selection-background-color: #264F78;
    font-size: 13px;
}
GitWidget QTextEdit:focus {
    border-color: #007ACC;
}
GitWidget QToolButton#refresh_button_ {
    background-color: transparent;
    border: none;
    padding: 0px;
}
GitWidget QToolButton#refresh_button_:hover {
    background-color: #505050;
    border-radius: 3px;
}
GitWidget QTreeWidget {
    background-color: #252526;
    color: #CCCCCC;
    border: none;
    outline: none;
    font-size: 13px;
}
GitWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
GitWidget QTreeWidget::item:hover {
    background-color: #2A2D2E;
}
GitWidget QTreeWidget::item:selected {
    background-color: #094771;
}
GitWidget QLabel#gitEmptyLabel {
    color: #858585;
    font-size: 13px;
}

/* ==================== page1 执行仪表盘底部 tab（#ExecBottomTabs） ==================== */
/* 复刻 BottomContainerWidget 的 tab/表格/文本样式，保持 page0/page1 底部视觉一致 */
#ExecBottomTabs {
    background-color: #1E1E1E;
}
#ExecBottomTabs::pane {
    border: none;
    background-color: #1E1E1E;
}
#ExecBottomTabs QToolButton {
    background-color: transparent;
    border: none;
    color: #858585;
    padding: 2px;
}
#ExecBottomTabs QToolButton:hover {
    color: #FFFFFF;
}
#ExecBottomTabs QTextEdit {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
}
#ExecBottomTabs QTableWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    border: none;
    gridline-color: #3C3C3C;
}
#ExecBottomTabs QTableWidget::item {
    color: #CCCCCC;
}
#ExecBottomTabs QTableWidget::item:selected {
    background-color: #264F78;
    color: #FFFFFF;
}
#ExecBottomTabs QHeaderView::section {
    background-color: #2D2D2D;
    color: #858585;
    border: none;
    padding: 4px;
}

/* ==================== EtlogViewerWidget ==================== */
etest--app--EtlogViewerWidget {
