}
QPushButton#welcomePrimaryBtn {
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#welcomePrimaryBtn:hover {
    background-color: #106EBE;
}
QPushButton#welcomeSecondaryBtn {
    background-color: rgba(14, 99, 156, 0.20);
    color: #4AA8FF;
    border: none;
    border-radius: 8px;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#welcomeSecondaryBtn:hover {
    background-color: #0078D4;
    color: #FFFFFF;
}
QLabel#welcomeRecentEmpty {
    color: #6A6A84;
    font-size: 13px;
    border: 1px dashed #454545;
    border-radius: 8px;
    padding: 18px 0;
}
QPushButton#welcomeQuickBtn {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 10px;
    padding: 14px 4px;
    font-size: 13px;
    font-weight: 600;
    color: #CCCCCC;
}
QPushButton#welcomeQuickBtn:hover {
    border-color: #0078D4;
    background-color: rgba(14, 99, 156, 0.20);
}
QLabel#welcomeGuideNum {
    background-color: rgba(14, 99, 156, 0.20);
