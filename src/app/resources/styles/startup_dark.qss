/* Startup Splash 深色皮肤（vscode 主题档）
 * Splash 早于主窗口创建，其 objectName 选择器不在主题 QSS 内，
 * 故独立成 startup_dark.qss / startup_light.qss 两份固定配色，
 * 由 main() 按当前主题深浅二选一。 */

#StartupSplashContent {
    background-color: #2B2B2B;
    border: 1px solid #454545;
    border-radius: 12px;
}

#StartupSplashLogo {
    background: transparent;
}

#StartupSplashTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}

#StartupSplashStatus {
    color: #CCCCCC;
    font-size: 13px;
    background: transparent;
}

#StartupSplashProgressBar {
    background-color: #454545;
    border: none;
    border-radius: 4px;
    height: 16px;
    color: #CCCCCC;
    font-size: 11px;
    /* QSS 未声明 text-align 时 QStyleSheetStyle 默认左对齐，须显式居中 */
    text-align: center;
}

#StartupSplashProgressBar::chunk {
    background-color: #0A84FF;
    border-radius: 4px;
}
