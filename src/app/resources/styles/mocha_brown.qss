/* Moka Brown Mocha Brown Light Theme for ETest Studio */

/* 全局背景色和前景色 */
QMainWindow {
    background-color: #F6F3F1;
    color: #2A2015;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* 菜单栏 */
QMenuBar {
    background-color: #E4DBD5;
    color: #2A2015;
    border-bottom: 1px solid #EFE9E6;
    padding: 2px;
}
QMenuBar::item {
    padding: 4px 10px;
    background-color: transparent;
}
QMenuBar::item:selected {
    background-color: #967259;
}
QMenu {
    min-width: 200px;
    background-color: #EFE9E6;
    color: #2A2015;
    border: 1px solid #D5C6BC;
}
QMenu::item {
    padding: 6px 28px 6px 20px;
}
QMenu::item:selected {
    background-color: #967259;
}
QMenu::separator {
    height: 1px;
    background-color: #D5C6BC;
    margin: 4px 10px;
}

/* 工具栏 */
QToolBar {
    background-color: #E4DBD5;
    border: none;
    padding: 2px 4px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background-color: #D5C6BC;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    color: #2A2015;
    padding: 4px;
    margin: 1px;
}
QToolButton:hover {
    background-color: #D5C6BC;
}
QToolButton:pressed {
    background-color: #E4DBD5;
}
QToolButton:disabled {
    color: #8B7C71;
}

/* 状态栏 */
QStatusBar {
    background-color: #84644E;
    color: #FFFFFF;
    font-size: 12px;
    border-top: 1px solid #705542;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #FFFFFF;
    padding: 0px 8px;
}
QStatusBar QLabel:hover {
    background-color: rgba(255, 255, 255, 30);
}

/* ==================== QADS Dock 样式已迁移至 ads_mocha_brown.qss ==================== */
/* QADS的样式必须设置到CDockManager自身，否则会被QADS内置的default.css覆盖 */

/* 滚动条 */
QScrollBar:vertical {
    background-color: #F6F3F1;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #D5C6BC;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #D5C6BC;
}
QScrollBar::handle:vertical:pressed {
    background-color: #E4DBD5;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #F6F3F1;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #D5C6BC;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #D5C6BC;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #E4DBD5;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 分割器 */
QSplitter::handle {
    background-color: #E4DBD5;
}
QSplitter::handle:horizontal {
    background-color: #E4DBD5;
    width: 3px;
}
QSplitter::handle:horizontal:hover {
    background-color: #84644E;
}
QSplitter::handle:vertical {
    background-color: #E4DBD5;
    height: 3px;
}
QSplitter::handle:vertical:hover {
    background-color: #84644E;
}

/* Tab Widget — 由 TabBarStyle 全权自绘，不使用 QSS */
QTabWidget::pane {
    border: none;
    background-color: #F6F3F1;
}

/* 文本编辑区 */
QTextEdit {
    background-color: #F6F3F1;
    color: #2A2015;
    border: none;
    selection-background-color: #D5C6BC;
    selection-color: #FFFFFF;
}

/* 表格 */
QTableWidget, QTableView {
    background-color: #F6F3F1;
    alternate-background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    gridline-color: #E4DBD5;
    selection-background-color: #967259;
}
QTableWidget::item, QTableView::item {
    padding: 4px;
}
QHeaderView {
    background-color: #F6F3F1;
}
QHeaderView::section {
    background-color: #E4DBD5;
    color: #2A2015;
    font-weight: bold;
    border: none;
    border-right: 1px solid #E4DBD5;
    border-bottom: 1px solid #E4DBD5;
    padding: 4px 8px;
}
QTableCornerButton::section {
    background-color: #E4DBD5;
    border: none;
    border-right: 1px solid #E4DBD5;
    border-bottom: 1px solid #E4DBD5;
}
QTableCornerButton::section:hover {
    background-color: #E4DBD5;
}

/* 树形视图 */
QTreeView {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
}
QTreeView::item {
    padding: 2px 4px 2px 0px;
    border: none;
}
QTreeView::item:hover {
    background-color: #D5C6BC;
}
QTreeView::item:selected {
    background-color: #967259;
}
QTreeView::branch {
    background-color: #EFE9E6;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}
QTreeView QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #84644E;
    padding: 0px 2px;
    margin: 0px;
    selection-background-color: #D5C6BC;
}

/* 列表视图（最近文件等） */
QListView {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
}
QListView::item {
    padding: 2px 4px;
    border: none;
}
QListView::item:hover {
    background-color: #D5C6BC;
}
QListView::item:selected {
    background-color: #967259;
}

/* 硬件树 */
QTreeWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeWidget::item {
    padding: 3px 0px;
    border: none;
}
QTreeWidget::item:hover {
    background-color: #D5C6BC;
}
QTreeWidget::item:selected {
    background-color: #967259;
}
QTreeWidget::branch {
    background-color: #EFE9E6;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_right_light.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/resources/icons/svg/chevron_down_light.svg);
}

/* 按钮 */
QPushButton {
    background-color: #84644E;
    color: #FFFFFF;
    border: 1px solid #84644E;
    border-radius: 2px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #967259;
}
QPushButton:pressed {
    background-color: #765A46;
}
QPushButton:disabled {
    background-color: #E4DBD5;
    color: #8B7C71;
    border-color: #E4DBD5;
}

/* 输入框 */
QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #D5C6BC;
}
QLineEdit:focus {
    border-color: #84644E;
}

/* 对话框 */
QDialog {
    background-color: #EFE9E6;
    color: #2A2015;
}

/* Label */
QLabel {
    color: #2A2015;
    background-color: transparent;
}

/* ComboBox */
QComboBox {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #84644E;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/resources/icons/svg/drop_down_arrow_light.svg);
}
QComboBox QAbstractItemView {
    background-color: #EFE9E6;
    color: #2A2015;
    selection-background-color: #967259;
}

/* SpinBox */
QSpinBox {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
}
QSpinBox:focus {
    border-color: #84644E;
}

/* DoubleSpinBox */
QDoubleSpinBox {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #D5C6BC;
    selection-color: #FFFFFF;
}
QDoubleSpinBox:hover {
    border-color: #84644E;
}
QDoubleSpinBox:focus {
    border-color: #84644E;
}
QDoubleSpinBox:disabled {
    background-color: #E4DBD5;
    color: #8B7C71;
    border-color: #E4DBD5;
}
/* CheckBox */
QCheckBox {
    color: #2A2015;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* RadioButton */
QRadioButton {
    color: #2A2015;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #D5C6BC;
    border-radius: 7px;
    background-color: #E4DBD5;
}
QRadioButton::indicator:checked {
    background-color: #84644E;
    border-color: #84644E;
}

/* QGroupBox 样式由 gen_themes.py 注入（删除此处原有块，避免 subcontrol-origin:margin 泄漏） */

/* ToolTip */
QToolTip {
    background-color: #EFE9E6;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    padding: 4px 8px;
}

/* ProgressBar */
QProgressBar {
    background-color: #E4DBD5;
    border: none;
    border-radius: 2px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #84644E;
    border-radius: 2px;
}

/* ListBox / ListWidget */
QListWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    selection-background-color: #967259;
}
QListWidget::item:hover {
    background-color: #D5C6BC;
}
QListWidget::item:selected {
    background-color: #967259;
}

/* ScrollArea */
QScrollArea {
    background-color: #F6F3F1;
    border: none;
}

/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #E4DBD5;
    border-right: 1px solid #EFE9E6;
}
QWidget#sidebarActivityBar QToolButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #433328;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QToolButton:hover {
    background-color: #D5C6BC;
    color: #FFFFFF;
}
QWidget#sidebarActivityBar QToolButton:checked {
    border-left: 2px solid #84644E;
    color: #FFFFFF;
    background-color: #D5C6BC;
}

/* ==================== SidebarWidget ==================== */
SidebarWidget {
    background-color: #EFE9E6;
    border-right: 1px solid #F6F3F1;
}
SidebarWidget QLabel {
    color: #433328;
    font-size: 11px;
    font-weight: bold;
}
SidebarWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #433328;
    padding: 2px;
}
SidebarWidget QToolButton:hover {
    color: #FFFFFF;
}
#sidebarTitleBar {
    background-color: #EFE9E6;
}

/* ==================== ProtocolManagerWidget (ICDConfig 视图) ==================== */
ProtocolManagerWidget {
    background-color: #EFE9E6;
}
ProtocolManagerWidget QTreeWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    alternate-background-color: #EFE9E6;
}
ProtocolManagerWidget QTreeWidget::item {
    padding: 3px 6px;
    min-height: 20px;
    border: 0;
}
ProtocolManagerWidget QTreeWidget::item:selected {
    background-color: #967259;
    color: #FFFFFF;
}
ProtocolManagerWidget QTreeWidget::item:hover {
    background-color: #D5C6BC;
}
/* 帧条目禁用态：灰色 + 删除线（在代码中通过 font strikeOut + foreground 实现） */
ProtocolManagerWidget QTreeWidget::indicator {
    width: 13px;
    height: 13px;
}
ProtocolManagerWidget QHeaderView {
    background-color: #F6F3F1;
    border: none;
    border-bottom: 1px solid #F6F3F1;
}
ProtocolManagerWidget QHeaderView::section {
    background-color: #EFE9E6;
    color: #433328;
    padding: 4px 8px;
    border: 0;
    border-right: 1px solid #F6F3F1;
    font-weight: 600;
    font-size: 11px;
}
ProtocolManagerWidget QHeaderView::section:last {
    border-right: 0;
}

#protocolManagerTitle {
    background-color: #EFE9E6;
    border-bottom: 1px solid #F6F3F1;
}
#protocolManagerConfigLabel {
    color: #2A2015;
    font-size: 12px;
    font-weight: 600;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn {
    background-color: transparent;
    border: none;
    padding: 0px;
    border-radius: 3px;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:hover {
    background-color: #D5C6BC;
}
ProtocolManagerWidget QToolButton#protocolManagerRefreshBtn:pressed {
    background-color: #967259;
}

#protocolManagerToolbar {
    background-color: #EFE9E6;
    border-bottom: 1px solid #F6F3F1;
}

#protocolManagerEmpty {
    background-color: #EFE9E6;
}
#protocolManagerEmptyText {
    color: #433328;
    font-size: 12px;
    line-height: 1.5;
}
QToolButton#protocolManagerCreateBtn {
    background-color: #84644E;
    color: #FFFFFF;
    border: 1px solid #967259;
    border-radius: 3px;
    padding: 2px 16px;
    font-size: 12px;
}
QToolButton#protocolManagerCreateBtn:hover {
    background-color: #967259;
}
QToolButton#protocolManagerCreateBtn:pressed {
    background-color: #69503E;
}

#protocolManagerStatus {
    background-color: #F6F3F1;
    border-top: 1px solid #F6F3F1;
}
#protocolManagerStatusLabel {
    color: #433328;
    font-size: 11px;
}

/* ==================== TestProgramManagerWidget ==================== */
TestProgramManagerWidget {
    background-color: #EFE9E6;
}
TestProgramManagerWidget QTreeWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
}
TestProgramManagerWidget QTreeWidget::item {
    padding: 4px 8px;
    min-height: 22px;
}
TestProgramManagerWidget QTreeWidget::item:selected {
    background-color: #967259;
    color: #FFFFFF;
}
TestProgramManagerWidget QTreeWidget::item:hover {
    background-color: #D5C6BC;
}
#testProgramToolbar {
    background-color: #EFE9E6;
    border-bottom: 1px solid #F6F3F1;
}

/* ==================== TestProgramEditorWidget ==================== */
TestProgramEditorWidget {
    background-color: #F6F3F1;
}
TestProgramEditorWidget QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #D5C6BC;
}
TestProgramEditorWidget QLineEdit:focus {
    border-color: #84644E;
}
TestProgramEditorWidget QTextEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    selection-background-color: #D5C6BC;
}
TestProgramEditorWidget QTextEdit:focus {
    border-color: #84644E;
}
TestProgramEditorWidget QTableWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    gridline-color: #E4DBD5;
    outline: none;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
}
TestProgramEditorWidget QTableWidget::item {
    padding: 4px 8px;
}
TestProgramEditorWidget QHeaderView::section {
    background-color: #E4DBD5;
    color: #2A2015;
    border: none;
    border-bottom: 1px solid #E4DBD5;
    padding: 4px 8px;
    font-weight: bold;
}
TestProgramEditorWidget QTabWidget::pane {
    border: 1px solid #D5C6BC;
    background-color: #EFE9E6;
}
#testProgramEditorToolbar {
    background-color: #EFE9E6;
    border-bottom: 1px solid #F6F3F1;
}
#testProgramEditorAddCaseBtn, #testProgramEditorRemoveCaseBtn,
#testProgramEditorAddStepBtn, #testProgramEditorRemoveStepBtn {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
#testProgramEditorAddCaseBtn:hover, #testProgramEditorRemoveCaseBtn:hover,
#testProgramEditorAddStepBtn:hover, #testProgramEditorRemoveStepBtn:hover {
    background-color: #D5C6BC;
}
#testProgramEditorAddCaseBtn:pressed, #testProgramEditorRemoveCaseBtn:pressed,
#testProgramEditorAddStepBtn:pressed, #testProgramEditorRemoveStepBtn:pressed {
    background-color: #E4DBD5;
}

/* ── Validation label ── */
#testProgramValidationLabel {
    color: #E53935;
    font-size: 11px;
    padding: 2px 8px;
    background-color: #4A2020;
    border-radius: 2px;
}

/* ── Step detail panel ── */
StepDetailPanel QLabel {
    color: #2A2015;
    font-size: 12px;
}
#stepDetailTitle {
    font-weight: bold;
}
#stepDetailEmptyLabel {
    color: #433328;
}
StepDetailPanel QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
}
StepDetailPanel QLineEdit:focus {
    border-color: #84644E;
}

StepDetailPanel QCheckBox {
    color: #2A2015;
    spacing: 6px;
}

StepDetailPanel QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    background-color: #E4DBD5;
}

StepDetailPanel QCheckBox::indicator:checked {
    background-color: #84644E;
    border-color: #84644E;
}

StepDetailPanel QTableWidget {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    gridline-color: #E4DBD5;
    selection-background-color: #967259;
}

/* ==================== SearchWidget ==================== */
etest--app--SearchWidget {
    background-color: #EFE9E6;
}
etest--app--SearchWidget QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #D5C6BC;
}
etest--app--SearchWidget QLineEdit:focus {
    border-color: #84644E;
}
etest--app--SearchWidget QToolButton {
    background-color: transparent;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    color: #2A2015;
    padding: 2px;
}
etest--app--SearchWidget QToolButton:hover {
    background-color: #D5C6BC;
    border-color: #84644E;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn,
etest--app--SearchWidget QToolButton#searchWholeWordBtn,
etest--app--SearchWidget QToolButton#searchRegexModeBtn {
    background-color: transparent;
    border: 1px solid #D5C6BC;
    border-radius: 3px;
    color: #433328;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:hover,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:hover,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:hover {
    background-color: #D5C6BC;
    color: #2A2015;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:checked,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:checked,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:checked {
    background-color: #967259;
    border-color: #84644E;
    color: #FFFFFF;
}
etest--app--SearchWidget QTreeWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    font-size: 13px;
}
etest--app--SearchWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
etest--app--SearchWidget QTreeWidget::item:hover {
    background-color: #D5C6BC;
}
etest--app--SearchWidget QTreeWidget::item:selected {
    background-color: #967259;
}
etest--app--SearchWidget QFrame#searchSeparator {
    background-color: #E4DBD5;
    max-height: 1px;
}
etest--app--SearchWidget QLabel {
    color: #433328;
    font-size: 12px;
    background-color: transparent;
}
etest--app--SearchWidget QLabel#fileSectionLabel,
etest--app--SearchWidget QLabel#contentSectionLabel {
    color: #433328;
    font-size: 11px;
    background-color: transparent;
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
}
etest--app--SearchWidget QListWidget::item {
    padding: 2px 4px;
}
etest--app--SearchWidget QListWidget::item:hover {
    background-color: #D5C6BC;
}
etest--app--SearchWidget QListWidget::item:selected {
    background-color: #967259;
}

/* ==================== GitWidget ==================== */
GitWidget {
    background-color: #EFE9E6;
}
GitWidget QLabel {
    color: #2A2015;
    background-color: transparent;
}
GitWidget QTextEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
