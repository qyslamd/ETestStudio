}
GitWidget QToolButton#refresh_button_ {
    background-color: transparent;
    border: none;
    padding: 0px;
}
GitWidget QToolButton#refresh_button_:hover {
    background-color: #D5C6BC;
    border-radius: 3px;
}
GitWidget QTreeWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border: none;
    outline: none;
    font-size: 13px;
}
GitWidget QTreeWidget::item {
    padding: 2px 0px;
    border: none;
}
GitWidget QTreeWidget::item:hover {
    background-color: #D5C6BC;
}
GitWidget QTreeWidget::item:selected {
    background-color: #967259;
}
GitWidget QLabel#gitEmptyLabel {
    color: #433328;
    font-size: 13px;
}

/* ==================== etest--app--BottomContainerWidget ==================== */
etest--app--BottomContainerWidget {
    background-color: #F6F3F1;
}
etest--app--BottomContainerWidget QTabWidget {
    background-color: #F6F3F1;
}
etest--app--BottomContainerWidget QTabWidget::pane {
    border: none;
    background-color: #F6F3F1;
}
etest--app--BottomContainerWidget QToolButton {
    background-color: transparent;
