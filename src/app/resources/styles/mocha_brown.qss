    padding: 2px;
}
#ExecBottomTabs QToolButton:hover {
    color: #FFFFFF;
}
#ExecBottomTabs QTextEdit {
    background-color: #F6F3F1;
    color: #2A2015;
    border: none;
}
#ExecBottomTabs QTableWidget {
    background-color: #F6F3F1;
    color: #2A2015;
    border: none;
    gridline-color: #E4DBD5;
}
#ExecBottomTabs QTableWidget::item {
    color: #2A2015;
}
#ExecBottomTabs QTableWidget::item:selected {
