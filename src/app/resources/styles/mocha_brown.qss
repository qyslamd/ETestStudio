    font-weight: bold;
}
QLabel#WelcomeRecentCardPath {
    color: #433328;
    font-size: 11px;
}
QLabel#WelcomeRecentCardTime {
    color: #433328;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #2A2015;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
