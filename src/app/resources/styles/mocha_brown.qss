}

/* --- Daily Tip Tile --- */
QLabel#WelcomeTipTitle {
    color: #cccccc;
    font-size: 14px;
    font-weight: bold;
}
QLabel#WelcomeTipContent {
    color: #433328;
    font-size: 12px;
}

/* ==================== etest--app--SettingsDialog ==================== */
etest--app--SettingsDialog {
    background-color: #EFE9E6;
}

/* 左侧分类列表 */
etest--app--SettingsDialog QListWidget {
    background-color: #EFE9E6;
    color: #2A2015;
    border-right: 1px solid #F6F3F1;
    font-size: 13px;
    outline: none;
}
etest--app--SettingsDialog QListWidget::item {
    padding: 8px 12px;
    border: none;
}
etest--app--SettingsDialog QListWidget::item:hover {
    background-color: #D5C6BC;
}
etest--app--SettingsDialog QListWidget::item:selected {
    background-color: #967259;
    color: #FFFFFF;
}

/* 右侧页面容器 */
etest--app--SettingsDialog QStackedWidget {
    background-color: #F6F3F1;
}
etest--app--SettingsDialog QStackedWidget > QWidget {
    background-color: #F6F3F1;
}

/* 外观页内嵌滚动区 */
etest--app--SettingsDialog QScrollArea {
    background-color: #F6F3F1;
    border: none;
}
etest--app--SettingsDialog QScrollArea > QWidget {
    background-color: #F6F3F1;
}
etest--app--SettingsDialog QScrollArea > QWidget > QWidget {
    background-color: #F6F3F1;
}

/* 卡片容器 */
QWidget#SettingsCard {
    background-color: #E4DBD5;
    border: 1px solid #D5C6BC;
    border-radius: 8px;
}
QLabel#SettingsCardTitle {
    color: #2A2015;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0 8px;
    background-color: transparent;
}

/* VS Code 风格设置行 */
QWidget#SettingsRow {
    border-bottom: 1px solid #E4DBD5;
    background-color: transparent;
}
QLabel#SettingsRowTitle {
    color: #2A2015;
    font-size: 13px;
    background-color: transparent;
}
QLabel#SettingsRowDesc {
    color: #433328;
    font-size: 11px;
    background-color: transparent;
}
QLabel#SettingsHint {
    color: #433328;
    font-size: 11px;
    padding: 4px 0;
    background-color: transparent;
}

/* 设置页通用标签 */
etest--app--SettingsDialog QLabel {
    color: #2A2015;
    background-color: transparent;
}

/* 底部按钮栏 */
QWidget#SettingsButtonBar {
    border-top: 1px solid #F6F3F1;
    background-color: #EFE9E6;
}
QComboBox QAbstractItemView {
    background-color: #EFE9E6;
    color: #2A2015;
    selection-background-color: #967259;
    border: 1px solid #D5C6BC;
}

/* 设置页中的文本框 */
etest--app--SettingsDialog QLineEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QLineEdit:focus {
    border-color: #84644E;
}

/* 设置页中的复选框 */
etest--app--SettingsDialog QCheckBox {
    color: #2A2015;
    spacing: 8px;
    background-color: transparent;
}
etest--app--SettingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/resources/icons/svg/checkbox_unchecked.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:hover {
    image: url(:/resources/icons/svg/checkbox_unchecked_hover.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked {
    image: url(:/resources/icons/svg/checkbox_checked.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked:hover {
    image: url(:/resources/icons/svg/checkbox_checked_hover.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:disabled {
    image: url(:/resources/icons/svg/checkbox_unchecked_disabled.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:checked:disabled {
    image: url(:/resources/icons/svg/checkbox_checked_disabled.svg);
}
etest--app--SettingsDialog QCheckBox::indicator:indeterminate {
    image: url(:/resources/icons/svg/checkbox_indeterminate.svg);
}

/* 设置页中的按钮 — 已由全局 QPushButton 统一样式覆盖 */

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #EFE9E6;
    border: 1px solid #D5C6BC;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #84644E, stop: 1 #705542);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #2A2015;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #433328;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #E4DBD5;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #433328;
    font-size: 11px;
    background: transparent;
}
QToolButton#aboutOkButton {
    background-color: #84644E;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
QToolButton#aboutOkButton:hover {
    background-color: #967259;
}
QToolButton#aboutOkButton:pressed {
    background-color: #765A46;
}
#aboutCopyright {
    color: #433328;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #8B7C71;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: #EFE9E6;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #765A46, stop:1 #634B3A);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.55);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #2A2015;
}
#loginUsername, #loginPassword {
  background: #E4DBD5;
  border: 1px solid #8B7C71;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #2A2015;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #967259;
  background: #E4DBD5;
}
QToolButton#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #765A46, stop:1 #967259);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #69503E, stop:1 #84644E);
}
QToolButton#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #69503E, stop:1 #765A46);
}
#loginHint {
  color: #ef5350;
  font-size: 12px;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #433328;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#loginCloseBtn:hover {
  color: #eee;
}
#loginRemember {
  font-size: 12px;
  color: #433328;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: #EFE9E6;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #2A2015;
}
#userMgrCount {
  font-size: 12px;
  color: #433328;
  margin-left: 8px;
}
QToolButton#userMgrAddBtn {
  background: #69503E;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
QToolButton#userMgrAddBtn:hover {
  background: #765A46;
}
#userMgrTable {
  border: 1px solid #D5C6BC;
  border-radius: 8px;
  gridline-color: #333;
  color: #2A2015;
  background: #F6F3F1;
}
#userMgrTable::item {
  padding: 6px 12px;
}
QToolButton#userMgrEditBtn {
  background: transparent;
  color: #967259;
  border: none;
  font-size: 12px;
}
QToolButton#userMgrDeleteBtn {
  background: transparent;
  color: #ef5350;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #433328;
}
#userMgrErrorHint {
  font-size: 12px;
  color: #ef5350;
}
QToolButton#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #433328;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#userMgrCloseBtn:hover {
  color: #eee;
}

/* ==================== HintPopup ==================== */
QFrame#HintPopupContent {
