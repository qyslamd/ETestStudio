    color: #2A2015;
}
etest--app--BottomContainerWidget QTableWidget::item:selected {
    background-color: #D5C6BC;
    color: #FFFFFF;
}
etest--app--BottomContainerWidget QHeaderView::section {
    background-color: #E4DBD5;
