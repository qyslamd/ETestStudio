}
etest--app--BottomContainerWidget QToolButton:hover {
    color: #FFFFFF;
}

/* Output 面板（QTextEdit） */
etest--app--BottomContainerWidget QTextEdit {
    background-color: #F6F3F1;
    color: #2A2015;
    border: none;
}

/* 问题面板（QTableWidget） */
etest--app--BottomContainerWidget QTableWidget {
    background-color: #F6F3F1;
