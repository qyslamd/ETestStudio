    background-color: transparent;
}
QWidget#PhScrollContent {
    background-color: transparent;
}

/* Section headers (项目管理/最近项目) */
QLabel#PhSectionLabel {
    color: #433328;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
    background: transparent;
}

/* Project action buttons (新建项目/打开项目) */
QToolButton#PhProjectBtn {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhProjectBtn:hover {
    background-color: #E4DBD5;
    border-color: #84644E;
}
QToolButton#PhProjectBtn:pressed {
    background-color: #967259;
}

QLabel#PhTitle {
    font-size: 14px;
    font-weight: 600;
    color: #433328;
}
QLabel#PhDesc {
    font-size: 12px;
    color: #AAAAAA;
}
QFrame#PhSeparator {
    color: #E4DBD5;
    max-height: 1px;
}

/* Placeholder page round-corner cards */
QFrame#PhCard {
    background-color: #E4DBD5;
    border: 1px solid #D5C6BC;
    border-radius: 8px;
}
QFrame#PhCard:hover {
    border-color: #84644E;
}
QToolButton#PhQuickBtn {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhQuickBtn:hover {
    background-color: #E4DBD5;
    border-color: #84644E;
}
QToolButton#PhQuickBtn:pressed {
    background-color: #967259;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #D5C6BC;
}
QDockWidget > QWidget {
    background: #EFE9E6;
}

/* IcdPropertyPanel 内容区 */
QScrollArea#icdPropertyScroll {
    background-color: #EFE9E6;
    border: none;
}
QScrollArea#icdPropertyScroll > QWidget > QWidget {
    background-color: #EFE9E6;
}
QWidget#icdPropertyForm {
    background-color: #EFE9E6;
}
etest--ui--DockTitleBar {
    background: #E4DBD5;
    border-bottom: 1px solid #E4DBD5;
}
QLabel#dockTitleBarLabel {
    color: #2A2015;
    font-size: 12px;
    background: transparent;
}
QToolButton#dockFloatButton, QToolButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QToolButton#dockFloatButton:hover, QToolButton#dockCloseButton:hover {
    background: rgba(255, 255, 255, 0.1);
}
QToolButton#dockFloatButton:pressed, QToolButton#dockCloseButton:pressed {
    background: rgba(255, 255, 255, 0.18);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    color: #433328;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    padding: 4px 8px;
}QToolButton#PhOpenFilesHeaderBtn:hover {
    color: #2A2015;
}

/* ==================== TuxSaverOverlay ==================== */
QToolButton#saverCloseBtn {
    color: rgba(255,255,255,160);
    background: rgba(255,255,255,25);
    border: 1px solid rgba(255,255,255,40);
    border-style: solid;
    font-size: 16px;
    border-radius: 16px;
    padding: 0px;
    margin: 0px;
}
QToolButton#saverCloseBtn:hover {
    background: rgba(255,80,80,160);
    color: white;
    border-color: rgba(255,80,80,230);
    border-width: 1.5px;
    border-style: solid;
}
QToolButton#saverCloseBtn:pressed {
    background: rgba(200,50,50,180);
    color: white;
    border-color: rgba(200,50,50,220);
    border-style: solid;
}

/* ==================== Tab Close Button (Dark) ==================== */
#bottomTabWidget QTabBar::close-button {
    image: url(:/resources/icons/svg/close_light.svg);
    subcontrol-position: right;
    width: 14px;
    height: 14px;
}
#bottomTabWidget QTabBar::close-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

/* ==================== Signal Visualizers (Dark) ==================== */

/* WaveformWidget */
#WaveformTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
    color: #2A2015;
}
#WaveformPlot {
    border: 1px solid #D5C6BC;
    border-radius: 2px;
}

/* 两级标题：二级标题（连接描述）小字灰 */
#WaveformSubtitle, #LEDSubtitle, #MeterSubtitle, #GaugeSubtitle, #ValueLabelSubtitle {
    font-size: 10px;
    color: #433328;
}

/* 监听器配置对话框（MonitorConfigDialog） */
#MonitorConfigSearch {
    padding: 4px 6px;
    border: 1px solid #D5C6BC;
    border-radius: 3px;
}
#MonitorConfigList {
    border: 1px solid #D5C6BC;
    border-radius: 3px;
    background-color: #EFE9E6;
}
#MonitorConfigRight {
    border: 1px solid #D5C6BC;
    border-radius: 3px;
    background-color: #F6F3F1;
}
#MonitorConfigDelete {
    padding: 4px 12px;
}
/* #MonitorTypeTile 样式由 gen_themes.py 注入（QGroupBox 悬浮标题 + accent 胶囊） */

/* Visualizer 容器背景 */
#ValueLabelWidget, #MeterWidget, #LEDWidget, #WaveformWidget, #GaugeWidget, #LedIndicator {
    background-color: #F6F3F1;
}

/* StateLEDWidget */
#LEDTitle {
    font-size: 12px;
    font-weight: bold;
    color: #2A2015;
}
#LEDDot {
    min-width: 20px; max-width: 20px;
    min-height: 20px; max-height: 20px;
    border-radius: 10px;
}
#LEDDot[ledState="on"] {
    background-color: #00cc66;
}
#LEDDot[ledState="off"] {
    background-color: #cc3333;
}
#LEDStateText {
    font-size: 14px;
    font-weight: bold;
}
#LEDPulse {
    font-size: 11px;
    color: #433328;
}
#LEDTs {
    font-size: 10px;
    color: #433328;
}

/* DigitalMeterWidget */
#MeterTitle {
    font-size: 12px;
    font-weight: bold;
    color: #2A2015;
}
#GaugeTitle {
    font-size: 12px;
    font-weight: bold;
    color: #2A2015;
}
#MeterValue {
    font-size: 28px;
    font-weight: bold;
    color: #2A2015;
}
#MeterTrend {
    font-size: 18px;
}
#MeterRange {
    font-size: 11px;
    color: #433328;
}
#MeterRaw {
    font-size: 11px;
    color: #433328;
}
#MeterTs {
    font-size: 10px;
    color: #433328;
}

/* ValueLabelWidget */
#ValueLabelTitle {
    font-size: 12px;
    font-weight: bold;
    color: #2A2015;
}
#ValueLabelValue {
    font-size: 22px;
    font-weight: bold;
    color: #2A2015;
}
#ValueLabelRaw {
    font-size: 11px;
    color: #433328;
}
#ValueLabelTs {
    font-size: 10px;
    color: #433328;
}

/* SignalTreePanel */
#SignalTreeSearch {
    padding: 4px;
    margin: 2px 4px;
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 3px;
}
#SignalTree {
    background: transparent;
}

/* VisualizationArea */
#VisualizationArea {
    background: #EFE9E6;
    border: none;
}

/* ExecutionDebugWidget */
#ExecDebugTree {
    background: transparent;
}

/* ExecutionDashboard splitter */
#ExecDashboardSplitter::handle {
    width: 2px;
    background: #E4DBD5;
}

/* Ribbon running mode indicator */
#RunningMode {
    border-bottom: 3px solid #967259;
}

/* ==================== LogFilterBar（page0 输出面板筛选工具栏） ==================== */
#LogFilterBar {
    background: #EFE9E6;
    border: none;
}
#LogFilterBar QLineEdit#LogFilterBox {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 2px 6px;
    selection-background-color: #D5C6BC;
}
#LogFilterBar QLineEdit#LogFilterBox:focus {
    border-color: #84644E;
}
/* 正则非法红框 */
#LogFilterBar QLineEdit#LogFilterBox[invalid="true"] {
    border: 1px solid #E53935;
}
#LogFilterBar QToolButton {
    background-color: transparent;
    border: 1px solid #D5C6BC;
    border-radius: 3px;
    color: #433328;
    font-size: 12px;
    padding: 1px 4px;
}
#LogFilterBar QToolButton:hover {
    background-color: #D5C6BC;
    color: #2A2015;
}
#LogFilterBar QToolButton:checked {
    background-color: #967259;
    border-color: #84644E;
    color: #FFFFFF;
}
/* 级别按钮按级别着色（checked 时高亮该级别色） */
#LogFilterBar QToolButton#LevelDebugBtn:checked { color: #433328; }
#LogFilterBar QToolButton#LevelInfoBtn:checked  { color: #2A2015; }
#LogFilterBar QToolButton#LevelWarnBtn:checked  { color: #D7BA7D; }
#LogFilterBar QToolButton#LevelErrorBtn:checked { color: #E53935; }
#LogFilterBar QToolButton#LevelFatalBtn:checked { color: #FF0000; }

/* QAB 文件搜索框 */
#RibbonSearchEdit {
    background-color: #E4DBD5;
    color: #2A2015;
    border: 1px solid #D5C6BC;
    border-radius: 2px;
    padding: 2px 6px;
    selection-background-color: #D5C6BC;
}
#RibbonSearchEdit:focus {
    border-color: #84644E;
}
#RibbonSearchEdit:disabled {
    background-color: #E4DBD5;
    color: #8B7C71;
    border: 1px solid #D5C6BC;
}

/* ===== QSpinBox 主题适配样式 START ===== */
/* QSpinBox / QDoubleSpinBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #E4DBD5 #EFE9E6 #E6DDD8 #F0EAE8 #D5C6BC #2A2015
 *        #967259 #84644E #8B7C71 132 100 78 dark
 */
QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E4DBD5,
                        stop:1 #EFE9E6);
    border: 1px solid #D5C6BC;
    border-radius: 8px;
    padding: 8px 30px 8px 12px;
    color: #2A2015;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E6DDD8,
                        stop:1 #F0EAE8);
    border: 1px solid #84644E;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #84644E;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #EFE9E6;
    color: #8B7C71;
    border: 1px solid #D5C6BC;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right top;
    width: 28px;
    height: 14px;
    border: none;
    border-top-right-radius: 7px;
    border-left: 1px solid #D5C6BC;
    background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: rgba(132, 100, 78, 0.2);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background: rgba(132, 100, 78, 0.4);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: right bottom;
    width: 28px;
    height: 14px;
    border: none;
    border-bottom-right-radius: 7px;
    border-left: 1px solid #D5C6BC;
    background: transparent;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(132, 100, 78, 0.2);
}
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: rgba(132, 100, 78, 0.4);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
}
/* 状态样式 */
QSpinBox[status="success"], QDoubleSpinBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.4);
}
QSpinBox[status="success"]:hover, QDoubleSpinBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QSpinBox[status="success"]:focus, QDoubleSpinBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QSpinBox[status="error"], QDoubleSpinBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.4);
}
QSpinBox[status="error"]:hover, QDoubleSpinBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QSpinBox[status="error"]:focus, QDoubleSpinBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QSpinBox[status="warning"], QDoubleSpinBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.4);
}
QSpinBox[status="warning"]:hover, QDoubleSpinBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QSpinBox[status="warning"]:focus, QDoubleSpinBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QSpinBox[size="small"], QDoubleSpinBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    min-height: 28px;
    border-radius: 6px;
}
QSpinBox[size="small"]::up-button, QDoubleSpinBox[size="small"]::up-button {
    width: 22px;
    height: 12px;
    border-top-right-radius: 5px;
}
QSpinBox[size="small"]::down-button, QDoubleSpinBox[size="small"]::down-button {
    width: 22px;
    height: 12px;
    border-bottom-right-radius: 5px;
}
QSpinBox[size="large"], QDoubleSpinBox[size="large"] {
    padding: 12px 36px 12px 16px;
    font-size: 16px;
    min-height: 48px;
    border-radius: 10px;
}
QSpinBox[size="large"]::up-button, QDoubleSpinBox[size="large"]::up-button {
    width: 32px;
    height: 18px;
    border-top-right-radius: 9px;
}
QSpinBox[size="large"]::down-button, QDoubleSpinBox[size="large"]::down-button {
    width: 32px;
    height: 18px;
    border-bottom-right-radius: 9px;
}
/* 圆角样式 */
QSpinBox[rounded="true"], QDoubleSpinBox[rounded="true"] {
    border-radius: 24px;
    padding: 10px 36px 10px 16px;
}
QSpinBox[rounded="true"]::up-button, QDoubleSpinBox[rounded="true"]::up-button {
    border-top-right-radius: 24px;
}
QSpinBox[rounded="true"]::down-button, QDoubleSpinBox[rounded="true"]::down-button {
    border-bottom-right-radius: 24px;
}
/* 无边框样式 */
QSpinBox[frameless="true"], QDoubleSpinBox[frameless="true"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #D5C6BC;
    border-radius: 0;
    padding: 8px 30px 8px 0;
}
QSpinBox[frameless="true"]:hover, QDoubleSpinBox[frameless="true"]:hover {
    border-bottom: 2px solid #84644E;
}
QSpinBox[frameless="true"]:focus, QDoubleSpinBox[frameless="true"]:focus {
    border-bottom: 2px solid #84644E;
}
QSpinBox[frameless="true"]::up-button, QDoubleSpinBox[frameless="true"]::up-button {
    border-left: none;
}
QSpinBox[frameless="true"]::down-button, QDoubleSpinBox[frameless="true"]::down-button {
    border-left: none;
}
/* ===== QSpinBox 主题适配样式 END ===== */

/* ===== QComboBox 主题适配样式 START ===== */
/* QComboBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #E4DBD5 #EFE9E6 #E6DDD8 #F0EAE8 #D5C6BC #2A2015
 *        #967259 #84644E #8B7C71 132 100 78 dark
 */
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E4DBD5,
                        stop:1 #EFE9E6);
    border: 1px solid #D5C6BC;
    border-radius: 8px;
    padding: 8px 36px 8px 8px;
    color: #2A2015;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
    min-height: 20px;
}
/* 下拉箭头 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    height: 100%;
    border: none;
    border-left: 1px solid #D5C6BC;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background: transparent;
}
QComboBox::drop-down:hover {
    background: rgba(132, 100, 78, 0.2);
}
QComboBox::drop-down:pressed {
    background: rgba(132, 100, 78, 0.4);
}
QComboBox::drop-down::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    subcontrol-origin: margin;
    subcontrol-position: right center;
}
/* 下拉列表视图 */
QComboBox QAbstractItemView {
    background: #EFE9E6;
    border: 1px solid #D5C6BC;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
    outline: none;
    alternate-background-color: transparent;
    color: #2A2015;
}
QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    margin: 2px 4px;
    border-radius: 6px;
    min-height: 24px;
    color: #2A2015;
}
QComboBox QAbstractItemView::item:hover {
    background: rgba(132, 100, 78, 0.3);
    color: #2A2015;
}
QComboBox QAbstractItemView::item:selected {
    background: rgba(132, 100, 78, 0.6);
    color: #FFFFFF;
    border: 1px solid rgba(132, 100, 78, 0.8);
}
QComboBox QAbstractItemView::item:alternate {
    background: transparent;
}
/* 悬停 */
QComboBox:hover {
    border: 1px solid #84644E;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E6DDD8,
                        stop:1 #F0EAE8);
}
/* 焦点 */
QComboBox:focus {
    border: 2px solid #84644E;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E6DDD8,
                        stop:1 #F0EAE8);
}
/* 禁用 */
QComboBox:disabled {
    background: #EFE9E6;
    color: #8B7C71;
    border: 1px solid #D5C6BC;
}
QComboBox::drop-down:disabled {
    background: #EFE9E6;
    border-left: 1px solid #D5C6BC;
}
QComboBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    opacity: 0.5;
}
/* 可编辑状态 */
QComboBox[editable="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #E4DBD5,
                        stop:1 #EFE9E6);
}
QComboBox[editable="true"] QLineEdit {
    background: transparent;
    border: none;
    color: #2A2015;
    selection-background-color: #967259;
    selection-color: #FFFFFF;
    padding: 0px;
}
QComboBox[editable="true"] QLineEdit:focus {
    border: none;
    outline: none;
}
/* 状态样式 */
QComboBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QComboBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.8);
}
QComboBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QComboBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QComboBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.8);
}
QComboBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QComboBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QComboBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.8);
}
QComboBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QComboBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    border-radius: 6px;
    min-height: 16px;
}
QComboBox[size="small"]::drop-down {
    width: 24px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QComboBox[size="small"]::drop-down::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox[size="small"] QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 20px;
    font-size: 12px;
}
QComboBox[size="large"] {
    padding: 10px 32px 10px 16px;
    font-size: 16px;
    border-radius: 10px;
    min-height: 24px;
}
QComboBox[size="large"]::drop-down {
    width: 36px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}
QComboBox[size="large"]::drop-down::down-arrow {
    width: 14px;
    height: 14px;
}
QComboBox[size="large"] QAbstractItemView::item {
    padding: 12px 16px;
    min-height: 28px;
    font-size: 16px;
}
/* 特殊样式 */
QComboBox[rounded="true"] {
    border-radius: 20px;
    padding: 8px 32px 8px 20px;
}
QComboBox[rounded="true"]::drop-down {
    border-top-right-radius: 19px;
    border-bottom-right-radius: 19px;
}
QComboBox[rounded="true"] QAbstractItemView {
    border-radius: 12px;
}
QComboBox[rounded="true"] QAbstractItemView::item {
    border-radius: 8px;
}
QComboBox[frameless="true"] {
    border: none;
    background: #EFE9E6;
}
QComboBox[frameless="true"]::drop-down {
    border-left: none;
}
QComboBox[frameless="true"]:hover {
    background: #F0EAE8;
}
QComboBox[frameless="true"]:focus {
    background: #F0EAE8;
}
/* ===== QComboBox 主题适配样式 END ===== */

/* ===== QScrollArea 主题适配样式 START ===== */
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
#ScrollAreaContent {
    background: transparent;
}
/* ===== QScrollArea 主题适配样式 END ===== */

/* ===== MonitorTypeTile QGroupBox 主题适配样式 START ===== */
QGroupBox {
    background-color: #EFE9E6;
    border: 1px solid #D5C6BC;
    border-radius: 8px;
    margin-top: 0px;
    padding: 22px 12px 12px 12px;
    color: #2A2015;
}
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    padding: 2px 8px;
    background-color: #84644E;
    border-radius: 4px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
}
QGroupBox:hover {
    border: 1px solid #84644E;
}
QGroupBox[selected="true"] {
    border: 2px solid #84644E;
}
QGroupBox[selected="true"]::title {
    background-color: #705542;
}
/* ===== MonitorTypeTile QGroupBox 主题适配样式 END ===== */
