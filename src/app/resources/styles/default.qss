/* 默认主题 - 保持原生控件样式 */

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #42A5F5, stop: 1 #1565C0);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #EEEEEE;
    color: #555555;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #E0E0E0;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutOkButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
#aboutOkButton:hover {
    background-color: #1976D2;
}
#aboutOkButton:pressed {
    background-color: #0D47A1;
}
#aboutCopyright {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #AAAAAA;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1d8fe1, stop:1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#loginUsername, #loginPassword {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #1d8fe1;
  background: white;
}
#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #4080ff, stop:1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #3070ee, stop:1 #70b0ff);
}
#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #2060dd, stop:1 #60a0ee);
}
#loginHint {
  color: #e53935;
  font-size: 12px;
}
#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#loginCloseBtn:hover {
  color: #333;
}
#loginRemember {
  font-size: 12px;
  color: #555;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: white;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
#userMgrAddBtn {
  background: #1d8fe1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
#userMgrAddBtn:hover {
  background: #1a7dcc;
}
#userMgrTable {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  gridline-color: #f0f0f0;
}
#userMgrTable::item {
  padding: 6px 12px;
}
#userMgrEditBtn {
  background: transparent;
  color: #1d8fe1;
  border: none;
  font-size: 12px;
}
#userMgrDeleteBtn {
  background: transparent;
  color: #e53935;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #999;
}
#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#userMgrCloseBtn:hover {
  color: #333;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

/* ==================== WelcomeWidget ==================== */
QWidget#WelcomeWidget {
    background-color: #F5F5F5;
}

/* --- Action Tiles (新建/打开项目, 1x1) --- */
QLabel#WelcomeActionIcon {
    color: #0078D4;
    font-size: 28px;
}
QLabel#WelcomeActionText {
    color: #444444;
    font-size: 14px;
    font-weight: bold;
}

/* --- Eye Widget Tile (4x1) --- */
QWidget#WelcomeEyeContent {
    background: transparent;
}
QWidget#WelcomeEyeTopBar {
    background: transparent;
}
QLabel#WelcomeEyeLogoLabel {
    color: #333333;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#WelcomeEyeVersionLabel {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
QLabel#WelcomeEyeIconLabel {
    background: transparent;
}

/* --- Recent Project Tiles (1x1) --- */
QWidget#WelcomeProjectCardContent {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}
QWidget#WelcomeProjectCardContent:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QLabel#WelcomeCardName {
    color: #222222;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeCardPath {
    color: #888888;
    font-size: 11px;
}
QLabel#WelcomeCardTime {
    color: #AAAAAA;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #444444;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
QLabel#gridTileName {
    color: #888888;
    font-size: 11px;
}

/* ==================== HintBar ==================== */
QWidget#HintBar {
    background-color: #F0F4FA;
    border-bottom: 1px solid #D0D8E8;
}
QWidget#HintItem {
    background-color: #FFF8E1;
    border-bottom: 1px solid #FFE082;
}
QLabel#HintIndicator {
    color: #5A8ACA;
    font-size: 10px;
}
QLabel#HintText {
    color: #333333;
    font-size: 12px;
}
QPushButton#HintActionBtn {
    background-color: #E8EFFB;
    color: #2B6CB0;
    border: 1px solid #C5D5EB;
    border-radius: 3px;
    font-size: 11px;
    padding: 0 8px;
}
QPushButton#HintActionBtn:hover {
    background-color: #D0E0F5;
    border-color: #A0BDE0;
}
QPushButton#HintCloseBtn {
    background: transparent;
    border: none;
    color: #999;
    font-size: 12px;
}
QPushButton#HintCloseBtn:hover {
    color: #333;
}
/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #F0F0F0;
    border-right: 1px solid #D0D0D0;
}
QWidget#sidebarActivityBar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #666666;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QPushButton:hover {
    background-color: #E0E0E0;
    color: #222222;
}
/* ==================== Tab Close Button ==================== */
#tabCloseButton {
    margin-top: 2px;
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
    qproperty-icon: url(:/resources/icons/svg/close_dark.svg);
    qproperty-iconSize: 12px;
}
#tabCloseButton:hover {
    background-color: rgba(0, 0, 0, 0.08);
}
#tabCloseButton:pressed {
    background-color: rgba(0, 0, 0, 0.15);
}

QWidget#sidebarActivityBar QPushButton:checked {
    border-left: 2px solid #0078D4;
    color: #222222;
    background-color: #E0E0E0;
}
