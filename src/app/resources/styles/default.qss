/* 默认主题 - 保持原生控件样式 */

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #42A5F5, stop: 1 #1565C0);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #EEEEEE;
    color: #555555;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #E0E0E0;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutOkButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
#aboutOkButton:hover {
    background-color: #1976D2;
}
#aboutOkButton:pressed {
    background-color: #0D47A1;
}
#aboutCopyright {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #AAAAAA;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1d8fe1, stop:1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#loginUsername, #loginPassword {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #1d8fe1;
  background: white;
}
#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #4080ff, stop:1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #3070ee, stop:1 #70b0ff);
}
#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #2060dd, stop:1 #60a0ee);
}
#loginHint {
  color: #e53935;
  font-size: 12px;
}
#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#loginCloseBtn:hover {
  color: #333;
}
#loginRemember {
  font-size: 12px;
  color: #555;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: white;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
#userMgrAddBtn {
  background: #1d8fe1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
#userMgrAddBtn:hover {
  background: #1a7dcc;
}
#userMgrTable {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  gridline-color: #f0f0f0;
}
#userMgrTable::item {
  padding: 6px 12px;
}
#userMgrEditBtn {
  background: transparent;
  color: #1d8fe1;
  border: none;
  font-size: 12px;
}
#userMgrDeleteBtn {
  background: transparent;
  color: #e53935;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #999;
}
#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#userMgrCloseBtn:hover {
  color: #333;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

/* ==================== WelcomeWidget ==================== */
QWidget#WelcomeWidget {
    background-color: #F5F5F5;
}
QWidget#WelcomeCenter {
    background-color: rgba(245, 245, 245, 160);
    border-radius: 12px;
}
QLabel#WelcomeLogo {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
}
QLabel#WelcomeVersion {
    color: #999999;
    font-size: 13px;
}
QLabel#WelcomeSectionHeader {
    color: #444444;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#WelcomeActionButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 6px 20px;
    font-size: 13px;
}
QPushButton#WelcomeActionButton:hover {
    background-color: #106EBE;
}
QPushButton#WelcomeActionButton:pressed {
    background-color: #005A9E;
}
QScrollArea#WelcomeRecentScroll {
    background-color: transparent;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
}
QScrollArea#WelcomeRecentScroll > QWidget > QWidget {
    background-color: transparent;
}
#WelcomeRecentScroll QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0;
}
#WelcomeRecentScroll QScrollBar::handle:vertical {
    background: #C0C0C0;
    border-radius: 3px;
    min-height: 30px;
}
#WelcomeRecentScroll QScrollBar::handle:vertical:hover {
    background: #909090;
}
#WelcomeRecentScroll QScrollBar::add-line:vertical,
#WelcomeRecentScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}
#WelcomeRecentScroll QScrollBar::add-page:vertical,
#WelcomeRecentScroll QScrollBar::sub-page:vertical {
    background: none;
}
QWidget#WelcomeRecentContainer {
    background-color: #FFFFFF;
}
QFrame#WelcomeProjectCard {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}
QFrame#WelcomeProjectCard:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QLabel#WelcomeCardName {
    color: #222222;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeCardPath {
    color: #888888;
    font-size: 11px;
}
QLabel#WelcomeCardTime {
    color: #AAAAAA;
    font-size: 10px;
}
QLabel#WelcomeEmptyHint {
    color: #999999;
    font-size: 13px;
}
QLabel#WelcomeTipLabel {
    color: #888888;
    font-size: 12px;
    padding: 8px;
    background-color: #EEEEEE;
    border-radius: 4px;
}
QLabel#WelcomeShortcutKey {
    color: #888888;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QLabel#WelcomeShortcutDesc {
    color: #444444;
    font-size: 12px;
}

/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #F0F0F0;
    border-right: 1px solid #D0D0D0;
}
QWidget#sidebarActivityBar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #666666;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QPushButton:hover {
    background-color: #E0E0E0;
    color: #222222;
}
QWidget#sidebarActivityBar QPushButton:checked {
    border-left: 2px solid #0078D4;
    color: #222222;
    background-color: #E0E0E0;
}
