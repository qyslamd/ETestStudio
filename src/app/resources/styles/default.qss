/* 默认主题 - 保持原生控件样式 */

/* ==================== Global ==================== */
QTreeView {
    border: none;
}

/* ==================== QDoubleSpinBox ==================== */
/* ==================== ValueLabelWidget ==================== */
#ValueLabelTitle {
    font-weight: bold;
    font-size: 12px;
}
#ValueLabelValue {
    font-size: 24px;
    font-weight: bold;
    color: #333;
}
#ValueLabelRaw {
    font-size: 10px;
    color: #888;
}
#ValueLabelTs {
    font-size: 9px;
    color: #aaa;
}

/* ==================== QDoubleSpinBox ==================== */
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
    selection-background-color: #CCE4F7;
    selection-color: #1F1F1F;
}
QDoubleSpinBox:hover {
    border-color: #007ACC;
}
QDoubleSpinBox:focus {
    border-color: #007ACC;
}
QDoubleSpinBox:disabled {
    background-color: #F5F5F5;
    color: #AAAAAA;
    border-color: #E0E0E0;
}
/* ==================== QScrollBar ==================== */
QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}
QScrollBar::handle:vertical:pressed {
    background-color: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #F0F0F0;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #C0C0C0;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #A0A0A0;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #909090;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== QSplitter ==================== */
QSplitter::handle {
    background-color: #D0D0D0;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QSplitter::handle:hover {
    background-color: #0078D4;
}

/* ==================== TopologyManagerWidget ==================== */
QToolButton#topologyNewBtn {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
}
QToolButton#topologyNewBtn:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QToolButton#topologyNewBtn:pressed {
    background-color: #E0E0E0;
}
QToolButton#topologyNewBtn:disabled {
    background-color: #F5F5F5;
    color: #AAAAAA;
    border-color: #E0E0E0;
}

/* ==================== TopologyEditorWidget ==================== */
QToolBar#topologyToolbar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #D0D0D0;
    spacing: 2px;
    padding: 2px;
}
QToolBar#topologyToolbar QToolButton:checked {
    background-color: #D6EAF8;
    border: 1px solid #99CCFF;
    border-radius: 3px;
}

/* ==================== ProtocolEditorWidget ==================== */
QToolBar#protocolToolbar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #D0D0D0;
    spacing: 2px;
    padding: 2px;
}
QToolBar#protocolToolbar QToolButton:checked {
    background-color: #D6EAF8;
    border: 1px solid #99CCFF;
    border-radius: 3px;
}

QWidget#PhLoadingOverlay {
    background-color: #FFFFFF;
}
QLabel#PhLoadingOverlayLabel {
    font-size: 13px;
    color: #888888;
    background: transparent;
}

/* ==================== IcdFramePreviewPanel ==================== */
QToolButton#icdFramePreviewDecodeBtn {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    border-radius: 2px;
    padding: 4px 12px;
    font-size: 12px;
}
QToolButton#icdFramePreviewDecodeBtn:hover {
    background-color: #1A86E0;
}
QToolButton#icdFramePreviewDecodeBtn:pressed {
    background-color: #006ABF;
}
QToolButton#icdFramePreviewDecodeBtn:disabled {
    background-color: #E0E0E0;
    color: #AAAAAA;
    border-color: #D0D0D0;
}

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #42A5F5, stop: 1 #1565C0);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #EEEEEE;
    color: #555555;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #E0E0E0;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
QToolButton#aboutOkButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
QToolButton#aboutOkButton:hover {
    background-color: #1976D2;
}
QToolButton#aboutOkButton:pressed {
    background-color: #0D47A1;
}
#aboutCopyright {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #AAAAAA;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1d8fe1, stop:1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#loginUsername, #loginPassword {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #1d8fe1;
  background: white;
}
QToolButton#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #4080ff, stop:1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
QToolButton#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #3070ee, stop:1 #70b0ff);
}
QToolButton#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #2060dd, stop:1 #60a0ee);
}
#loginHint {
  color: #e53935;
  font-size: 12px;
}
QToolButton#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#loginCloseBtn:hover {
  color: #333;
}
#loginRemember {
  font-size: 12px;
  color: #555;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: white;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
QToolButton#userMgrAddBtn {
  background: #1d8fe1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
QToolButton#userMgrAddBtn:hover {
  background: #1a7dcc;
}
#userMgrTable {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  gridline-color: #f0f0f0;
}
#userMgrTable::item {
  padding: 6px 12px;
}
QToolButton#userMgrEditBtn {
  background: transparent;
  color: #1d8fe1;
  border: none;
  font-size: 12px;
}
QToolButton#userMgrDeleteBtn {
  background: transparent;
  color: #e53935;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #999;
}
#userMgrErrorHint {
  font-size: 12px;
  color: #e53935;
}
QToolButton#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
QToolButton#userMgrCloseBtn:hover {
  color: #333;
}

/* ==================== WelcomeWidget ==================== */
QWidget#WelcomeV1Widget {
    background-color: #F5F5F5;
}

/* ==================== Welcome V2 双栏启动页 ==================== */
QWidget#welcomeV2 {
    background-color: #F5F5F5;
}
QFrame#welcomeCard {
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
}
QLabel#welcomeBrandIcon {
    background-color: rgba(0, 120, 212, 0.12);
    border-radius: 10px;
}
QLabel#welcomeBrandTitle {
    color: #333333;
    font-size: 20px;
    font-weight: 600;
}
QLabel#welcomeBrandSub {
    color: #888888;
    font-size: 13px;
}
QLabel#welcomeVersion {
    color: #888888;
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0.05);
    padding: 3px 10px;
    border-radius: 12px;
}
QLabel#welcomeSectionTitle {
    color: #8C8CA8;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
}
QPushButton#welcomePrimaryBtn {
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#welcomePrimaryBtn:hover {
    background-color: #106EBE;
}
QPushButton#welcomeSecondaryBtn {
    background-color: rgba(0, 120, 212, 0.12);
    color: #0078D4;
    border: none;
    border-radius: 8px;
    padding: 12px 0;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#welcomeSecondaryBtn:hover {
    background-color: #0078D4;
    color: #FFFFFF;
}
QLabel#welcomeRecentEmpty {
    color: #8C8CA8;
    font-size: 13px;
    border: 1px dashed #D0D0D0;
    border-radius: 8px;
    padding: 18px 0;
}
QPushButton#welcomeQuickBtn {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
    padding: 14px 4px;
    font-size: 13px;
    font-weight: 600;
    color: #333333;
}
QPushButton#welcomeQuickBtn:hover {
    border-color: #0078D4;
    background-color: rgba(0, 120, 212, 0.10);
}
QLabel#welcomeGuideNum {
    background-color: rgba(0, 120, 212, 0.12);
    color: #0078D4;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#welcomeGuideText {
    color: #666666;
    font-size: 13px;
}
QLabel#welcomeTip {
    color: #8C8CA8;
    font-size: 12px;
}
QToolButton#welcomeTipBtn {
    color: #888888;
    border: none;
    background: transparent;
    padding: 4px 10px;
    border-radius: 6px;
}
QToolButton#welcomeTipBtn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #0078D4;
}

/* --- Action Tiles (新建/打开项目, 1x1) --- */
QLabel#WelcomeActionIcon {
    color: #0078D4;
    font-size: 28px;
}
QLabel#WelcomeActionText {
    color: #444444;
    font-size: 14px;
    font-weight: bold;
}

/* --- Eye Widget Tile (4x1) --- */
QWidget#WelcomeEyeContent {
    background: transparent;
}
QWidget#WelcomeEyeTopBar {
    background: transparent;
}
QLabel#WelcomeEyeLogoLabel {
    color: #333333;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#WelcomeEyeVersionLabel {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
QLabel#WelcomeEyeIconLabel {
    background: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* --- Recent Project Tiles (1x1) --- */
QWidget#WelcomeProjectCardContent {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}
QWidget#WelcomeProjectCardContent:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QLabel#WelcomeRecentCardName {
    color: #222222;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeRecentCardPath {
    color: #555555;
    font-size: 11px;
}
QLabel#WelcomeRecentCardTime {
    color: #AAAAAA;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #444444;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
QLabel#gridTileName {
    color: #888888;
    font-size: 11px;
}

/* --- Daily Tip Tile --- */
QLabel#WelcomeTipTitle {
    color: #333333;
    font-size: 14px;
    font-weight: bold;
}
QLabel#WelcomeTipContent {
    color: #555555;
    font-size: 12px;
}

/* ==================== HintPopup ==================== */
QFrame#HintPopupContent {
    background-color: #FFFFFF;
    border: 1px solid #D0D8E8;
    border-radius: 6px;
}
QFrame#HintPopupToolbar {
    background-color: #F0F4FA;
}
QFrame#HintPopupSeparator {
    background-color: #D0D8E8;
}
QListView#HintPopupList {
    background-color: #FFFFFF;
    border: none;
    outline: none;
}
QLabel#HintPopupEmpty {
    color: #999999;
    font-size: 13px;
    padding: 40px;
}
QToolButton#HintPopupMarkAllBtn,
QToolButton#HintPopupClearBtn {
    background: transparent;
    border: none;
    color: #333333;
    font-size: 11px;
    padding: 2px 8px;
}
QToolButton#HintPopupMarkAllBtn:hover,
QToolButton#HintPopupClearBtn:hover {
    color: #2B6CB0;
}
/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #F0F0F0;
    border-right: 1px solid #D0D0D0;
}
QWidget#sidebarActivityBar QToolButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #666666;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QToolButton:hover {
    background-color: #E0E0E0;
    color: #222222;
}
/* ==================== Tab Close Button ==================== */
#tabCloseButton {
    margin-top: 2px;
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
    qproperty-icon: url(:/resources/icons/svg/close_dark.svg);
    qproperty-iconSize: 14px;
}
#tabCloseButton:hover {
    background-color: rgba(0, 0, 0, 0.08);
}
#tabCloseButton:pressed {
    background-color: rgba(0, 0, 0, 0.15);
}

QWidget#sidebarActivityBar QToolButton:checked {
    border-left: 2px solid #0078D4;
    color: #222222;
    background-color: #E0E0E0;
}

/* ==================== ProjectStructureWidget Placeholder ==================== */
QWidget#PhPlaceholder {
    background-color: #F5F5F5;
}
QScrollArea#PhScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea#PhScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QWidget#PhScrollContent {
    background-color: transparent;
}

QToolButton#PhProjectBtn {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhProjectBtn:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QToolButton#PhProjectBtn:pressed {
    background-color: #E0E0E0;
}

QLabel#PhTitle {
    font-size: 14px;
    font-weight: 600;
    color: #888888;
}
QLabel#PhDesc {
    font-size: 12px;
    color: #AAAAAA;
}
QFrame#PhSeparator {
    color: #3C3C3C;
    max-height: 1px;
}

QToolButton#PhQuickBtn {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QToolButton#PhQuickBtn:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QToolButton#PhQuickBtn:pressed {
    background-color: #E0E0E0;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #D0D0D0;
}
QDockWidget > QWidget {
    background: #FAFAFA;
}

/* ==================== PropertyPanelWidget ==================== */
QWidget#topologyPropertyPanel {
    background-color: #FAFAFA;
}
QStackedWidget#topologyPropertyStack {
    background-color: #FAFAFA;
}
#emptyPage, #uutPage, #portPage, #devicePage, #connectionPage, #devicePortPage, #monitorPage {
    background-color: #FAFAFA;
}

/* IcdPropertyPanel 内部滚动区内容 */
QScrollArea#icdPropertyScroll {
    background-color: transparent;
    border: none;
}
QScrollArea#icdPropertyScroll > QWidget > QWidget {
    background-color: transparent;
}
QWidget#icdPropertyForm {
    background-color: transparent;
}
etest--ui--DockTitleBar {
    background: #F0F0F0;
    border-bottom: 1px solid #D0D0D0;
}
QLabel#dockTitleBarLabel {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
QToolButton#dockFloatButton, QToolButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QToolButton#dockFloatButton:hover, QToolButton#dockCloseButton:hover {
    background: rgba(0, 0, 0, 0.08);
}
QToolButton#dockFloatButton:pressed, QToolButton#dockCloseButton:pressed {
    background: rgba(0, 0, 0, 0.15);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: bold;
    color: #999999;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QToolButton#PhOpenFilesHeaderBtn:hover {
    background-color: #E8E8E8;
}

/* ==================== TuxSaverOverlay ==================== */
QToolButton#saverCloseBtn {
    color: rgba(255,255,255,160);
    background: rgba(255,255,255,25);
    border: 1px solid rgba(255,255,255,40);
    border-style: solid;
    font-size: 16px;
    border-radius: 16px;
    padding: 0px;
    margin: 0px;
}
QToolButton#saverCloseBtn:hover {
    background: rgba(255,80,80,160);
    color: white;
    border-color: rgba(255,80,80,230);
    border-width: 1.5px;
    border-style: solid;
}
QToolButton#saverCloseBtn:pressed {
    background: rgba(200,50,50,180);
    color: white;
    border-color: rgba(200,50,50,220);
    border-style: solid;
}

/* ==================== SearchWidget ==================== */
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn,
etest--app--SearchWidget QToolButton#searchWholeWordBtn,
etest--app--SearchWidget QToolButton#searchRegexModeBtn {
    background-color: transparent;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    color: #666666;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:hover,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:hover,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:hover {
    background-color: #E0E0E0;
    color: #333333;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:checked,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:checked,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:checked {
    background-color: #CCE4F7;
    border-color: #0078D4;
    color: #1F1F1F;
}
etest--app--SearchWidget QLabel#fileSectionLabel,
etest--app--SearchWidget QLabel#contentSectionLabel {
    color: #999999;
    font-size: 11px;
    background-color: transparent;
    padding: 2px 4px;
}

/* ==================== etest--app--SettingsDialog ==================== */
etest--app--SettingsDialog {
    background-color: #FFFFFF;
}

/* 左侧分类列表 */
etest--app--SettingsDialog QListWidget {
    background-color: #F5F5F5;
    color: #333333;
    border-right: 1px solid #E0E0E0;
    font-size: 13px;
    outline: none;
}
etest--app--SettingsDialog QListWidget::item {
    padding: 8px 12px;
    border: none;
}
etest--app--SettingsDialog QListWidget::item:hover {
    background-color: #E0E0E0;
}
etest--app--SettingsDialog QListWidget::item:selected {
    background-color: #CCE4F7;
    color: #1F1F1F;
}

/* 右侧页面容器 */
etest--app--SettingsDialog QStackedWidget {
    background-color: #FFFFFF;
}
etest--app--SettingsDialog QStackedWidget > QWidget {
    background-color: #FFFFFF;
}

/* 设置卡片 */
QWidget#SettingsCard {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}
QLabel#SettingsCardTitle {
    color: #333333;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0 8px 0;
    background-color: transparent;
}

/* VS Code 风格设置行 */
QWidget#SettingsRow {
    background-color: transparent;
    border-bottom: 1px solid #F0F0F0;
}
QLabel#SettingsRowTitle {
    color: #1F1F1F;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
}
QLabel#SettingsRowDesc {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
}
QLabel#SettingsHint {
    color: #999999;
    font-size: 11px;
    padding: 4px 0;
    background-color: transparent;
}

/* 底部按钮栏 */
QWidget#SettingsButtonBar {
    border-top: 1px solid #E0E0E0;
    background-color: #FFFFFF;
}

/* 设置页通用标签 */
etest--app--SettingsDialog QLabel {
    color: #333333;
    background-color: transparent;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F1F1F;
    selection-background-color: #CCE4F7;
    selection-color: #1F1F1F;
    border: 1px solid #D0D0D0;
}

/* 文本输入框 */
etest--app--SettingsDialog QLineEdit {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QLineEdit:focus {
    border-color: #007ACC;
}

/* 复选框 */
etest--app--SettingsDialog QCheckBox {
    color: #333333;
    spacing: 8px;
    background-color: transparent;
}

/* 滚动区（外观页内嵌） */
etest--app--SettingsDialog QScrollArea {
    background-color: #FFFFFF;
    border: none;
}
etest--app--SettingsDialog QScrollArea > QWidget {
    background-color: #FFFFFF;
}
etest--app--SettingsDialog QScrollArea > QWidget > QWidget {
    background-color: #FFFFFF;
}

/* 按钮 */
QPushButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    border-radius: 3px;
    padding: 5px 16px;
}
QPushButton:hover {
    background-color: #1A86E0;
}
QPushButton:pressed {
    background-color: #006ABF;
}
QPushButton:disabled {
    background-color: #E0E0E0;
    color: #AAAAAA;
    border-color: #D0D0D0;
}

/* ==================== EtlogViewerWidget ==================== */
etest--app--EtlogViewerWidget {
    background-color: #FFFFFF;
}
#etlogSummaryBar {
    background-color: #F5F5F5;
    border-bottom: 1px solid #E0E0E0;
}
#etlogTitleLabel {
    font-weight: bold;
    font-size: 14px;
}
#etlogFooterBar {
    background-color: #F5F5F5;
    border-top: 1px solid #E0E0E0;
}
#etlogFooterLabel {
    color: #999;
    font-size: 11px;
}
#etlogEmptyLabel {
    color: #999999;
    font-size: 16px;
}
#etlogDetailScroll {
    background-color: #FFFFFF;
}
#etlogDetailViewport {
    background-color: #FFFFFF;
}
#etlogDetailInner {
    background-color: #FFFFFF;
}
#etlogDetailStatus {
    font-size: 16px;
    font-weight: bold;
}

/* ==================== Tab Close Button (Light) ==================== */
#bottomTabWidget QTabBar::close-button {
    image: url(:/resources/icons/svg/close_dark.svg);
    subcontrol-position: right;
    width: 14px;
    height: 14px;
}
#bottomTabWidget QTabBar::close-button:hover {
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 2px;
}

/* ==================== Signal Visualizers (Light) ==================== */

/* WaveformWidget */
#WaveformTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
}
#WaveformPlot {
    border: 1px solid palette(midlight);
    border-radius: 2px;
}

/* 两级标题：二级标题（连接描述）小字灰 */
#WaveformSubtitle, #LedSubtitle, #MeterSubtitle, #GaugeSubtitle, #ValueLabelSubtitle {
    font-size: 10px;
    color: #808080;
}
#WaveformSubtitle[state="warning"], #MeterSubtitle[state="warning"], #GaugeSubtitle[state="warning"], #ValueLabelSubtitle[state="warning"], #LedSubtitle[state="warning"] {
  color: #D56224;
}
#WaveformSubtitle[state="deleted"], #MeterSubtitle[state="deleted"], #GaugeSubtitle[state="deleted"], #ValueLabelSubtitle[state="deleted"], #LedSubtitle[state="deleted"] {
  color: #D56224;
}

/* 监听器配置对话框（MonitorConfigDialog） */

/* LedIndicator（圆灯由 QPainter 绘制） */
#LedSubtitle {
    font-size: 11px;
    color: palette(mid);
}
#LedField {
    font-size: 12px;
}

#LEDTitle {
    font-size: 12px;
    font-weight: bold;
}
#LEDStateText {
    font-size: 14px;
    font-weight: bold;
}
#LEDPulse {
    font-size: 11px;
    color: palette(mid);
}
#LEDTs {
    font-size: 10px;
    color: palette(mid);
}

/* DigitalMeterWidget */
#MeterTitle {
    font-size: 12px;
    font-weight: bold;
}
#GaugeTitle {
    font-size: 12px;
    font-weight: bold;
}
#MeterValue {
    font-size: 28px;
    font-weight: bold;
    color: palette(text);
}
#MeterTrend {
    font-size: 18px;
}
#MeterRange {
    font-size: 11px;
    color: palette(mid);
}
#MeterRaw {
    font-size: 11px;
    color: palette(mid);
}
#MeterTs {
    font-size: 10px;
    color: palette(mid);
}

/* ValueLabelWidget */
#ValueLabelTitle {
    font-size: 12px;
    font-weight: bold;
}
#ValueLabelValue {
    font-size: 22px;
    font-weight: bold;
    color: palette(text);
}
#ValueLabelRaw {
    font-size: 11px;
    color: palette(mid);
}
#ValueLabelTs {
    font-size: 10px;
    color: palette(mid);
}

/* SignalTreePanel */
#SignalTreeSearch {
    padding: 4px;
    margin: 2px 4px;
}
#SignalTree {
    background: transparent;
}

/* VisualizationArea */
#VisualizationArea {
    background: palette(window);
    border: none;
}

/* ExecutionDebugWidget */
#ExecDebugTree {
    background: transparent;
}

/* ExecutionDashboard splitter */
#ExecDashboardSplitter::handle {
    width: 2px;
}

/* Ribbon running mode indicator */
#RunningMode {
    border-bottom: 3px solid #ff8800;
}

/* ==================== LogFilterBar（page0 输出面板筛选工具栏） ==================== */
#LogFilterBar {
    background: palette(window);
    border: none;
}
#LogFilterBar QLineEdit#LogFilterBox {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 2px;
    padding: 2px 6px;
    selection-background-color: palette(highlight);
}
#LogFilterBar QLineEdit#LogFilterBox:focus {
    border-color: #007ACC;
}
#LogFilterBar QLineEdit#LogFilterBox[invalid="true"] {
    border: 1px solid #C62828;
}
#LogFilterBar QToolButton {
    background-color: transparent;
    border: 1px solid palette(mid);
    border-radius: 3px;
    color: palette(text);
    font-size: 12px;
    padding: 1px 4px;
}
#LogFilterBar QToolButton:hover {
    background-color: palette(midlight);
}
#LogFilterBar QToolButton:checked {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-color: #007ACC;
}
/* 级别按钮 checked 时着该级别色（与 vscode 主题对齐） */
#LogFilterBar QToolButton#LevelDebugBtn:checked { color: #6A9955; }
#LogFilterBar QToolButton#LevelInfoBtn:checked  { color: #4E8C3A; }
#LogFilterBar QToolButton#LevelWarnBtn:checked  { color: #B8860B; }
#LogFilterBar QToolButton#LevelErrorBtn:checked { color: #C62828; }
#LogFilterBar QToolButton#LevelFatalBtn:checked { color: #8B0000; }

/* QAB 文件搜索框 */
#RibbonSearchEdit {
    border: 1px solid #CCCCCC;
    border-radius: 2px;
    padding: 2px 6px;
    background: #FFFFFF;
    color: #333333;
    font-size: 12px;
}
#RibbonSearchEdit:focus {
    border-color: #007ACC;
}
#RibbonSearchEdit:disabled {
    background-color: #F0F0F0;
    color: #B0B0B0;
    border: 1px solid #F0F0F0;
}

/* Visualizer 容器背景 */
#ValueLabelWidget, #MeterWidget, #WaveformWidget, #GaugeWidget, #LedIndicator {
    background-color: #FFFFFF;
}

/* ===== QSpinBox 主题适配样式 START ===== */
/* QSpinBox / QDoubleSpinBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #F0F0F0 #F0F0F0 #F1F1F1 #F1F1F1 #CCCCCC #333333
 *        #CCE4F7 #007ACC #AAAAAA 0 122 204 dark
 */
QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F0F0F0,
                        stop:1 #F0F0F0);
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    padding: 8px 30px 8px 12px;
    color: #333333;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #CCE4F7;
    selection-color: #FFFFFF;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F1F1F1,
                        stop:1 #F1F1F1);
    border: 1px solid #007ACC;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #007ACC;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #F0F0F0;
    color: #AAAAAA;
    border: 1px solid #CCCCCC;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right top;
    width: 28px;
    height: 14px;
    border: none;
    border-top-right-radius: 7px;
    border-left: 1px solid #CCCCCC;
    background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: rgba(0, 122, 204, 0.2);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: right bottom;
    width: 28px;
    height: 14px;
    border: none;
    border-bottom-right-radius: 7px;
    border-left: 1px solid #CCCCCC;
    background: transparent;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(0, 122, 204, 0.2);
}
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_up_dark.svg);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
}
/* 状态样式 */
QSpinBox[status="success"], QDoubleSpinBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.4);
}
QSpinBox[status="success"]:hover, QDoubleSpinBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QSpinBox[status="success"]:focus, QDoubleSpinBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QSpinBox[status="error"], QDoubleSpinBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.4);
}
QSpinBox[status="error"]:hover, QDoubleSpinBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QSpinBox[status="error"]:focus, QDoubleSpinBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QSpinBox[status="warning"], QDoubleSpinBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.4);
}
QSpinBox[status="warning"]:hover, QDoubleSpinBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QSpinBox[status="warning"]:focus, QDoubleSpinBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QSpinBox[size="small"], QDoubleSpinBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    min-height: 28px;
    border-radius: 6px;
}
QSpinBox[size="small"]::up-button, QDoubleSpinBox[size="small"]::up-button {
    width: 22px;
    height: 12px;
    border-top-right-radius: 5px;
}
QSpinBox[size="small"]::down-button, QDoubleSpinBox[size="small"]::down-button {
    width: 22px;
    height: 12px;
    border-bottom-right-radius: 5px;
}
QSpinBox[size="large"], QDoubleSpinBox[size="large"] {
    padding: 12px 36px 12px 16px;
    font-size: 16px;
    min-height: 48px;
    border-radius: 10px;
}
QSpinBox[size="large"]::up-button, QDoubleSpinBox[size="large"]::up-button {
    width: 32px;
    height: 18px;
    border-top-right-radius: 9px;
}
QSpinBox[size="large"]::down-button, QDoubleSpinBox[size="large"]::down-button {
    width: 32px;
    height: 18px;
    border-bottom-right-radius: 9px;
}
/* 圆角样式 */
QSpinBox[rounded="true"], QDoubleSpinBox[rounded="true"] {
    border-radius: 24px;
    padding: 10px 36px 10px 16px;
}
QSpinBox[rounded="true"]::up-button, QDoubleSpinBox[rounded="true"]::up-button {
    border-top-right-radius: 24px;
}
QSpinBox[rounded="true"]::down-button, QDoubleSpinBox[rounded="true"]::down-button {
    border-bottom-right-radius: 24px;
}
/* 无边框样式 */
QSpinBox[frameless="true"], QDoubleSpinBox[frameless="true"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #CCCCCC;
    border-radius: 0;
    padding: 8px 30px 8px 0;
}
QSpinBox[frameless="true"]:hover, QDoubleSpinBox[frameless="true"]:hover {
    border-bottom: 2px solid #007ACC;
}
QSpinBox[frameless="true"]:focus, QDoubleSpinBox[frameless="true"]:focus {
    border-bottom: 2px solid #007ACC;
}
QSpinBox[frameless="true"]::up-button, QDoubleSpinBox[frameless="true"]::up-button {
    border-left: none;
}
QSpinBox[frameless="true"]::down-button, QDoubleSpinBox[frameless="true"]::down-button {
    border-left: none;
}
/* ===== QSpinBox 主题适配样式 END ===== */

/* ===== QComboBox 主题适配样式 START ===== */
/* QComboBox 主题适配样式模板
 * 由 gen_themes.py 读取替换 token 后注入各主题 QSS（幂等）
 * token: #F0F0F0 #F0F0F0 #F1F1F1 #F1F1F1 #CCCCCC #333333
 *        #CCE4F7 #007ACC #AAAAAA 0 122 204 dark
 */
QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F0F0F0,
                        stop:1 #F0F0F0);
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    padding: 8px 36px 8px 8px;
    color: #333333;
    font-size: 13px;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    selection-background-color: #CCE4F7;
    selection-color: #FFFFFF;
    min-height: 20px;
}
/* 下拉箭头 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    height: 100%;
    border: none;
    border-left: 1px solid #CCCCCC;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background: transparent;
}
QComboBox::drop-down:hover {
    background: rgba(0, 122, 204, 0.2);
}
QComboBox::drop-down:pressed {
    background: rgba(0, 122, 204, 0.4);
}
QComboBox::drop-down::down-arrow {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    subcontrol-origin: margin;
    subcontrol-position: right center;
}
/* 下拉列表视图 */
QComboBox QAbstractItemView {
    background: #F0F0F0;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #CCE4F7;
    selection-color: #FFFFFF;
    outline: none;
    alternate-background-color: transparent;
    color: #333333;
}
QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    margin: 2px 4px;
    border-radius: 6px;
    min-height: 24px;
    color: #333333;
}
QComboBox QAbstractItemView::item:hover {
    background: rgba(0, 122, 204, 0.3);
    color: #333333;
}
QComboBox QAbstractItemView::item:selected {
    background: rgba(0, 122, 204, 0.6);
    color: #FFFFFF;
    border: 1px solid rgba(0, 122, 204, 0.8);
}
QComboBox QAbstractItemView::item:alternate {
    background: transparent;
}
/* 悬停 */
QComboBox:hover {
    border: 1px solid #007ACC;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F1F1F1,
                        stop:1 #F1F1F1);
}
/* 焦点 */
QComboBox:focus {
    border: 2px solid #007ACC;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F1F1F1,
                        stop:1 #F1F1F1);
}
/* 禁用 */
QComboBox:disabled {
    background: #F0F0F0;
    color: #AAAAAA;
    border: 1px solid #CCCCCC;
}
QComboBox::drop-down:disabled {
    background: #F0F0F0;
    border-left: 1px solid #CCCCCC;
}
QComboBox::down-arrow:disabled {
    image: url(:/resources/icons/svg/arrow_down_dark.svg);
    opacity: 0.5;
}
/* 可编辑状态 */
QComboBox[editable="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                        stop:0 #F0F0F0,
                        stop:1 #F0F0F0);
}
QComboBox[editable="true"] QLineEdit {
    background: transparent;
    border: none;
    color: #333333;
    selection-background-color: #CCE4F7;
    selection-color: #FFFFFF;
    padding: 0px;
}
QComboBox[editable="true"] QLineEdit:focus {
    border: none;
    outline: none;
}
/* 状态样式 */
QComboBox[status="success"] {
    border: 1px solid rgba(34, 197, 94, 0.6);
}
QComboBox[status="success"]:hover {
    border: 1px solid rgba(34, 197, 94, 0.8);
}
QComboBox[status="success"]:focus {
    border: 2px solid #22C55E;
}
QComboBox[status="error"] {
    border: 1px solid rgba(239, 68, 68, 0.6);
}
QComboBox[status="error"]:hover {
    border: 1px solid rgba(239, 68, 68, 0.8);
}
QComboBox[status="error"]:focus {
    border: 2px solid #EF4444;
}
QComboBox[status="warning"] {
    border: 1px solid rgba(245, 158, 11, 0.6);
}
QComboBox[status="warning"]:hover {
    border: 1px solid rgba(245, 158, 11, 0.8);
}
QComboBox[status="warning"]:focus {
    border: 2px solid #F59E0B;
}
/* 尺寸样式 */
QComboBox[size="small"] {
    padding: 4px 24px 4px 8px;
    font-size: 12px;
    border-radius: 6px;
    min-height: 16px;
}
QComboBox[size="small"]::drop-down {
    width: 24px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QComboBox[size="small"]::drop-down::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox[size="small"] QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 20px;
    font-size: 12px;
}
QComboBox[size="large"] {
    padding: 10px 32px 10px 16px;
    font-size: 16px;
    border-radius: 10px;
    min-height: 24px;
}
QComboBox[size="large"]::drop-down {
    width: 36px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}
QComboBox[size="large"]::drop-down::down-arrow {
    width: 14px;
    height: 14px;
}
QComboBox[size="large"] QAbstractItemView::item {
    padding: 12px 16px;
    min-height: 28px;
    font-size: 16px;
}
/* 特殊样式 */
QComboBox[rounded="true"] {
    border-radius: 20px;
    padding: 8px 32px 8px 20px;
}
QComboBox[rounded="true"]::drop-down {
    border-top-right-radius: 19px;
    border-bottom-right-radius: 19px;
}
QComboBox[rounded="true"] QAbstractItemView {
    border-radius: 12px;
}
QComboBox[rounded="true"] QAbstractItemView::item {
    border-radius: 8px;
}
QComboBox[frameless="true"] {
    border: none;
    background: #F0F0F0;
}
QComboBox[frameless="true"]::drop-down {
    border-left: none;
}
QComboBox[frameless="true"]:hover {
    background: #F1F1F1;
}
QComboBox[frameless="true"]:focus {
    background: #F1F1F1;
}
/* ===== QComboBox 主题适配样式 END ===== */

/* ===== QScrollArea 主题适配样式 START ===== */
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
#ScrollAreaContent {
    background: transparent;
}
/* ===== QScrollArea 主题适配样式 END ===== */

/* ===== QGroupBox 主题适配样式 START ===== */
QGroupBox {
    background-color: #F0F0F0;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    margin-top: 0px;
    padding: 22px 12px 12px 12px;
    color: #333333;
}
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 12px;
    top: 8px;
    padding: 0 4px;
    color: #888888;
    font-size: 12px;
    font-weight: 700;
}
QGroupBox:hover {
    border: 1px solid #007ACC;
}
QGroupBox[selected="true"] {
    border: 2px solid #007ACC;
}
/* ===== QGroupBox 主题适配样式 END ===== */

/* ===== visualizer 副标题状态配色 START ===== */

#WaveformSubtitle[state="warning"], #MeterSubtitle[state="warning"], #GaugeSubtitle[state="warning"], #ValueLabelSubtitle[state="warning"], #LedSubtitle[state="warning"] {
  color: #D56224;
}
#WaveformSubtitle[state="deleted"], #MeterSubtitle[state="deleted"], #GaugeSubtitle[state="deleted"], #ValueLabelSubtitle[state="deleted"], #LedSubtitle[state="deleted"] {
  color: #D56224;
}
/* ===== visualizer 副标题状态配色 END ===== */

