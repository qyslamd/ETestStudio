/* 默认主题 - 保持原生控件样式 */

/* ==================== Global ==================== */
QTreeView {
    border: none;
}

/* ==================== QDoubleSpinBox ==================== */
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
    selection-background-color: #CCE4F7;
    selection-color: #1F1F1F;
}
QDoubleSpinBox:hover {
    border-color: #007ACC;
}
QDoubleSpinBox:focus {
    border-color: #007ACC;
}
QDoubleSpinBox:disabled {
    background-color: #F5F5F5;
    color: #AAAAAA;
    border-color: #E0E0E0;
}
/* ==================== QScrollBar ==================== */
QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}
QScrollBar::handle:vertical:pressed {
    background-color: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #F0F0F0;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #C0C0C0;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #A0A0A0;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #909090;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== QSplitter ==================== */
QSplitter::handle {
    background-color: #D0D0D0;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QSplitter::handle:hover {
    background-color: #0078D4;
}

/* ==================== TopologyEditorWidget ==================== */
QWidget#PhLoadingOverlay {
    background-color: #FFFFFF;
}
QLabel#PhLoadingOverlayLabel {
    font-size: 13px;
    color: #888888;
    background: transparent;
}

/* ==================== AboutDialog ==================== */
#aboutContent {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
}
#aboutHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #42A5F5, stop: 1 #1565C0);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#aboutLogo {
    background: transparent;
}
#aboutName {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}
#aboutVersion {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    background: transparent;
}
#aboutBody {
    background: transparent;
}
#aboutDesc {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
#aboutTechHeader {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: transparent;
    padding: 0;
}
#aboutTechChip {
    background-color: #EEEEEE;
    color: #555555;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
}
#aboutSep {
    background-color: #E0E0E0;
    border: none;
    max-height: 1px;
}
#aboutBuildInfo {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutOkButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
#aboutOkButton:hover {
    background-color: #1976D2;
}
#aboutOkButton:pressed {
    background-color: #0D47A1;
}
#aboutCopyright {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
#aboutLicense {
    color: #AAAAAA;
    font-size: 10px;
    background: transparent;
}

/* ========== LoginDialog ========== */
#loginContent {
  background: white;
  border-radius: 12px;
}
#loginBrand {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1d8fe1, stop:1 #625eb1);
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}
#loginBrandTitle {
  color: white;
  font-size: 22px;
  font-weight: 600;
}
#loginBrandSub {
  color: rgba(255,255,255,0.85);
  font-size: 13px;
}
#loginBrandHint {
  color: rgba(255,255,255,0.6);
  font-size: 11px;
}
#loginFormTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#loginUsername, #loginPassword {
  background: #f5f5f5;
  border: 1px solid #D7D7D9;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 13px;
  color: #1F1F1F;
}
#loginUsername:focus, #loginPassword:focus {
  border-color: #1d8fe1;
  background: white;
}
#loginButton {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #4080ff, stop:1 #80c0ff);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  font-weight: 500;
}
#loginButton:hover {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #3070ee, stop:1 #70b0ff);
}
#loginButton:pressed {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #2060dd, stop:1 #60a0ee);
}
#loginHint {
  color: #e53935;
  font-size: 12px;
}
#loginCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#loginCloseBtn:hover {
  color: #333;
}
#loginRemember {
  font-size: 12px;
  color: #555;
}

/* ========== UserManagerDialog ========== */
#userMgrContent {
  background: white;
  border-radius: 12px;
}
#userMgrTitle {
  font-size: 18px;
  font-weight: 600;
  color: #1F1F1F;
}
#userMgrCount {
  font-size: 12px;
  color: #888;
  margin-left: 8px;
}
#userMgrAddBtn {
  background: #1d8fe1;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 16px;
  font-size: 13px;
}
#userMgrAddBtn:hover {
  background: #1a7dcc;
}
#userMgrTable {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  gridline-color: #f0f0f0;
}
#userMgrTable::item {
  padding: 6px 12px;
}
#userMgrEditBtn {
  background: transparent;
  color: #1d8fe1;
  border: none;
  font-size: 12px;
}
#userMgrDeleteBtn {
  background: transparent;
  color: #e53935;
  border: none;
  font-size: 12px;
}
#userMgrHint {
  font-size: 12px;
  color: #999;
}
#userMgrCloseBtn {
  background: transparent;
  border: none;
  color: #999;
  font-size: 18px;
  font-weight: normal;
}
#userMgrCloseBtn:hover {
  color: #333;
}

/* ==================== NewProjectDialog ==================== */
#dlg_contentWidget {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

/* ==================== WelcomeWidget ==================== */
QWidget#WelcomeWidget {
    background-color: #F5F5F5;
}

/* --- Action Tiles (新建/打开项目, 1x1) --- */
QLabel#WelcomeActionIcon {
    color: #0078D4;
    font-size: 28px;
}
QLabel#WelcomeActionText {
    color: #444444;
    font-size: 14px;
    font-weight: bold;
}

/* --- Eye Widget Tile (4x1) --- */
QWidget#WelcomeEyeContent {
    background: transparent;
}
QWidget#WelcomeEyeTopBar {
    background: transparent;
}
QLabel#WelcomeEyeLogoLabel {
    color: #333333;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#WelcomeEyeVersionLabel {
    color: #999999;
    font-size: 11px;
    background: transparent;
}
QLabel#WelcomeEyeIconLabel {
    background: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* --- Recent Project Tiles (1x1) --- */
QWidget#WelcomeProjectCardContent {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}
QWidget#WelcomeProjectCardContent:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QLabel#WelcomeRecentCardName {
    color: #222222;
    font-size: 13px;
    font-weight: bold;
}
QLabel#WelcomeRecentCardPath {
    color: #555555;
    font-size: 11px;
}
QLabel#WelcomeRecentCardTime {
    color: #AAAAAA;
    font-size: 10px;
}

/* --- Clock Tile (2x2) --- */
QLabel#WelcomeClockDigital {
    color: #444444;
    font-size: 16px;
    font-weight: bold;
}

/* --- Tile Name Labels (generic, used by tip tile etc.) --- */
QLabel#gridTileName {
    color: #888888;
    font-size: 11px;
}

/* --- Daily Tip Tile --- */
QLabel#WelcomeTipTitle {
    color: #333333;
    font-size: 14px;
    font-weight: bold;
}
QLabel#WelcomeTipContent {
    color: #555555;
    font-size: 12px;
}

/* ==================== HintBar ==================== */
QWidget#HintBar {
    background-color: #F0F4FA;
    border-bottom: 1px solid #D0D8E8;
}
QWidget#HintItem {
    background-color: #FFF8E1;
    border-bottom: 1px solid #FFE082;
}
QLabel#HintIndicator {
    color: #5A8ACA;
    font-size: 10px;
}
QLabel#HintText {
    color: #333333;
    font-size: 12px;
}
QPushButton#HintActionBtn {
    background-color: #E8EFFB;
    color: #2B6CB0;
    border: 1px solid #C5D5EB;
    border-radius: 3px;
    font-size: 11px;
    padding: 0 8px;
}
QPushButton#HintActionBtn:hover {
    background-color: #D0E0F5;
    border-color: #A0BDE0;
}
QPushButton#HintCloseBtn {
    background: transparent;
    border: none;
    color: #999;
    font-size: 12px;
}
QPushButton#HintCloseBtn:hover {
    color: #333;
}
/* ==================== 侧边栏活动按钮栏 ==================== */
QWidget#sidebarActivityBar {
    background-color: #F0F0F0;
    border-right: 1px solid #D0D0D0;
}
QWidget#sidebarActivityBar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #666666;
    font-size: 16px;
    padding: 0px;
    margin: 0px;
}
QWidget#sidebarActivityBar QPushButton:hover {
    background-color: #E0E0E0;
    color: #222222;
}
/* ==================== Tab Close Button ==================== */
#tabCloseButton {
    margin-top: 2px;
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
    qproperty-icon: url(:/resources/icons/svg/close_dark.svg);
    qproperty-iconSize: 12px;
}
#tabCloseButton:hover {
    background-color: rgba(0, 0, 0, 0.08);
}
#tabCloseButton:pressed {
    background-color: rgba(0, 0, 0, 0.15);
}

QWidget#sidebarActivityBar QPushButton:checked {
    border-left: 2px solid #0078D4;
    color: #222222;
    background-color: #E0E0E0;
}

/* ==================== ProjectStructureWidget Placeholder ==================== */
QWidget#PhPlaceholder {
    background-color: #F5F5F5;
}
QScrollArea#PhScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea#PhScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QWidget#PhScrollContent {
    background-color: transparent;
}

QLabel#PhSectionLabel {
    color: #999999;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
    background: transparent;
}
QPushButton#PhProjectBtn {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    text-align: left;
    padding: 0 12px;
    font-size: 12px;
}
QPushButton#PhProjectBtn:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QPushButton#PhProjectBtn:pressed {
    background-color: #E0E0E0;
}

QLabel#PhTitle {
    font-size: 14px;
    font-weight: 600;
    color: #888888;
}
QLabel#PhDesc {
    font-size: 12px;
    color: #AAAAAA;
}
QFrame#PhSeparator {
    color: #3C3C3C;
    max-height: 1px;
}

/* Placeholder page round-corner cards */
QFrame#PhCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}
QFrame#PhCard:hover {
    border-color: #0078D4;
}
QLabel#PhRecentEmpty {
    color: #666666;
    font-size: 11px;
    padding: 16px 0;
}
QPushButton#PhQuickBtn {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QPushButton#PhQuickBtn:hover {
    background-color: #F0F0F0;
    border-color: #0078D4;
}
QPushButton#PhQuickBtn:pressed {
    background-color: #E0E0E0;
}

/* --- RecentProjectCard in placeholder (narrow sidebar context) --- */
QWidget#PhRecentCard {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
}
QWidget#PhRecentCard:hover {
    background-color: #F0F4F8;
    border-color: #0078D4;
}

/* ==================== QDockWidget + DockTitleBar（设备面板/大纲/属性面板等） ==================== */
QDockWidget {
    border: 1px solid #D0D0D0;
}
QDockWidget > QWidget {
    background: #FAFAFA;
}

/* ==================== PropertyPanelWidget ==================== */
QWidget#topologyPropertyPanel {
    background-color: #FAFAFA;
}
QStackedWidget#topologyPropertyStack {
    background-color: #FAFAFA;
}
#emptyPage, #uutPage, #portPage, #devicePage, #connectionPage, #devicePortPage, #monitorPage {
    background-color: #FAFAFA;
}

/* IcdPropertyPanel 内部滚动区内容 */
QScrollArea#icdPropertyScroll {
    background-color: transparent;
    border: none;
}
QScrollArea#icdPropertyScroll > QWidget > QWidget {
    background-color: transparent;
}
QWidget#icdPropertyForm {
    background-color: transparent;
}
etest--ui--DockTitleBar {
    background: #F0F0F0;
    border-bottom: 1px solid #D0D0D0;
}
QLabel#dockTitleBarLabel {
    color: #333333;
    font-size: 12px;
    background: transparent;
}
QPushButton#dockFloatButton, QPushButton#dockCloseButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}
QPushButton#dockFloatButton:hover, QPushButton#dockCloseButton:hover {
    background: rgba(0, 0, 0, 0.08);
}
QPushButton#dockFloatButton:pressed, QPushButton#dockCloseButton:pressed {
    background: rgba(0, 0, 0, 0.15);
}

/* --- Open Files section (tree mode) --- */
QToolButton#PhOpenFilesHeaderBtn {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: bold;
    color: #999999;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QToolButton#PhOpenFilesHeaderBtn:hover {
    background-color: #E8E8E8;
}

/* ==================== TuxSaverOverlay ==================== */
QPushButton#saverCloseBtn {
    color: rgba(255,255,255,160);
    background: rgba(255,255,255,25);
    border: 1px solid rgba(255,255,255,40);
    font-size: 16px;
    border-radius: 16px;
}
QPushButton#saverCloseBtn:hover {
    background: rgba(255,80,80,160);
    color: white;
    border-color: rgba(255,80,80,230);
    border-width: 1.5px;
}
QPushButton#saverCloseBtn:pressed {
    background: rgba(200,50,50,180);
    color: white;
    border-color: rgba(200,50,50,220);
}

/* ==================== SearchWidget ==================== */
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn,
etest--app--SearchWidget QToolButton#searchWholeWordBtn,
etest--app--SearchWidget QToolButton#searchRegexModeBtn {
    background-color: transparent;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    color: #666666;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:hover,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:hover,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:hover {
    background-color: #E0E0E0;
    color: #333333;
}
etest--app--SearchWidget QToolButton#searchCaseSensitiveBtn:checked,
etest--app--SearchWidget QToolButton#searchWholeWordBtn:checked,
etest--app--SearchWidget QToolButton#searchRegexModeBtn:checked {
    background-color: #CCE4F7;
    border-color: #0078D4;
    color: #1F1F1F;
}
etest--app--SearchWidget QLabel#fileSectionLabel,
etest--app--SearchWidget QLabel#contentSectionLabel {
    color: #999999;
    font-size: 11px;
    background-color: transparent;
    padding: 2px 4px;
}

/* ==================== etest--app--SettingsDialog ==================== */
etest--app--SettingsDialog {
    background-color: #FFFFFF;
}

/* 左侧分类列表 */
etest--app--SettingsDialog QListWidget {
    background-color: #F5F5F5;
    color: #333333;
    border-right: 1px solid #E0E0E0;
    font-size: 13px;
    outline: none;
}
etest--app--SettingsDialog QListWidget::item {
    padding: 8px 12px;
    border: none;
}
etest--app--SettingsDialog QListWidget::item:hover {
    background-color: #E0E0E0;
}
etest--app--SettingsDialog QListWidget::item:selected {
    background-color: #CCE4F7;
    color: #1F1F1F;
}

/* 右侧页面容器 */
etest--app--SettingsDialog QStackedWidget {
    background-color: #FFFFFF;
}
etest--app--SettingsDialog QStackedWidget > QWidget {
    background-color: #FFFFFF;
}

/* 设置卡片 */
QWidget#SettingsCard {
    background-color: #FAFAFA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}
QLabel#SettingsCardTitle {
    color: #333333;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0 8px 0;
    background-color: transparent;
}

/* VS Code 风格设置行 */
QWidget#SettingsRow {
    background-color: transparent;
    border-bottom: 1px solid #F0F0F0;
}
QLabel#SettingsRowTitle {
    color: #1F1F1F;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
}
QLabel#SettingsRowDesc {
    color: #888888;
    font-size: 11px;
    background-color: transparent;
}
QLabel#SettingsHint {
    color: #999999;
    font-size: 11px;
    padding: 4px 0;
    background-color: transparent;
}

/* 底部按钮栏 */
QWidget#SettingsButtonBar {
    border-top: 1px solid #E0E0E0;
    background-color: #FFFFFF;
}

/* 设置页通用标签 */
etest--app--SettingsDialog QLabel {
    color: #333333;
    background-color: transparent;
}

/* 数值控件 */
etest--app--SettingsDialog QSpinBox {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QSpinBox:focus {
    border-color: #007ACC;
}
etest--app--SettingsDialog QSpinBox::up-button,
etest--app--SettingsDialog QSpinBox::down-button {
    background-color: #F5F5F5;
    border: none;
    width: 16px;
}
etest--app--SettingsDialog QSpinBox::up-button:hover,
etest--app--SettingsDialog QSpinBox::down-button:hover {
    background-color: #E0E0E0;
}
/* 下拉框 */
etest--app--SettingsDialog QComboBox {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QComboBox:hover {
    border-color: #007ACC;
}
etest--app--SettingsDialog QComboBox:focus {
    border-color: #007ACC;
}
etest--app--SettingsDialog QComboBox::drop-down {
    background-color: transparent;
    border: none;
    width: 20px;
}
etest--app--SettingsDialog QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/resources/icons/svg/drop_down_arrow_light.svg);
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F1F1F;
    selection-background-color: #CCE4F7;
    selection-color: #1F1F1F;
    border: 1px solid #D0D0D0;
}

/* 文本输入框 */
etest--app--SettingsDialog QLineEdit {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 4px 8px;
}
etest--app--SettingsDialog QLineEdit:focus {
    border-color: #007ACC;
}

/* 复选框 */
etest--app--SettingsDialog QCheckBox {
    color: #333333;
    spacing: 8px;
    background-color: transparent;
}

/* 滚动区（外观页内嵌） */
etest--app--SettingsDialog QScrollArea {
    background-color: #FFFFFF;
    border: none;
}
etest--app--SettingsDialog QScrollArea > QWidget {
    background-color: #FFFFFF;
}
etest--app--SettingsDialog QScrollArea > QWidget > QWidget {
    background-color: #FFFFFF;
}

/* 按钮 */
etest--app--SettingsDialog QPushButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    border-radius: 3px;
    padding: 5px 16px;
}
etest--app--SettingsDialog QPushButton:hover {
    background-color: #1A86E0;
}
etest--app--SettingsDialog QPushButton:pressed {
    background-color: #006ABF;
}
