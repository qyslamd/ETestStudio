/* ==================== ExecutionMonitorPanel ==================== */
#ExecutionMonitorPanel {
  background-color: #FAFAFA;
}

#ExecutionMonitorPanel QTreeWidget {
  alternate-background-color: #F0F0F0;
  font-size: 12px;
}

#ExecutionMonitorPanel QTreeWidget::item {
  padding: 2px 4px;
}

#ExecutionMonitorPanel QPlainTextEdit {
  background-color: #1E1E1E;
  color: #D4D4D4;
  font-family: "Consolas", "Courier New", monospace;
  font-size: 11px;
  border: none;
}

#ExecutionMonitorPanel #statPass {
  font-weight: bold;
  color: #1B7A2B;
  font-size: 12px;
}

#ExecutionMonitorPanel #statFail {
  font-weight: bold;
  color: #C62828;
  font-size: 12px;
}

#ExecutionMonitorPanel #statTimeout {
  font-weight: bold;
  color: #BD6B00;
  font-size: 12px;
}

#ExecutionMonitorPanel #deviceLabel {
  color: #555555;
  font-size: 12px;
}

#ExecutionMonitorPanel #statusLabel {
  color: #888888;
  font-size: 12px;
}

#ExecutionMonitorPanel #monitorSep {
  color: #C0C0C0;
  font-size: 12px;
}
